                         C      
                         C      S4.LBL:     PUSH    AF
                         C                  CALL    S0.KRZU
                         C                  POP     AF
                         C                  CALL    LR.LBL
                         C                  PUSH    AF
                         C                  PUSH    BC
                         C                  PUSH    DE
                         C                  CALL    S2.STACK
                         C                  POP     DE
                         C                  POP     BC
                         C                  POP     AF
                         C                  RET
                         C      
                         C      S4.LBS:     PUSH    AF
                         C                  CALL    S0.KRZU
                         C                  POP     AF
                         C                  CALL    LR.LBS
                         C                  PUSH    AF
                         C                  PUSH    BC
                         C                  PUSH    DE
                         C                  CALL    S2.STACK
                         C                  POP     DE
                         C                  POP     BC
                         C                  POP     AF
                         C                  RET
                         C      
                         C                  PAGE
                         C      S4.LIYI:    LD      IY,S3.LBL-S3.SEAT
                         C                  LD      DE,S0.DEAT+3
                         C                  ADD     IY,DE
                         C                  RET
                         C      
                         C      S4.LIXI:    PUSH    IY
