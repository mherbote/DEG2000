                         C                  PAGE
'K M B G  Komplex-Routinen Teil II'	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                         C      
                         C      ;****************************************************************
                         C      ;*          M R E S  Eingabedatei eroeffnen                     *
                         C      ;****************************************************************
  DC40    CD DBE0        C      K1.MREPO:   CALL    K1.MRCAT
  DC43    30 0D          C                  JR      NC,K1.MRPO4
  DC45    CD D79C        C                  CALL    K1.GNRW             ;Datei nicht im Verzeichnis
  DC48    CD D781        C                  CALL    K1.GNRA
  DC4B    CD D70D        C                  CALL    K1.GNSTS
  DC4E    3E 01          C                  LD      A,1
  DC50    B7             C                  OR      A                   ;Z-FF = 0
  DC51    C9             C                  RET
                         C      
  DC52    D5             C      K1.MRPO4:   PUSH    DE                  ;Dateifolgenummer
  DC53    3E 02          C                  LD      A,2
  DC55    82             C                  ADD     A,D
  DC56    F5             C                  PUSH    AF
  DC57    CD D79C        C                  CALL    K1.GNRW
  DC5A    D1             C                  POP     DE
  DC5B    CD D80F        C                  CALL    K1.GNLPN
  DC5E    CD D8B7        C                  CALL    K1.GNRD             ;Verzeichnissatz der Datei einlesen
  DC61    21 B014        C                  LD      HL,KS.PUFFS+1
  DC64    F1             C                  POP     AF
  DC65    BE             C                  CP      (HL)
  DC66    28 0A          C                  JR      Z,K1.MRPO5
                         C      
  DC68    CD D79C        C      K1.MRPO3:   CALL    K1.GNRW             ;Datei nicht richtig pos.
  DC6B    CD D781        C                  CALL    K1.GNRA
  DC6E    3E 02          C                  LD      A,2
  DC70    B7             C                  OR      A                   ;Z-FF = 0
  DC71    C9             C                  RET
                         C      
  DC72    DD CB FF CE    C      K1.MRPO5:   SET     1,(IX-1)            ;OPEN bit          setzen
  DC76    DD CB FF DE    C                  SET     3,(IX-1)            ;Verarbeitungsbit  setzen
  DC7A    01 0400        C                  LD      BC,400H             ;Eingabepuffer fuellen
  DC7D    CD DB4C        C                  CALL    K1.EIN
  DC80    AF             C                  XOR     A                   ;Z-FF = 1
  DC81    C9             C                  RET
