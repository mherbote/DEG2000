  CAE7    0000           C                  DW      0                   ;KONV
                         C      ;****************************************************************
                         C      ;*               L B - L e s e r                                *
                         C      ;****************************************************************
  CAE9    19             C      S3.LBL:     DB      S3.LBS-S3.LBL       ;Laengenbyte
  CAEA    00             C                  DB      00000000B           ;Typ - Kennsatz nein
  CAEB    40             C                  DB      01000000B           ;Geraetebyte
                         C                  S3.RMOS 0,0,S0.ADA,0,02H,0,S0.PFFI,400H,7FH,19H,0
  CAEC    00             C+                 DB      0                  ;Statusbyte
  CAED    00             C+                 DB      0                  ;Fehlerbyte
  CAEE    00             C+                 DB      S0.ADA                  ;Basisadresse
  CAEF    00             C+                 DB      0                  ;Subadresse
  CAF0    02             C+                 DB      02H                 ;Kommando
  CAF1    0000           C+                 DW      0               ;Rueckehradresse
  CAF3    B7E0           C+                 DW      S0.PFFI               ;Pufferadresse
  CAF5    04             C+                 DB      HIGH(400H)         ;Pufferlaenge
  CAF6    00             C+                 DB      LOW(400H)
  CAF7    7F             C+                 DB      7FH                ;Informationsbyte 1
  CAF8    19             C+                 DB      19H                ;Informationsbyte 2
  CAF9    00             C+                 DB      0                ;Informationsbyte 3
  CAFA    0000           C                  DW      0                   ;OPEN
  CAFC    0000           C                  DW      0                   ;CLOSE
  CAFE    0000           C                  DW      0                   ;READ
  CB00    0000           C                  DW      0                   ;KONV
                         C      ;****************************************************************
                         C      ;*               L B - S t a n z e r                            *
                         C      ;****************************************************************
  CB02    19             C      S3.LBS:     DB      S3.PRIN-S3.LBS      ;Laengenbyte
  CB03    00             C                  DB      00000000B           ;Typ - Kennsatz nein
  CB04    80             C                  DB      10000000B           ;Geraetebyte
                         C                  S3.RMOS 0,0,S0.ADA,0,0,0,S0.PFFA,400H,80H,19H,0
  CB05    00             C+                 DB      0                  ;Statusbyte
  CB06    00             C+                 DB      0                  ;Fehlerbyte
  CB07    00             C+                 DB      S0.ADA                  ;Basisadresse
  CB08    00             C+                 DB      0                  ;Subadresse
  CB09    00             C+                 DB      0                 ;Kommando
  CB0A    0000           C+                 DW      0               ;Rueckehradresse
  CB0C    BBF0           C+                 DW      S0.PFFA               ;Pufferadresse
  CB0E    04             C+                 DB      HIGH(400H)         ;Pufferlaenge
  CB0F    00             C+                 DB      LOW(400H)
  CB10    80             C+                 DB      80H                ;Informationsbyte 1
  CB11    19             C+                 DB      19H                ;Informationsbyte 2
  CB12    00             C+                 DB      0                ;Informationsbyte 3
  CB13    0000           C                  DW      0                   ;OPEN
  CB15    0000           C                  DW      0                   ;CLOSE
  CB17    0000           C                  DW      0                   ;WRITE
  CB19    0000           C                  DW      0                   ;KONV
                         C      ;****************************************************************
                         C      ;*               P R I N - Drucker                              *
                         C      ;****************************************************************
  CB1B    19             C      S3.PRIN:    DB      S3.ENDEA-S3.PRIN    ;Laengenbyte
  CB1C    00             C                  DB      00000000B           ;Typ - Kennsatz nein
  CB1D    81             C                  DB      10000001B           ;Geraetebyte
                         C                  S3.RMOS 0,0,S0.DRU,S0.IVSYS,0,0,S0.PFFA,400H,0,0,0
  CB1E    00             C+                 DB      0                  ;Statusbyte
  CB1F    00             C+                 DB      0                  ;Fehlerbyte
  CB20    40             C+                 DB      S0.DRU                  ;Basisadresse
  CB21    58             C+                 DB      S0.IVSYS                  ;Subadresse
'Kanal - Tabellen'	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  CB22    00             C+                 DB      0                 ;Kommando
  CB23    0000           C+                 DW      0               ;Rueckehradresse
  CB25    BBF0           C+                 DW      S0.PFFA               ;Pufferadresse
  CB27    04             C+                 DB      HIGH(400H)         ;Pufferlaenge
  CB28    00             C+                 DB      LOW(400H)
  CB29    00             C+                 DB      0                ;Informationsbyte 1
  CB2A    00             C+                 DB      0                ;Informationsbyte 2
  CB2B    00             C+                 DB      0                ;Informationsbyte 3
  CB2C    F597           C                  DW      SM.MRES             ;OPEN
  CB2E    0000           C                  DW      0                   ;CLOSE
  CB30    F5AB           C                  DW      SM.PRIO             ;WRITE
  CB32    0000           C                  DW      0                   ;KONV
                         C      
  CB34    00             C      S3.ENDEA:   DB      0                   ;Ende - Kanaltabellen
                         C      
