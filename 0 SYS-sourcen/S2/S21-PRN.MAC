                         C                  PAGE
'Anfangswert UPs'	MACRO-80 3.44	09-Dec-81	PAGE	1-50


                         C      
                         C      ;****************************************************************
                         C      ;*               belegen der Steuerwerte  SPANZ  und  ZANZ      *
                         C      ;****************************************************************
  CBEA    E5             C      MO.ANZ:     PUSH    HL
  CBEB    26 50          C                  LD      H,S0.SPANZ
  CBED    2E 18          C                  LD      L,S0.ZANZ
  CBEF    22 B192        C                  LD      (MS.ZANZ),HL
  CBF2    E1             C                  POP     HL
  CBF3    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*               volles Bild  ===> BWS - Format                 *
                         C      ;****************************************************************
  CBF4    E5             C      MO.VOLLB:   PUSH    HL
  CBF5    21 0101        C                  LD      HL,0101H            ;SMIN=1        ZMIN=1
  CBF8    22 B18E        C                  LD      (MS.ZMIN),HL
  CBFB    2A B192        C                  LD      HL,(MS.ZANZ)        ;SMAX=SPANZ    ZMAX=ZANZ
  CBFE    22 B190        C                  LD      (MS.ZMAX),HL
  CC01    E1             C                  POP     HL
  CC02    C9             C                  RET
                         C      
                         C      ;****************************************************************
                         C      ;*               volles Bild minus 2 Zeilen ===> BWS - Format   *
                         C      ;****************************************************************
  CC03    E5             C      MO.VB2:     PUSH    HL
  CC04    21 0101        C                  LD      HL,0101H            ;SMIN=1        ZMIN=1
  CC07    22 B18E        C                  LD      (MS.ZMIN),HL
  CC0A    2A B192        C                  LD      HL,(MS.ZANZ)        ;SMAX=SPANZ    ZMAX=ZANZ-2
  CC0D    2D             C                  DEC     L
  CC0E    2D             C                  DEC     L
  CC0F    22 B190        C                  LD      (MS.ZMAX),HL
  CC12    E1             C                  POP     HL
  CC13    C9             C                  RET
                         C      
                         C      ;****************************************************************
                         C      ;*               Systemzeile   ===>  BWS - Format               *
                         C      ;****************************************************************
  CC14    E5             C      MO.SYSB:    PUSH    HL
  CC15    26 03          C                  LD      H,3                 ;SMIN=3
  CC17    2E 0B          C                  LD      L,S0.SYSZ           ;ZMIN=SYSZ
  CC19    22 B18E        C                  LD      (MS.ZMIN),HL
  CC1C    26 18          C                  LD      H,24                ;SMAX=24
  CC1E    22 B190        C                  LD      (MS.ZMAX),HL
  CC21    E1             C                  POP     HL
  CC22    C9             C                  RET
                         C      
                         C                  PAGE
'Anfangswert UPs'	MACRO-80 3.44	09-Dec-81	PAGE	1-51


                         C      
                         C      ;****************************************************************
                         C      ;*               gesamtes Bild loeschen                         *
                         C      ;****************************************************************
  CC23    E5             C      MO.BILO:    PUSH    HL
  CC24    2A B194        C                  LD      HL,(MS.BWSA)
  CC27    23             C                  INC     HL
  CC28    EB             C                  EX      DE,HL
  CC29    2A B194        C                  LD      HL,(MS.BWSA)
  CC2C    CD CF81        C                  CALL    MO.BWSL
  CC2F    0B             C                  DEC     BC
  CC30    36 20          C                  LD      (HL),' '
  CC32    ED B0          C                  LDIR
  CC34    CD CB64        C                  CALL    MO.BWSUS
  CC37    E1             C                  POP     HL
  CC38    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*               Bildfenster loeschen                           *
                         C      ;****************************************************************
  CC39    E5             C      MO.FSLO:    PUSH    HL
  CC3A    2A B190        C                  LD      HL,(MS.ZMAX)
  CC3D    ED 5B B18E     C                  LD      DE,(MS.ZMIN)
  CC41    AF             C                  XOR     A
  CC42    ED 52          C                  SBC     HL,DE
  CC44    45             C                  LD      B,L
  CC45    04             C                  INC     B
  CC46    C5             C                  PUSH    BC                  ;Anzahl Fensterzeilen
  CC47    4C             C                  LD      C,H
  CC48    C5             C                  PUSH    BC                  ;Anzahl Fensterspalten-1
  CC49    CD CF62        C                  CALL    MO.BWSAF
  CC4C    E5             C                  PUSH    HL
  CC4D    36 20          C                  LD      (HL),' '            ;erste Zeile loeschen
  CC4F    23             C                  INC     HL
  CC50    EB             C                  EX      DE,HL
  CC51    E1             C                  POP     HL
  CC52    E5             C                  PUSH    HL
  CC53    06 00          C                  LD      B,0
  CC55    ED B0          C                  LDIR
  CC57    E1             C      MO.FSLO1:   POP     HL                  ;weitere Zeilen loeschen
  CC58    D1             C                  POP     DE
  CC59    C1             C                  POP     BC
  CC5A    05             C                  DEC     B
  CC5B    28 15          C                  JR      Z,MO.FSLO2
  CC5D    C5             C                  PUSH    BC
  CC5E    D5             C                  PUSH    DE
  CC5F    06 00          C                  LD      B,0
  CC61    4B             C                  LD      C,E
  CC62    0C             C                  INC     C
  CC63    E5             C                  PUSH    HL
  CC64    3A B193        C                  LD      A,(MS.SPANZ)
  CC67    16 00          C                  LD      D,0
  CC69    5F             C                  LD      E,A
  CC6A    19             C                  ADD     HL,DE
  CC6B    EB             C                  EX      DE,HL
  CC6C    E1             C                  POP     HL
  CC6D    D5             C                  PUSH    DE
  CC6E    ED B0          C                  LDIR
  CC70    18 E5          C                  JR      MO.FSLO1
                         C      ;            
  CC72    CD CB64        C      MO.FSLO2:   CALL    MO.BWSUS
  CC75    E1             C                  POP     HL
  CC76    C9             C                  RET
                         C                  TITLE   'Bildfensterinhalt rollen'
                         C                  PAGE
'Bildfensterinhalt rollen'	MACRO-80 3.44	09-Dec-81	PAGE	1-52


                         C      
                         C      ;****************************************************************
                         C      ;*               Bildfensterinhalt um eine Zeile nach oben      *
                         C      ;****************************************************************
  CC77    E5             C      MO.ROOB:    PUSH    HL
  CC78    CD CD19        C                  CALL    MO.RORL1
  CC7B    28 19          C                  JR      Z,MO.ROOB2
  CC7D    F5             C                  PUSH    AF
  CC7E    CD CF62        C                  CALL    MO.BWSAF            ;DE ermitteln
  CC81    E5             C      MO.ROOB1:   PUSH    HL
  CC82    CD CF7A        C                  CALL    MO.DESZ             ;HL ermitteln
  CC85    19             C                  ADD     HL,DE
  CC86    D1             C                  POP     DE
  CC87    D5             C                  PUSH    DE
  CC88    CD CD3B        C                  CALL    MO.RORL5
  CC8B    CD CF7A        C                  CALL    MO.DESZ
  CC8E    E1             C                  POP     HL
  CC8F    19             C                  ADD     HL,DE
  CC90    F1             C                  POP     AF
  CC91    3D             C                  DEC     A
  CC92    F5             C                  PUSH    AF
  CC93    20 EC          C                  JR      NZ,MO.ROOB1
  CC95    F1             C                  POP     AF
  CC96    CD CD1D        C      MO.ROOB2:   CALL    MO.RORL7
  CC99    CD CF62        C                  CALL    MO.BWSAF
  CC9C    CD CF6E        C                  CALL    MO.PNSP
  CC9F    36 20          C      MO.ROOB3:   LD      (HL),' '
  CCA1    E5             C                  PUSH    HL
  CCA2    D1             C                  POP     DE
  CCA3    13             C                  INC     DE
  CCA4    CD CD29        C                  CALL    MO.RORL3
  CCA7    28 03          C                  JR      Z,MO.ROOB4
  CCA9    CD CD3F        C                  CALL    MO.RORL6
  CCAC    18 C4          C      MO.ROOB4:   JR      MO.FSLO2
                         C      ;****************************************************************
                         C      ;*               Bildfensterinhalt um eine Zeile nach unten     *
                         C      ;****************************************************************
  CCAE    E5             C      MO.ROUN:    PUSH    HL
  CCAF    CD CD19        C                  CALL    MO.RORL1
  CCB2    28 20          C                  JR      Z,MO.ROUN2
  CCB4    F5             C                  PUSH    AF                  ;DE ermitteln
  CCB5    CD CF62        C                  CALL    MO.BWSAF
  CCB8    CD CF6E        C                  CALL    MO.PNSP
  CCBB    E5             C      MO.ROUN1:   PUSH    HL
  CCBC    CD CF7A        C                  CALL    MO.DESZ             ;HL ermitteln
  CCBF    B7             C                  OR      A
  CCC0    ED 52          C                  SBC     HL,DE
  CCC2    D1             C                  POP     DE
  CCC3    D5             C                  PUSH    DE
  CCC4    CD CD3B        C                  CALL    MO.RORL5
  CCC7    CD CF7A        C                  CALL    MO.DESZ
  CCCA    E1             C                  POP     HL
  CCCB    B7             C                  OR      A
  CCCC    ED 52          C                  SBC     HL,DE
  CCCE    F1             C                  POP     AF
  CCCF    3D             C                  DEC     A
  CCD0    F5             C                  PUSH    AF
  CCD1    20 E8          C                  JR      NZ,MO.ROUN1
  CCD3    F1             C                  POP     AF
  CCD4    CD CF62        C      MO.ROUN2:   CALL    MO.BWSAF
  CCD7    18 C6          C                  JR      MO.ROOB3
                         C      
                         C                  PAGE
'Bildfensterinhalt rollen'	MACRO-80 3.44	09-Dec-81	PAGE	1-53


                         C      
                         C      ;****************************************************************
                         C      ;*               Bildfensterinhalt um eine Spalte nach links    *
                         C      ;****************************************************************
  CCD9    E5             C      MO.ROLI:    PUSH    HL
  CCDA    CD CD24        C                  CALL    MO.RORL2
  CCDD    08             C                  EX      AF,AF'              ;'
  CCDE    CD CF62        C                  CALL    MO.BWSAF
  CCE1    C5             C      MO.ROLI1:   PUSH    BC
  CCE2    E5             C                  PUSH    HL
  CCE3    E5             C                  PUSH    HL
  CCE4    D1             C                  POP     DE
  CCE5    23             C                  INC     HL
  CCE6    08             C                  EX      AF,AF'              ;'
  CCE7    B7             C                  OR      A
  CCE8    28 03          C                  JR      Z,MO.ROLI2
  CCEA    CD CD3F        C                  CALL    MO.RORL6
  CCED    E1             C      MO.ROLI2:   POP     HL
  CCEE    C1             C                  POP     BC
  CCEF    CD CD30        C                  CALL    MO.RORL4
  CCF2    10 ED          C                  DJNZ    MO.ROLI1
  CCF4    18 B6          C      MO.ROLI3:   JR      MO.ROOB4
                         C      ;****************************************************************
                         C      ;*               Bildfensterinhalt um eine Spalte nach rechts   *
                         C      ;****************************************************************
  CCF6    E5             C      MO.RORE:    PUSH    HL
  CCF7    CD CD24        C                  CALL    MO.RORL2
  CCFA    CD CF62        C                  CALL    MO.BWSAF
  CCFD    16 00          C                  LD      D,0
  CCFF    5F             C                  LD      E,A
  CD00    08             C                  EX      AF,AF'              ;'
  CD01    19             C                  ADD     HL,DE
  CD02    C5             C      MO.RORE1:   PUSH    BC
  CD03    E5             C                  PUSH    HL
  CD04    E5             C                  PUSH    HL
  CD05    D1             C                  POP     DE
  CD06    2B             C                  DEC     HL
  CD07    08             C                  EX      AF,AF'              ;'
  CD08    B7             C                  OR      A
  CD09    28 05          C                  JR      Z,MO.RORE2
  CD0B    06 00          C                  LD      B,0
  CD0D    4F             C                  LD      C,A
  CD0E    ED B8          C                  LDDR
  CD10    E1             C      MO.RORE2:   POP     HL
  CD11    C1             C                  POP     BC
  CD12    CD CD30        C                  CALL    MO.RORL4
  CD15    10 EB          C                  DJNZ    MO.RORE1
  CD17    18 DB          C                  JR      MO.ROLI3
                         C      
                         C                  PAGE
'Bildfensterinhalt rollen'	MACRO-80 3.44	09-Dec-81	PAGE	1-54


                         C      
  CD19    DD 21 B18E     C      MO.RORL1:   LD      IX,MS.ZMIN
  CD1D    DD 7E 02       C      MO.RORL7:   LD      A,(IX+2)
  CD20    DD 96 00       C                  SUB     (IX+0)
  CD23    C9             C                  RET
                         C      
  CD24    CD CD19        C      MO.RORL2:   CALL    MO.RORL1
  CD27    47             C                  LD      B,A
  CD28    04             C                  INC     B
  CD29    DD 7E 03       C      MO.RORL3:   LD      A,(IX+3)
  CD2C    DD 96 01       C                  SUB     (IX+1)
  CD2F    C9             C                  RET
                         C      
  CD30    08             C      MO.RORL4:   EX      AF,AF'              ;'
  CD31    EB             C                  EX      DE,HL
  CD32    36 20          C                  LD      (HL),' '
  CD34    26 00          C                  LD      H,0
  CD36    DD 6E 05       C                  LD      L,(IX+5)
  CD39    19             C                  ADD     HL,DE
  CD3A    C9             C                  RET
                         C      
  CD3B    CD CD29        C      MO.RORL5:   CALL    MO.RORL3
  CD3E    3C             C                  INC     A
  CD3F    06 00          C      MO.RORL6:   LD      B,0
  CD41    4F             C                  LD      C,A
  CD42    ED B0          C                  LDIR
  CD44    C9             C                  RET
                         C      
                         C                  TITLE   'Cursor Operationen'
                         C                  PAGE
'Cursor Operationen'	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                         C      
                         C      ;****************************************************************
                         C      ;*               Cursor setzen bzw. loeschen an der             *
                         C      ;*               aktuellen Schreibposition                      *
                         C      ;****************************************************************
  CD45    E5             C      MO.SETC:    PUSH    HL
  CD46    C5             C                  PUSH    BC
  CD47    F5             C                  PUSH    AF
  CD48    3A B18D        C                  LD      A,(MS.SPOS)         ;X-Koordinate
  CD4B    32 CD62        C                  LD      (MO.SETC1+2),A
  CD4E    3A B18C        C                  LD      A,(MS.ZPOS)         ;Y-Koordinate
  CD51    32 CD63        C                  LD      (MO.SETC1+3),A
  CD54    21 CD60        C                  LD      HL,MO.SETC1         ;Emulator-Routine ansprechen
  CD57    01 0540        C                  LD      BC,00540H
  CD5A    ED B3          C                  OTIR
  CD5C    F1             C                  POP     AF
  CD5D    C1             C                  POP     BC
  CD5E    E1             C                  POP     HL
  CD5F    C9             C                  RET
  CD60    F0             C      MO.SETC1:   DB      0F0H
  CD61    01             C                  DB      001H                ;Cursor Ein
  CD62    00             C                  DB      0                   ;X
  CD63    00             C                  DB      0                   ;Y
  CD64    FF             C                  DB      0FFH
                         C      ;
                         C      ;
                         C      ;
  CD65    E5             C      MO.RESC:    PUSH    HL
  CD66    C5             C                  PUSH    BC
  CD67    21 CD72        C                  LD      HL,MO.RESC1         ;Emulator-Routine ansprechen
  CD6A    01 0340        C                  LD      BC,00340H
  CD6D    ED B3          C                  OTIR
  CD6F    C1             C                  POP     BC
  CD70    E1             C                  POP     HL
  CD71    C9             C                  RET
  CD72    F0             C      MO.RESC1:   DB      0F0H
  CD73    02             C                  DB      002H                ;Cursor Aus
  CD74    FF             C                  DB      0FFH            
                         C      
                         C      ;****************************************************************
                         C      ;*               DZPOS , DSPOS , DZPOL , DSPOL                  *
                         C      ;****************************************************************
  CD75    21 B18A        C      MO.DZPOL:   LD      HL,MS.ZPOL          ;Lesezeilennr.     decr.
  CD78    CD CD92        C                  CALL    MO.DECZ
  CD7B    18 06          C                  JR      MO.DIL
                         C      
  CD7D    21 B18B        C      MO.DSPOL:   LD      HL,MS.SPOL          ;Lesespaltennr.    decr.
  CD80    CD CDA4        C                  CALL    MO.DECS
  CD83    C5             C      MO.DIL:     PUSH    BC
  CD84    CD CF1D        C                  CALL    MO.CPOL
  CD87    C1             C                  POP     BC
  CD88    3F             C                  CCF                         ;Z = CY = 1  falls Uebertrag
  CD89    C9             C                  RET
                         C      
  CD8A    21 B18C        C      MO.DZPOS:   LD      HL,MS.ZPOS          ;Schreibzeilennr.  decr.
  CD8D    CD CD92        C                  CALL    MO.DECZ
  CD90    18 22          C                  JR      MO.DIS
                         C      
  CD92    C5             C      MO.DECZ:    PUSH    BC
  CD93    3A B190        C                  LD      A,(MS.ZMAX)
  CD96    47             C                  LD      B,A
  CD97    3A B18E        C                  LD      A,(MS.ZMIN)
  CD9A    18 10          C                  JR      MO.DEC2
                         C      
  CD9C    21 B18D        C      MO.DSPOS:   LD      HL,MS.SPOS          ;Schreibspaltennr. decr.
  CD9F    CD CDA4        C                  CALL    MO.DECS
  CDA2    18 10          C                  JR      MO.DIS
                         C      
  CDA4    C5             C      MO.DECS:    PUSH    BC
  CDA5    3A B191        C                  LD      A,(MS.SMAX)
  CDA8    47             C                  LD      B,A
  CDA9    3A B18F        C                  LD      A,(MS.SMIN)
  CDAC    3D             C      MO.DEC2:    DEC     A
  CDAD    BE             C                  CP      (HL)
  CDAE    28 15          C                  JR      Z,MO.DEC3           ;Z=1,CY=0 falls Uebertrag
  CDB0    35             C                  DEC     (HL)
  CDB1    C3 CF16        C                  JP      MO.INC4
                         C      
  CDB4    C5             C      MO.DIS:     PUSH    BC
  CDB5    CD CF18        C                  CALL    MO.CPOS
  CDB8    C1             C                  POP     BC
  CDB9    3F             C                  CCF                         ;Z = CY = 1  falls Uebertrag
'Cursor Operationen'	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  CDBA    C9             C                  RET
                         C      
  CDBB    ED 4B B192     C      MO.ROLL:    LD      BC,(MS.ZANZ)        ;Standardanschlussroutine Rollfkt.
  CDBF    36 20          C      MO.ROL1:    LD      (HL),' '            ;loeschen der Zeile auf blank
  CDC1    23             C                  INC     HL
  CDC2    10 FB          C                  DJNZ    MO.ROL1
  CDC4    C9             C                  RET
                         C      
                         C                  PAGE
'Cursor Operationen'	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                         C      
  CDC5    F5             C      MO.DEC3:    PUSH    AF                  ;Rollfunktion
  CDC6    C5             C                  PUSH    BC                  ;rollen nach unten raus
  CDC7    D5             C                  PUSH    DE
  CDC8    E5             C                  PUSH    HL
  CDC9    21 B197        C                  LD      HL,MS.DIRES         ;Abfrage , ob Rollen ein
