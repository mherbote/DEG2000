                         C                  PAGE
'Vektor lesen/schreiben'	MACRO-80 3.44	09-Dec-81	PAGE	1-69


                         C      
                         C      ;****************************************************************
                         C      ;*               Vektor schreiben                               *
                         C      ;*               -----------------------------------------------*
                         C      ;*               HL = auszugebender Vektor                      *
                         C      ;*               B  = Laenge des    Vektors                     *
                         C      ;****************************************************************
  D123    3A B197        C      MO.MVS:     LD      A,(MS.DIRES)
  D126    F5             C                  PUSH    AF
  D127    CB FF          C                  SET     7,A
  D129    CB F7          C                  SET     6,A
  D12B    32 B197        C                  LD      (MS.DIRES),A
  D12E    7E             C      MO.MVS1:    LD      A,(HL)
  D12F    23             C                  INC     HL
  D130    E5             C                  PUSH    HL
  D131    C5             C                  PUSH    BC
  D132    32 B199        C                  LD      (MS.TK),A
  D135    CD CFFD        C                  CALL    MO.MZS
  D138    C1             C                  POP     BC
  D139    E1             C                  POP     HL
  D13A    10 F2          C                  DJNZ    MO.MVS1
  D13C    F1             C                  POP     AF
  D13D    32 B197        C                  LD      (MS.DIRES),A
  D140    C9             C                  RET
                         C      
                         C      ;****************************************************************
                         C      ;*                Vektor lesen                                  *
                         C      ;*                ----------------------------------------------*
                         C      ;*                HL = Zieladresse des einzulesenden Vektors    *
                         C      ;*                B  = Laenge des Vektors                       *
                         C      ;****************************************************************
  D141    3A B196        C      MO.MVL:     LD      A,(MS.DIREL)
  D144    F5             C                  PUSH    AF
  D145    CB FF          C                  SET     7,A
  D147    CB F7          C                  SET     6,A
  D149    32 B196        C                  LD      (MS.DIREL),A
  D14C    E5             C      MO.MVL1:    PUSH    HL
  D14D    C5             C                  PUSH    BC
  D14E    CD D00F        C                  CALL    MO.MZL
  D151    C1             C                  POP     BC
  D152    E1             C                  POP     HL
  D153    3A B199        C                  LD      A,(MS.TK)
  D156    77             C                  LD      (HL),A
  D157    23             C                  INC     HL
  D158    10 F2          C                  DJNZ    MO.MVL1
  D15A    F1             C                  POP     AF
  D15B    32 B196        C                  LD      (MS.DIREL),A
  D15E    C9             C                  RET
                         C      
                         C      ;           END
                         C      ;           PN      TA35
                         C                  TITLE   'Tastaturroutine'
                         C                  PAGE
'Tastaturroutine'	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                         C      
                         C      ;****************************************************************
                         C      ;*               Tastaturroutine                                *
                         C      ;*  Version      -----------------------------------------------*
                         C      ;*               Programmierer: M. Herbote --- K EAW  ZFT (WFT) *
                         C      ;*  V 2 . 1      -----------------------------------------------*
                         C      ;*               Stand        : 06.Maerz 1985                   *
                         C      ;****************************************************************
                         C      
                         C      ;****************************************************************
                         C      ;*               symbolische Adressen und ihre Bedeutung        *
                         C      ;* symbol.Adr. ! Bedeutung                                      *
                         C      ;*-------------!------------------------------------------------*
                         C      ;* TA.TA1      ! Abfrage nach gedrueckter Taste                 *
                         C      ;* TA.TA2      ! Einlesen des Tastaturcodes                     *
                         C      ;* TA.PIOPR    ! programmieren des Tastatur-PIO                 *
                         C      ;* TA.E0IN     ! Anfangswerte fuer EMERK , UMERK und KGMER      *
                         C      ;* TA.LOE      ! loeschen aller Tastenroutinenadressen          *
                         C      ;* TA.LOES     ! wie TA.LOE mit Belegung Standardroutinen       *
                         C      ;* TA.ABFR     ! Tastaturabfrage und Ausfuehrung Tastenfunktion *
                         C      ;* TA.TFE      ! Warteschleife bis keine Taste mehr gedrueckt   *
                         C      ;*-------------!------------------------------------------------*
                         C      ;* Tabellen mit den Funktionsadressen der einzelnen Tasten      *
                         C      ;* TS.TAB1     ! Funktionstasten  P01 bis P48                   *
                         C      ;* TS.TAB2     ! INS MOD   , DEL      , INS LINE   , DEL LINE , *
                         C      ;*             ! SCH LINKS , C HOCH   , SCH RECHTS ,            *
                         C      ;*             ! C LINKS   , HOME     , C RECHTS   ,            *
                         C      ;*             ! CNZA      , C RUNTER                           *
                         C      ;* TS.TAB3     ! 00 , 000  , NEG QUIT , SYS  , END , ABS        *
                         C      ;* TS.TAB4     ! POS QUIT  , TABS     , TABL , CI  , M          *
                         C      ;* TS.EINA     ! Auswerten der alphanumerischen Tasten          *
                         C      ;* TS.TABU     ! Auswerten der Taste  ET2 == HT                 *
                         C      ;* TS.NEWL     ! Auswerten der Taste  ET1 == RS                 *
                         C      ;* TS.TAB5     ! Ebene 0   , Ebene 1  , Ebene 2    , Ebenen 3   *
                         C      ;*-------------!------------------------------------------------*
                         C      ;* TS.PTAST    ! I/O-Adresse der Tastatur                       *
                         C      ;* TS.TK       ! Zwischenspeicher fuer den Tastaturcode         *
                         C      ;* TS.PTK      ! Zwischenspeicher fuer die P-Tastennummer       *
                         C      ;* TS.EMERK    ! Merker fuer die aktive P-Tastenebene           *
                         C      ;* TS.SPMER    ! Tastaturgruppenmerker                          *
                         C      ;*             ! Bit ! Hexacode    ! Funktion                   *
                         C      ;*             !-----!-------------!----------------------------*
                         C      ;*             ! 0   ! 00-1F       ! Steuer- / Sonder-zeichen   *
                         C      ;*             ! 1   ! 20,2C       !  ,                         *
                         C      ;*             ! 2   ! 2B,2D,2E    ! +-.                        *
                         C      ;*             ! 3   ! 30-39       ! 0123456789                 *
                         C      ;*             ! 4   !             ! !"%&'()*/:;<=>?[\]^_{|}`~  *
                         C      ;*             ! 5   ! 40-5A,23,24 ! A...Z@#$   Grossbuchstaben *
                         C      ;*             ! 6   ! 61-7A       ! a...z      Kleinbuchstaben *
                         C      ;*             ! 7   ! 80-FF       ! Funktionstasten            *
                         C      ;* TS.UMERK    ! =0 INS MOD aus   =1 INS MOD ein                *
                         C      ;* TS.KGMER    ! =0 Programmier-  =1 Schreibmaschinen- Tastatur *
                         C      ;* TS.ZSMER    ! =0 Schnellschreiben nicht erlaubt              *
                         C      ;* TS.ZEIT1    ! Zeitkonstante 1 fuer die Warteschleife         *
                         C      ;* TS.ZEIT2    ! Zeitkonstante 2 fuer die Warteschleife         *
                         C      ;* TS.MIO      ! =0 I/O -         =1 memory - Bereitstellung    *
                         C      ;* TS.MBF      ! =0 kein          =1 Abspeichern als Bedienfolge*
                         C      ;* TS.BFOL1    ! Pointer Bedienfolgespeicher bei Aufbau         *
                         C      ;* TS.BFOL2    ! Pointer Bedienfolgespeicher bei Abarbeitung    *
                         C      ;* TS.STACK    ! Zeiger zum aktuellen Keller                    *
                         C      ;****************************************************************
                         C                  PAGE
'Tastaturroutine'	MACRO-80 3.44	09-Dec-81	PAGE	1-71


                         C      
                         C      ;****************************************************************
                         C      ;*               Verbindungs - Macro zur Version 1.2            *
                         C      ;****************************************************************
                         C      TA.TAST     MACRO   UP
                         C                  PUSH    AF
                         C                  CALL    S0.TAZU
                         C                  POP     AF
                         C                  CALL    UP
                         C                  PUSH    AF
                         C                  PUSH    BC
                         C                  PUSH    DE
                         C                  CALL    S2.STACK
                         C                  POP     DE
                         C                  POP     BC
                         C                  POP     AF
                         C                  ENDM
                         C      ;****************************************************************
                         C      ;*               UP zum Abfragen nach gedrueckter Taste         *
                         C      ;****************************************************************
  D15F    3A B23B        C      TA.TA1:     LD      A,(TS.PTAST)
                         C                  TA.TAST S0.TA1
  D162    F5             C+                 PUSH    AF
  D163    CD F64F        C+                 CALL    S0.TAZU
  D166    F1             C+                 POP     AF
  D167    CD 4003        C+                 CALL    S0.TA1
  D16A    F5             C+                 PUSH    AF
  D16B    C5             C+                 PUSH    BC
  D16C    D5             C+                 PUSH    DE
  D16D    CD B2D4        C+                 CALL    S2.STACK
  D170    D1             C+                 POP     DE
  D171    C1             C+                 POP     BC
  D172    F1             C+                 POP     AF
  D173    32 B245        C                  LD      (TS.ZEI21),A
  D176    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*               UP zum einlesen des Tastaturcodes              *
                         C      ;****************************************************************
  D177    3A B23B        C      TA.TA2:     LD      A,(TS.PTAST)
                         C                  TA.TAST S0.TA2
  D17A    F5             C+                 PUSH    AF
  D17B    CD F64F        C+                 CALL    S0.TAZU
  D17E    F1             C+                 POP     AF
  D17F    CD 4006        C+                 CALL    S0.TA2
  D182    F5             C+                 PUSH    AF
  D183    C5             C+                 PUSH    BC
  D184    D5             C+                 PUSH    DE
  D185    CD B2D4        C+                 CALL    S2.STACK
  D188    D1             C+                 POP     DE
  D189    C1             C+                 POP     BC
  D18A    F1             C+                 POP     AF
  D18B    47             C                  LD      B,A
  D18C    3A B245        C                  LD      A,(TS.ZEI21)
  D18F    CB 57          C                  BIT     2,A
  D191    20 2A          C                  JR      NZ,TA.TA21
  D193    78             C                  LD      A,B                 ;Auswertung der CTRL-Tasten
  D194    FE 85          C                  CP      85H
  D196    30 25          C                  JR      NC,TA.TA21
  D198    FE 84          C                  CP      84H
  D19A    20 04          C                  JR      NZ,TA.TA22
  D19C    06 F4          C                  LD      B,0F4H              ;SCH_LINKS
  D19E    18 1D          C                  JR      TA.TA21
  D1A0    FE 80          C      TA.TA22:    CP      80H
  D1A2    38 03          C                  JR      C,TA.TA23
  D1A4    C6 31          C                  ADD     A,31H               ;TABS,TABL,CI,M
  D1A6    47             C                  LD      B,A
  D1A7    FE 70          C      TA.TA23:    CP      70H
  D1A9    30 12          C                  JR      NC,TA.TA21
  D1AB    FE 60          C                  CP      60H
  D1AD    38 03          C                  JR      C,TA.TA24
  D1AF    C6 80          C                  ADD     A,80H               ;Tastencode  E0H ... EFH
  D1B1    47             C                  LD      B,A
  D1B2    FE 50          C      TA.TA24:    CP      50H
  D1B4    30 07          C                  JR      NC,TA.TA21
  D1B6    FE 40          C                  CP      40H
  D1B8    38 03          C                  JR      C,TA.TA21
  D1BA    C6 90          C                  ADD     A,90H               ;Tastencode  D0H ... DFH
  D1BC    47             C                  LD      B,A
  D1BD    78             C      TA.TA21:    LD      A,B
  D1BE    C9             C                  RET
                         C      
                         C                  TITLE   'Init. und Zusatzfkt. Tastatur'
'Init. und Zusatzfkt. Tastatur'	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                         C                  PAGE
'Init. und Zusatzfkt. Tastatur'	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                         C      
                         C      ;****************************************************************
                         C      ;*               Init. und Zusatzfunktionen der Tastatur        *
                         C      ;****************************************************************
  D1BF    3A B23B        C      TA.PIOPR:   LD      A,(TS.PTAST)
                         C                  TA.TAST S0.TINIT
  D1C2    F5             C+                 PUSH    AF
  D1C3    CD F64F        C+                 CALL    S0.TAZU
  D1C6    F1             C+                 POP     AF
  D1C7    CD 4000        C+                 CALL    S0.TINIT
  D1CA    F5             C+                 PUSH    AF
  D1CB    C5             C+                 PUSH    BC
  D1CC    D5             C+                 PUSH    DE
  D1CD    CD B2D4        C+                 CALL    S2.STACK
  D1D0    D1             C+                 POP     DE
  D1D1    C1             C+                 POP     BC
  D1D2    F1             C+                 POP     AF
  D1D3    C9             C                  RET
                         C      
  D1D4    CD D15F        C      TA.TA3:     CALL    TA.TA1
  D1D7    20 FB          C                  JR      NZ,TA.TA3
  D1D9    CD D177        C                  CALL    TA.TA2
  D1DC    C9             C                  RET
                         C      
  D1DD    3A B23B        C      TA.TRTFE:   LD      A,(TS.PTAST)
                         C                  TA.TAST S0.TFE
  D1E0    F5             C+                 PUSH    AF
  D1E1    CD F64F        C+                 CALL    S0.TAZU
  D1E4    F1             C+                 POP     AF
  D1E5    CD 400C        C+                 CALL    S0.TFE
  D1E8    F5             C+                 PUSH    AF
  D1E9    C5             C+                 PUSH    BC
  D1EA    D5             C+                 PUSH    DE
  D1EB    CD B2D4        C+                 CALL    S2.STACK
  D1EE    D1             C+                 POP     DE
  D1EF    C1             C+                 POP     BC
  D1F0    F1             C+                 POP     AF
  D1F1    C9             C                  RET
                         C      
  D1F2    3A B23B        C      TA.TIM:     LD      A,(TS.PTAST)        ;Ansteuerung der INS_MOD Diode
                         C                  TA.TAST S0.TIM
  D1F5    F5             C+                 PUSH    AF
  D1F6    CD F64F        C+                 CALL    S0.TAZU
  D1F9    F1             C+                 POP     AF
  D1FA    CD 400F        C+                 CALL    S0.TIM
  D1FD    F5             C+                 PUSH    AF
  D1FE    C5             C+                 PUSH    BC
  D1FF    D5             C+                 PUSH    DE
  D200    CD B2D4        C+                 CALL    S2.STACK
  D203    D1             C+                 POP     DE
  D204    C1             C+                 POP     BC
  D205    F1             C+                 POP     AF
  D206    C9             C                  RET
                         C      
  D207    3A B23B        C      TA.TEM:     LD      A,(TS.PTAST)        ;Ansteuerung der Ebenen- Dioden
                         C                  TA.TAST S0.TEM
  D20A    F5             C+                 PUSH    AF
  D20B    CD F64F        C+                 CALL    S0.TAZU
  D20E    F1             C+                 POP     AF
  D20F    CD 4012        C+                 CALL    S0.TEM
  D212    F5             C+                 PUSH    AF
  D213    C5             C+                 PUSH    BC
  D214    D5             C+                 PUSH    DE
  D215    CD B2D4        C+                 CALL    S2.STACK
  D218    D1             C+                 POP     DE
  D219    C1             C+                 POP     BC
  D21A    F1             C+                 POP     AF
  D21B    C9             C                  RET
                         C      
  D21C    3A B23B        C      TA.TBEL:    LD      A,(TS.PTAST)        ;Ansteuerung der Fehleranzeigen
                         C                  TA.TAST S0.TBEL
  D21F    F5             C+                 PUSH    AF
  D220    CD F64F        C+                 CALL    S0.TAZU
  D223    F1             C+                 POP     AF
  D224    CD 4015        C+                 CALL    S0.TBEL
  D227    F5             C+                 PUSH    AF
  D228    C5             C+                 PUSH    BC
  D229    D5             C+                 PUSH    DE
  D22A    CD B2D4        C+                 CALL    S2.STACK
  D22D    D1             C+                 POP     DE
  D22E    C1             C+                 POP     BC
  D22F    F1             C+                 POP     AF
'Init. und Zusatzfkt. Tastatur'	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  D230    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*               Ebene 0 , INS MOD auf aus und KGMER auf PTAS   *
                         C      ;****************************************************************
  D231    AF             C      TA.E0IN:    XOR     A
  D232    32 B241        C                  LD      (TS.KGMER),A
  D235    32 B23E        C                  LD      (TS.EMERK),A
  D238    32 B240        C                  LD      (TS.UMERK),A
  D23B    32 B247        C                  LD      (TS.MIO),A
  D23E    32 B248        C                  LD      (TS.MBF),A
                         C      
  D241    06 01          C                  LD      B,001H              ;INS_MOD aus, Ebene 1 ???  AUS/EIN 7, 17 ???
  D243    C5             C                  PUSH    BC
                         C      ;???            CALL    TA.TIM
  D244    C1             C                  POP     BC
                         C      ;???            CALL    TA.TEM
                         C      
  D245    C9             C                  RET
                         C      
  D246    3A B23E        C      TA.BBB:     LD      A,(TS.EMERK)
  D249    3C             C                  INC     A
  D24A    47             C                  LD      B,A
  D24B    3E 80          C                  LD      A,080H
  D24D    07             C                  RLCA                        ;<--!
  D24E    10 FD          C                  DJNZ    $-1                 ;---!
  D250    47             C                  LD      B,A
  D251    3A B240        C                  LD      A,(TS.UMERK)
  D254    B7             C                  OR      A
  D255    C8             C                  RET     Z
  D256    CB F8          C                  SET     7,B
