                         C      
                         C      ;****************************************************************
                         C      ;*               suchen der  BASIC - Variable   n a $           *
                         C      ;*               -----------------------------------------------*
                         C      ;*               Eingang:   S2.RBBR+1      1. Namenszeichen     *
                         C      ;*                          S2.RBBR        2. Namenszeichen     *
                         C      ;*               Ausgang:   (HL)           Adresse der Variable *
                         C      ;*                          (DE)           Laenge  der Variable *
                         C      ;*                          (HL)=(DE)=0    na$ existiert nicht  *
                         C      ;****************************************************************
  EE6A    AF             C      S9.SUSY:    XOR     A                   ;CY=0
  EE6B    2A 015E        C                  LD      HL,(BC.D024)        ;1.Byte des Ber. f. einf. Var.
  EE6E    ED 4B 0160     C                  LD      BC,(BC.D025)        ;1.Byte des Ber. f. Dim.  Var.
  EE72    11 0007        C                  LD      DE,7                ;D = 0 , E = 7
  EE75    ED 42          C      S9.SUCHE:   SBC     HL,BC
  EE77    30 1C          C                  JR      NC,S9.ENDEV         ;wenn Ber. einf. Var. zu Ende
  EE79    09             C                  ADD     HL,BC               ;HL wieder herstellen
  EE7A    3A B26C        C                  LD      A,(S2.RBBR)         ;"Y" + 80H  fuer Y$
  EE7D    BE             C                  CP      (HL)
  EE7E    23             C                  INC     HL
  EE7F    20 10          C                  JR      NZ,S9.NISY          ;wenn nicht  SY$
  EE81    3A B26D        C                  LD      A,(S2.RBBR+1)
  EE84    BE             C                  CP      (HL)
  EE85    20 0A          C                  JR      NZ,S9.NISY          ;wenn nicht  SY$
  EE87    23             C                  INC     HL
  EE88    5E             C                  LD      E,(HL)              ;DE enthaelt Laenge der Zeichenkette
  EE89    23             C                  INC     HL
  EE8A    23             C                  INC     HL
  EE8B    46             C                  LD      B,(HL)              ;L(Zeichenkettenadresse)
  EE8C    23             C                  INC     HL
  EE8D    66             C                  LD      H,(HL)              ;H(Zeichenkettenadresse)
  EE8E    68             C                  LD      L,B
  EE8F    18 06          C                  JR      S9.UEBGA
                         C      
  EE91    AF             C      S9.NISY:    XOR     A                   ;CY=0
  EE92    19             C                  ADD     HL,DE               ;zeigt auf naechste Variable
  EE93    18 E0          C                  JR      S9.SUCHE
  EE95    1E 00          C      S9.ENDEV:   LD      E,0                 ;Laenge=0 wenn SY$ nicht gefunden
                         C      
  EE97    C9             C      S9.UEBGA:   RET
                         C      
  EE98    26 45          C      S9.ERSTR:   LD      H,'E'               ;ER$ suchen
  EE9A    2E D2          C                  LD      L,52H+80H
  EE9C    22 B26C        C      S9.NSTR:    LD      (S2.RBBR),HL
  EE9F    CD EE6A        C                  CALL    S9.SUSY
  EEA2    7A             C                  LD      A,D
  EEA3    B3             C                  OR      E
  EEA4    C9             C                  RET
                         C      
  EEA5    F5             C      S9.ERS:     PUSH    AF
  EEA6    CD EE98        C                  CALL    S9.ERSTR
  EEA9    28 07          C                  JR      Z,S9.ERS1
  EEAB    11 0006        C                  LD      DE,6
  EEAE    19             C                  ADD     HL,DE
  EEAF    F1             C                  POP     AF
  EEB0    77             C                  LD      (HL),A
  EEB1    C9             C                  RET
  EEB2    F1             C      S9.ERS1:    POP     AF
  EEB3    C9             C                  RET
