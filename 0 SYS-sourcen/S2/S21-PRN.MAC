                         C                  PAGE
'K M B G  Komplex-Routinen Teil II'	MACRO-80 3.44	09-Dec-81	PAGE	1-102


                         C      
                         C      ;****************************************************************
                         C      ;*               Zugriff auf  M R E S - Katalog                 *
                         C      ;****************************************************************
  DBE0    CD D764        C      K1.MRCAT:   CALL    K1.GNRE
  DBE3    CD D79C        C                  CALL    K1.GNRW
  DBE6    16 02          C                  LD      D,2                 ;auf Verzeichnisbloecke pos.
  DBE8    CD D80F        C                  CALL    K1.GNLPN
  DBEB    CD D8B7        C                  CALL    K1.GNRD             ;ersten zwei Verz.eintr. einlesen
  DBEE    CD D8B7        C                  CALL    K1.GNRD
  DBF1    3A B015        C                  LD      A,(KS.PUFFS+2)      ;naechste freie Datei
  DBF4    F5             C                  PUSH    AF
  DBF5    3A B017        C                  LD      A,(KS.PUFFS+4)      ;Anzahl Dateien
  DBF8    3D             C                  DEC     A
  DBF9    28 30          C                  JR      Z,K1.MRC5
  DBFB    47             C                  LD      B,A
  DBFC    C5             C      K1.MRC1:    PUSH    BC
  DBFD    DD E5          C                  PUSH    IX
  DBFF    CD D8B7        C                  CALL    K1.GNRD             ;einen       Verz.eintr. einlesen
  DC02    21 B014        C                  LD      HL,KS.PUFFS+1
  DC05    E5             C                  PUSH    HL
  DC06    DD E1          C                  POP     IX
  DC08    FD 7E 06       C                  LD      A,(IY+6)            ;Dateityp
  DC0B    DD BE 06       C                  CP      (IX+6)
  DC0E    20 16          C                  JR      NZ,K1.MRC3
  DC10    FD 7E 07       C                  LD      A,(IY+7)            ;Dateiattribut
  DC13    FE 20          C                  CP      ' '
  DC15    28 05          C                  JR      Z,K1.MRC2
  DC17    DD BE 07       C                  CP      (IX+7)
  DC1A    20 0A          C                  JR      NZ,K1.MRC3
  DC1C    FD E5          C      K1.MRC2:    PUSH    IY                  ;Dateiname
  DC1E    D1             C                  POP     DE
  DC1F    06 06          C                  LD      B,6
  DC21    CD C4D5        C                  CALL    S1.VERGL
  DC24    28 0B          C                  JR      Z,K1.MRC4
  DC26    DD E1          C      K1.MRC3:    POP     IX
  DC28    C1             C                  POP     BC
  DC29    10 D1          C                  DJNZ    K1.MRC1
  DC2B    CD D70D        C      K1.MRC5:    CALL    K1.GNSTS
  DC2E    D1             C                  POP     DE
  DC2F    37             C                  SCF                         ;CY=1  keine Datei vorhanden
  DC30    C9             C                  RET
  DC31    DD 56 17       C      K1.MRC4:    LD      D,(IX+17H)
  DC34    DD E1          C                  POP     IX
  DC36    D5             C                  PUSH    DE
  DC37    CD D70D        C                  CALL    K1.GNSTS
  DC3A    D1             C                  POP     DE
  DC3B    C1             C                  POP     BC
  DC3C    C1             C                  POP     BC
  DC3D    37             C                  SCF                         ;CY=0        Datei vorhanden
  DC3E    3F             C                  CCF
  DC3F    C9             C                  RET
