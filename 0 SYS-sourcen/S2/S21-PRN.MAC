                         C      
  D0B1    CD CD9C        C      MO.MZSW3:   CALL    MO.DSPOS
  D0B4    20 EB          C                  JR      NZ,MO.MZSW2
  D0B6    3A B191        C                  LD      A,(MS.SMAX)
  D0B9    3D             C                  DEC     A
  D0BA    32 B18D        C                  LD      (MS.SPOS),A
  D0BD    18 E2          C                  JR      MO.MZSW2
                         C      
  D0BF    CD CD8A        C      MO.MZSN:    CALL    MO.DZPOS
  D0C2    F5             C                  PUSH    AF
  D0C3    3A B197        C                  LD      A,(MS.DIRES)
  D0C6    CB 77          C                  BIT     6,A
  D0C8    28 15          C                  JR      Z,MO.MZSL
  D0CA    F1             C                  POP     AF
  D0CB    DC CD9C        C                  CALL    C,MO.DSPOS
  D0CE    C9             C                  RET
                         C      
  D0CF    CD CE5F        C      MO.MZSS:    CALL    MO.IZPOS
  D0D2    F5             C                  PUSH    AF
  D0D3    3A B197        C                  LD      A,(MS.DIRES)
  D0D6    CB 77          C                  BIT     6,A
  D0D8    28 05          C                  JR      Z,MO.MZSL
  D0DA    F1             C                  POP     AF
  D0DB    DC CE72        C                  CALL    C,MO.ISPOS
  D0DE    C9             C                  RET
                         C      
  D0DF    F1             C      MO.MZSL:    POP     AF
  D0E0    C9             C                  RET
                         C      
  D0E1                   C      MO.MZSNO    EQU     $
  D0E1                   C      MO.MZSNW    EQU     $
  D0E1                   C      MO.MZSSW    EQU     $
  D0E1    C9             C      MO.MZSSO:   RET
                         C      
