  CAD2    00             C+                 DB      0                  ;Fehlerbyte
  CAD3    50             C+                 DB      S0.V24                  ;Basisadresse
  CAD4    00             C+                 DB      0                  ;Subadresse
  CAD5    00             C+                 DB      0                 ;Kommando
  CAD6    0000           C+                 DW      0               ;Rueckehradresse
  CAD8    B7E0           C+                 DW      S0.PFFI               ;Pufferadresse
  CADA    04             C+                 DB      HIGH(400H)         ;Pufferlaenge
  CADB    00             C+                 DB      LOW(400H)
