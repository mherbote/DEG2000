'K M B G  Komplex-Routinen Teil II'	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                         C      
                         C      ;****************************************************************
                         C      ;*               M R E S  Ausgabedatei eroeffnen                *
                         C      ;****************************************************************
  DC82    CD DBE0        C      K1.MRAPO:   CALL    K1.MRCAT
  DC85    30 32          C                  JR      NC,K1.MRAP2
                         C      
  DC87    D5             C      K1.MRAP4:   PUSH    DE                  ;(D) ... zu positionierende Datei
  DC88    3E 02          C                  LD      A,2
  DC8A    82             C                  ADD     A,D
  DC8B    F5             C                  PUSH    AF
  DC8C    CD D79C        C                  CALL    K1.GNRW
  DC8F    D1             C                  POP     DE
  DC90    CD D80F        C                  CALL    K1.GNLPN
  DC93    CD D8B7        C                  CALL    K1.GNRD
  DC96    21 B014        C                  LD      HL,KS.PUFFS+1
  DC99    F1             C                  POP     AF
  DC9A    BE             C                  CP      (HL)
  DC9B    20 CB          C                  JR      NZ,K1.MRPO3         ;Datei nicht richtig pos.
  DC9D    FD 77 17       C                  LD      (IY+17H),A          ;Dateinummer
  DCA0    21 BBF0        C                  LD      HL,S0.PFFA          ;Ausgabe - Pointer setzen
  DCA3    22 B25B        C                  LD      (S2.POIA),HL
  DCA6    E5             C                  PUSH    HL
  DCA7    D1             C                  POP     DE
  DCA8    CD DBA4        C                  CALL    K1.FU
  DCAB    DD CB FF CE    C      K1.MRAP1:   SET     1,(IX-1)            ;OPEN bit          setzen
  DCAF    DD CB FF D6    C                  SET     2,(IX-1)            ;Richtungsbit      setzen
  DCB3    DD CB FF DE    C                  SET     3,(IX-1)            ;Verarbeitungsbit  setzen
  DCB7    AF             C                  XOR     A                   ;Z-FF = 1
  DCB8    C9             C                  RET
                         C      
  DCB9    ED 53 B26C     C      K1.MRAP2:   LD      (S2.RBBR),DE        ;Dateiname schon vergeben
  DCBD    21 E3E7        C                  LD      HL,LO.TXT11
  DCC0    11 DCCD        C                  LD      DE,K1.MRAP3
  DCC3    01 DCD5        C                  LD      BC,K1.MRAP5
  DCC6    ED 73 B24D     C                  LD      (TS.STACK),SP
  DCCA    C3 C516        C                  JP      S1.FEHRR
                         C      
  DCCD    3A B26D        C      K1.MRAP3:   LD      A,(S2.RBBR+1)       ;POS QUIT
  DCD0    57             C                  LD      D,A
  DCD1    E1             C                  POP     HL
  DCD2    E1             C                  POP     HL
  DCD3    18 B2          C                  JR      K1.MRAP4
                         C      
  DCD5    CD D79C        C      K1.MRAP5:   CALL    K1.GNRW             ;NEG QUIT
  DCD8    CD D781        C                  CALL    K1.GNRA
  DCDB    3E 03          C                  LD      A,3
  DCDD    B7             C                  OR      A                   ;Z-FF = 0
  DCDE    C9             C                  RET
