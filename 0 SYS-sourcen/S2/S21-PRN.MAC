'K M B G  Komplex-Routinen Teil II'	MACRO-80 3.44	09-Dec-81	PAGE	1-100


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G      K o m p l e x - R o u t i n e n   Teil II      *
                         C      ;****************************************************************
                         C      
                         C      ;****************************************************************
                         C      ;*               E i n g a b e - P u f f e r    fuellen         *
                         C      ;****************************************************************
  DB4C    21 B7E0        C      K1.EIN:     LD      HL,S0.PFFI          ;Eingabeparameter:
  DB4F    E5             C                  PUSH    HL                  ; BC  ...  zu belegender Puffer
  DB50    E5             C                  PUSH    HL
  DB51    22 B126        C                  LD      (K2.TXANF),HL
  DB54    22 B259        C                  LD      (S2.POIE),HL
  DB57    09             C                  ADD     HL,BC
  DB58    22 B128        C                  LD      (K2.TXEND),HL
  DB5B    E1             C                  POP     HL                  ;Puffer loeschen
  DB5C    D1             C                  POP     DE
  DB5D    CD DBA4        C                  CALL    K1.FU
  DB60    CD D8E1        C                  CALL    K1.GNRDR            ;Puffer fuellen
  DB63    CD D70D        C                  CALL    K1.GNSTS
  DB66    C9             C                  RET
                         C      
  DB67    CD D8B7        C      K1.EINP:    CALL    K1.GNRD             ;einen Block einlesen in den Eingabepuffer
  DB6A    21 B7E0        C      K1.EINP1:   LD      HL,S0.PFFI
  DB6D    E5             C                  PUSH    HL
  DB6E    E5             C                  PUSH    HL
  DB6F    D1             C                  POP     DE
  DB70    CD DBA4        C                  CALL    K1.FU
  DB73    CD D61E        C                  CALL    K1.LHLBC
  DB76    D1             C                  POP     DE
  DB77    ED 53 B259     C                  LD      (S2.POIE),DE
  DB7B    78             C                  LD      A,B
  DB7C    B1             C                  OR      C
  DB7D    28 02          C                  JR      Z,K1.EINP2
  DB7F    ED B0          C                  LDIR
  DB81    CD D70D        C      K1.EINP2:   CALL    K1.GNSTS
  DB84    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*               A u s g a b e - P u f f e r   leeren           *
                         C      ;****************************************************************
  DB85    2A B25B        C      K1.AUS:     LD      HL,(S2.POIA)
  DB88    22 B128        C                  LD      (K2.TXEND),HL
  DB8B    21 BBF0        C                  LD      HL,S0.PFFA
  DB8E    C5             C                  PUSH    BC
  DB8F    E5             C                  PUSH    HL
  DB90    E5             C                  PUSH    HL
  DB91    22 B126        C                  LD      (K2.TXANF),HL
  DB94    22 B25B        C                  LD      (S2.POIA),HL
  DB97    CD D996        C                  CALL    K1.GNWRT
  DB9A    CD D70D        C                  CALL    K1.GNSTS
  DB9D    E1             C                  POP     HL
  DB9E    D1             C                  POP     DE
  DB9F    CD DBA4        C                  CALL    K1.FU
  DBA2    C1             C                  POP     BC
  DBA3    C9             C                  RET
                         C      
  DBA4    13             C      K1.FU:      INC     DE
  DBA5    01 0400        C                  LD      BC,400H
  DBA8    36 0D          C                  LD      (HL),00DH
  DBAA    ED B0          C                  LDIR
  DBAC    C9             C                  RET
