                         C                  LD      (S2.SMHL),HL
                         C                  RET
                         C      S4.SC698:   POP     HL
                         C                  JP      0B403H
                         C      
                         C      S4.SVC60:   LD      HL,S4.UUM4
                         C                  LD      DE,S4.U1
                         C                  LD      BC,S4.UM7-S4.UUM4
                         C                  LDIR
                         C                  LD      A,(IX+0)            ;Parameter
                         C                  CP      1
                         C                  JR      Z,S4.SC601
                         C                  CP      2
                         C                  JR      Z,S4.SC602
                         C                  CP      3
                         C                  JR      Z,S4.SC603
                         C                  CP      4
                         C                  JR      Z,S4.SC604
                         C                  CP      5
                         C                  JR      Z,S4.SC605
                         C                  CP      6
                         C                  JR      Z,S4.SC606
                         C                  CP      7
                         C                  JR      Z,S4.SC607
                         C                  LD      A,3
                         C                  JR      S4.SC600
                         C      
                         C      S4.SC601:   CALL    S4.SC60             ;par=1   16K initialisieren
                         C                  CALL    S4.SC600
                         C                  LD      HL,S4.UM1-2
                         C      S4.SC699:   CALL    S4.LDIR
                         C                  JP      S4.U2
                         C      
                         C      S4.SC602:   CALL    S4.SC60             ;par=2   Schreib- = Lese- Pointer
                         C                  CALL    S4.SC600
                         C                  LD      HL,S4.UM8-2
                         C                  JR      S4.SC699
'BASIC- SVC - Routinen fuer Speichererweiterung'	MACRO-80 3.44	09-Dec-81	PAGE	1-175


                         C      
                         C      S4.SC603:   CALL    S4.SC60             ;par=3   setzen ersten freien Platz
                         C                  CALL    S4.SC600
                         C                  LD      HL,S4.UM9-2
                         C                  JR      S4.SC699
                         C      
                         C      S4.SC604:   CALL    S4.SC60             ;par=4   Schreib- pointer = 1. fr. Platz
                         C                  CALL    S4.SC600
                         C                  LD      HL,S4.UM10-2
                         C                  JR      S4.SC699
                         C      
                         C      S4.SC605:   CALL    S4.SC60             ;par=5   Lese-    pointer = Anfang
                         C                  CALL    S4.SC600
