                         C      ;****************************************************************
  CA21    CD CA27        C      S1.HCDB0:   CALL    S1.HCDB
  CA24    C3 C896        C                  JP      S1.POSDB            ;naechste Seite anzeigen
                         C      
  CA27    DD E5          C      S1.HCDB:    PUSH    IX
  CA29    FD E5          C                  PUSH    IY
  CA2B    3A B240        C                  LD      A,(TS.UMERK)
  CA2E    B7             C                  OR      A
  CA2F    28 07          C                  JR      Z,S1.HCDB1
  CA31    AF             C                  XOR     A
  CA32    32 B240        C                  LD      (TS.UMERK),A
  CA35    CD C844        C                  CALL    S1.ANZUM
  CA38    DD 2A B292     C      S1.HCDB1:   LD      IX,(S2.DMANF)       ;Anzeigeanfangsadresse
  CA3C    FD 2A B194     C                  LD      IY,(MS.BWSA)
  CA40    FD 23          C                  INC     IY
  CA42    06 10          C                  LD      B,16                ;Anzahl Zeilen
  CA44    C5             C      S1.HCDB2:   PUSH    BC                  ;Zyklus ueber 16 Zeilen
  CA45    06 3A          C                  LD      B,58                ;Zeilenanfadr und Hex-Darstellung
  CA47    FD 7E 00       C      S1.HCDB3:   LD      A,(IY)              ;uebernehmen
  CA4A    FD 23          C                  INC     IY
  CA4C    4F             C                  LD      C,A
  CA4D    CD F5AB        C                  CALL    SM.PRIO             ;ein Zeichen drucken
  CA50    10 F5          C                  DJNZ    S1.HCDB3               ;naechstes Zeichen
  CA52    06 10          C                  LD      B,16                ;ASCII-Darstellung uebernehmen
  CA54    DD 7E 00       C      S1.HCDB4:   LD      A,(IX)
  CA57    DD 23          C                  INC     IX
  CA59    FE 7F          C                  CP      7FH
  CA5B    30 04          C                  JR      NC,S1.HCDB5
  CA5D    FE 20          C                  CP      ' '
  CA5F    30 02          C                  JR      NC,S1.HCDB6
  CA61    3E 2E          C      S1.HCDB5:   LD      A,'.'
  CA63    4F             C      S1.HCDB6:   LD      C,A
  CA64    CD F5AB        C                  CALL    SM.PRIO             ;ASCII-Zeichen drucken
  CA67    10 EB          C                  DJNZ    S1.HCDB4            ;naechstes Zeichen
  CA69    0E 1E          C                  LD      C,1EH               ;Zeilenende ausgeben
  CA6B    CD F5AB        C                  CALL    SM.PRIO
  CA6E    06 16          C                  LD      B,22                ;IY korrigieren
  CA70    FD 23          C      S1.HCDB7:   INC     IY
  CA72    10 FC          C                  DJNZ    S1.HCDB7
  CA74    C1             C                  POP     BC
  CA75    10 CD          C                  DJNZ    S1.HCDB2               ;naechste Zeile
  CA77    0E 1E          C                  LD      C,1EH               ;zwei Leerzeilen ausgeben
  CA79    CD F5AB        C                  CALL    SM.PRIO
  CA7C    CD F5AB        C                  CALL    SM.PRIO
  CA7F    FD E1          C                  POP     IY
  CA81    DD E1          C                  POP     IX
  CA83    C9             C                  RET
                         C      
  CA84                   C      S1.OPEN     EQU     $
  CA84                   C      S1.CLOS     EQU     $
  CA84                   C      S1.LESV     EQU     $
  CA84                   C      S1.LESR     EQU     $
  CA84                   C      S1.SCHR     EQU     $
  CA84    C9             C                  RET
                         C      
                         C      ;           END
                         C      ;           PN      S310
                         C                  TITLE   'Generierprogramm fuer die E-/A-Tabelle'
                         C                  PAGE
'Generierprogramm fuer die E-/A-Tabelle'	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                         C      
                         C      ;****************************************************************
                         C      ;*               Generierprogramm fuer die E-/A-Tabelle         *
                         C      ;*  Version      -----------------------------------------------*
                         C      ;*               Programmierer: M. Herbote --- K EAW  ZFT (WFT) *
                         C      ;*  V 2 . 1      -----------------------------------------------*
                         C      ;*               Stand        : 27.Januar 1984                  *
                         C      ;****************************************************************
                         C      
                         C      
                         C      ;****************************************************************
                         C      ;*               Macro zu Erzeugung des Steuervektors nach      *
                         C      ;*               ROBOTRON - MOS                                 *
                         C      ;****************************************************************
                         C      S3.RMOS     MACRO   SB,FB,BA,SA,CMD,ENTRY,PUADR,PULAE,INF1,INF2,INF3
                         C                  DB      SB                  ;Statusbyte
                         C                  DB      FB                  ;Fehlerbyte
                         C                  DB      BA                  ;Basisadresse
                         C                  DB      SA                  ;Subadresse
                         C                  DB      CMD                 ;Kommando
                         C                  DW      ENTRY               ;Rueckehradresse
                         C                  DW      PUADR               ;Pufferadresse
                         C                  DB      HIGH(PULAE)         ;Pufferlaenge
                         C                  DB      LOW(PULAE)
                         C                  DB      INF1                ;Informationsbyte 1
                         C                  DB      INF2                ;Informationsbyte 2
                         C                  DB      INF3                ;Informationsbyte 3
                         C                  ENDM
                         C      
                         C      ;****************************************************************
                         C      ;*               allgemeine Speicherplaetze der statischen      *
                         C      ;*               E-/A-Tabelle                                   *
                         C      ;****************************************************************
  CA85                   C      S3.SEAT     EQU     $
  CA85    AA             C      S3.MASK1:   DB      0AAH                ;Systemmaske 1
  CA86    55             C      S3.MASK2:   DB      055H                ;Systemmaske 2
  CA87    FF             C      S3.MASK3:   DB      0FFH                ;Systemmaske 3
  CA88    00             C      S3.MASK4:   DB      000H                ;Systemmaske 4
                         C      
  CA89    3232           C      S3.DATUM:   DW      S0.D1               ;Stand des Systems
  CA8B    3330           C                  DW      S0.D2
  CA8D    3538           C                  DW      S0.D3
                         C      
  CA8F    BBF0           C      S3.PUFA:    DW      S0.PFFA             ;Adresse des Ausgabepuffers
  CA91    B7E0           C      S3.PUFI:    DW      S0.PFFI             ;Adresse des Eingabepuffers
  CA93    0400           C      S3.LANG:    DW      1024                ;Pufferlaenge
                         C      
  CA95    00             C                  DB      0
  CA96    00             C                  DB      0
  CA97    00             C      S3.STI:     DB      0
                         C      
                         C                  TITLE   'Kanal - Tabellen'
                         C                  PAGE
'Kanal - Tabellen'	MACRO-80 3.44	09-Dec-81	PAGE	1-42


                         C      
                         C      ;****************************************************************
                         C      ;*               K a s s e t t e 1                              *
                         C      ;****************************************************************
  CA98    1B             C      S3.KS1:     DB      S3.KS2-S3.KS1       ;Laengenbyte
  CA99    C0             C                  DB      11000000B           ;Typ - Kennsatz ja , SYS-Geraet
  CA9A    C1             C                  DB      11000001B           ;Geraetebyte
                         C                  S3.RMOS 0,0,S0.AKB,1,0,0,S0.PFFI,100H,0,0,0
  CA9B    00             C+                 DB      0                  ;Statusbyte
  CA9C    00             C+                 DB      0                  ;Fehlerbyte
  CA9D    30             C+                 DB      S0.AKB                  ;Basisadresse
  CA9E    01             C+                 DB      1                  ;Subadresse
