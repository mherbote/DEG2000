                         C                  LD      DE,S4.U2
                         C                  LDIR
                         C                  RET
                         C      
                         C                  PAGE
                         C      ;****************************************************************
                         C      ;*               Unterprogramme, die umgespeichert werden       *
                         C      ;****************************************************************
                         C      S4.UP:      XOR     A                   ;nur gemischte aktiv lassen
                         C                  OUT     (C),S4.SBST+1
                         C                  LD      A,10111101B
                         C                  OUT     (C),S4.SBST+0
                         C      
                         C                  LD      HL,04000H           ;Zusatzspeicher initialisieren
                         C                  LD      B,3
                         C                  LD      D,01000001B
                         C      S4.M2:      PUSH    BC
                         C                  LD      IX,02B00H
                         C                  LD      B,8
                         C      S4.UP1:     LD      A,D
                         C                  AND     00011100B
                         C                  RRCA
                         C                  RRCA
                         C                  INC     A
                         C                  PUSH    BC
                         C                  LD      B,A
                         C                  LD      A,10000000B
                         C                  RLCA
                         C                  DJNZ    $-1
                         C                  POP     BC
