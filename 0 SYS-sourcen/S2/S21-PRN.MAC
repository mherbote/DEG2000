                         C                  JR      S4.SC699
                         C      
                         C      S4.SC606:   CALL    S4.SC60             ;par=6   Schreib- pointer = Anfang
                         C                  CALL    S4.SC600
                         C                  LD      HL,S4.UM12-2
                         C                  JR      S4.SC699
                         C      S4.SC607:   CALL    S4.SC60             ;par=7   Lese-/Schreib- pointer lesen
                         C                  CALL    S4.SC600
