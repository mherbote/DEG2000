  DBAD    D5             C      K1.LESV:    PUSH    DE
  DBAE    E5             C                  PUSH    HL
  DBAF    2A B259        C                  LD      HL,(S2.POIE)
  DBB2    7E             C                  LD      A,(HL)
  DBB3    23             C                  INC     HL
  DBB4    22 B259        C                  LD      (S2.POIE),HL
  DBB7    11 BBE0        C                  LD      DE,S0.PFFI+400H
  DBBA    B7             C                  OR      A
  DBBB    ED 52          C                  SBC     HL,DE
  DBBD    C5             C                  PUSH    BC
  DBBE    F5             C                  PUSH    AF
  DBBF    01 0400        C                  LD      BC,400H
  DBC2    CC DB4C        C                  CALL    Z,K1.EIN
  DBC5    F1             C                  POP     AF
  DBC6    C1             C                  POP     BC
  DBC7    E1             C                  POP     HL
  DBC8    D1             C                  POP     DE
  DBC9    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*               Zeichen im Register A ausgeben                 *
                         C      ;****************************************************************
  DBCA    D5             C      K1.SCHR:    PUSH    DE
  DBCB    E5             C                  PUSH    HL
  DBCC    2A B25B        C                  LD      HL,(S2.POIA)
  DBCF    77             C                  LD      (HL),A
  DBD0    23             C                  INC     HL
  DBD1    22 B25B        C                  LD      (S2.POIA),HL
  DBD4    11 BFF0        C                  LD      DE,S0.PFFA+400H
  DBD7    B7             C                  OR      A
  DBD8    ED 52          C                  SBC     HL,DE
  DBDA    CC DB85        C                  CALL    Z,K1.AUS
  DBDD    E1             C                  POP     HL
  DBDE    D1             C                  POP     DE
  DBDF    C9             C                  RET
