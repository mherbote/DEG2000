                         C      
                         C      ;****************************************************************
                         C      ;*               MZLO , MZLW , MZLN , MZLS                      *
                         C      ;****************************************************************
  D0E2    CD CE56        C      MO.MZLO:    CALL    MO.ISPOL
  D0E5    F5             C                  PUSH    AF
  D0E6    3A B196        C                  LD      A,(MS.DIREL)
  D0E9    CB 77          C                  BIT     6,A
  D0EB    28 F2          C                  JR      Z,MO.MZSL
  D0ED    F1             C                  POP     AF
  D0EE    DC CE4D        C                  CALL    C,MO.IZPOL
  D0F1    C9             C                  RET
                         C      
  D0F2    CD CD7D        C      MO.MZLW:    CALL    MO.DSPOL
