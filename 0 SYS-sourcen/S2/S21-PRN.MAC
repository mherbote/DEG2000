                         C                  LD      A,D
                         C                  CALL    S1.BHKON
                         C                  LD      A,E
                         C                  CALL    S1.BHKON
                         C                  JP      0B403H
                         C      
                         C                  PAGE
                         C      ;****************************************************************
                         C      ;*               Ueberpruefen der Angaben   blknr  und stufe    *
                         C      ;****************************************************************
                         C      S4.SC63:    DEC     IX
                         C                  DEC     IX
                         C      S4.SC60:    LD      A,(IX+2)            ;blknr
                         C                  LD      E,30H
                         C      S4.SC64:    PUSH    AF
                         C                  EX      AF,AF'              ;'
                         C                  POP     AF
                         C                  AND     0F0H
                         C                  XOR     E
                         C                  JR      NZ,S4.SC61
                         C                  RRC     E
                         C                  RRC     E
                         C                  RRC     E
                         C                  RRC     E
