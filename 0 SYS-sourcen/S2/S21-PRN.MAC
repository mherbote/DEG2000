                         C      
                         C      ;****************************************************************
                         C      ;*               Vergleich der Zeichenketten                    *
                         C      ;****************************************************************
  C4D5    D5             C      S1.VERGL:   PUSH    DE                  ;DE = gegebene  ZK
  C4D6    1A             C      S1.VERG1:   LD      A,(DE)              ;B  = Laenge
  C4D7    BE             C                  CP      (HL)                ;HL = vermutete ZK
  C4D8    20 04          C                  JR      NZ,S1.VERG2
  C4DA    13             C                  INC     DE
  C4DB    23             C                  INC     HL
  C4DC    10 F8          C                  DJNZ    S1.VERG1
  C4DE    D1             C      S1.VERG2:   POP     DE                  ;Z  = 1 : Kette gefunden B = 0
  C4DF    C9             C                  RET                         ;HL = Kette + 1    DE := DE
                         C      ;****************************************************************
                         C      ;*               Zeichen suchen                                 *
                         C      ;****************************************************************
  C4E0    3A B193        C      S1.SZEI:    LD      A,(MS.SPANZ)
  C4E3    47             C      S1.SZEI1:   LD      B,A
  C4E4    05             C                  DEC     B
  C4E5    3E 28          C                  LD      A,40
  C4E7    32 B198        C                  LD      (MS.CMD),A
  C4EA    CD CB35        C      S1.SZEI2:   CALL    MO.MONI
  C4ED    3A B199        C                  LD      A,(MS.TK)
  C4F0    FE 20          C                  CP      ' '
  C4F2    C0             C                  RET     NZ
  C4F3    10 F5          C                  DJNZ    S1.SZEI2
  C4F5    C9             C                  RET                         ;Z = 0 falls kein Zeichen
                         C      ;****************************************************************
                         C      ;*               Spalten- bzw. Zeilenanzahl berechnen           *
                         C      ;****************************************************************
  C4F6    E5             C      S1.SZAHL:   PUSH    HL
  C4F7    2A B18F        C                  LD      HL,(MS.SMIN)
  C4FA    3A B191        C      S1.SZA1:    LD      A,(MS.SMAX)
  C4FD    18 07          C                  JR      S1.ZAHL
  C4FF    E5             C      S1.ZZAHL:   PUSH    HL
  C500    2A B18E        C                  LD      HL,(MS.ZMIN)
  C503    3A B190        C      S1.ZZA1:    LD      A,(MS.ZMAX)
  C506    95             C      S1.ZAHL:    SUB     L
  C507    3C             C                  INC     A
  C508    E1             C                  POP     HL
  C509    C9             C                  RET                         ;A = Zeilen- bzw. Spaltenanzahl
                         C      ;
  C50A    FB             C      S1.IO:      EI
  C50B    ED 4D          C                  RETI
                         C      
                         C      ;****************************************************************
                         C      ;*              Anzeige eines Fehlertextes bei S0.FKADR und     *
                         C      ;*              Sprung zur Systemgrundanzeige                   *
                         C      ;*              HL  Adresse des Fehlertextes (38 Byte)          *
                         C      ;****************************************************************
  C50D    CD C530        C      S1.FEH:     CALL    S1.FEH1
  C510    C3 C0CE        C                  JP      S1.SYSTB
                         C      
                         C                  PAGE
'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-26


                         C      
                         C      ;****************************************************************
                         C      ;*               Anzeige eines Fehlertextes bei S0.FKADR und    *
                         C      ;*          bei  FEHRR und POS/NEG QUIT       Ruecksprung       *
                         C      ;*          bei  FEHR  und NEG QUIT           Sprung zum System *
                         C      ;*          bei  FEHR  und POS QUIT           Ruecksprung       *
                         C      ;*               HL  Adresse des Fehlertextes (38 Byte)         *
                         C      ;*               DE  Tastenroutinenadresse  POS QUIT            *
                         C      ;*               BC  Tastenroutinenadresse  NEG QUIT  nur FEHRR *
                         C      ;****************************************************************
  C513    01 C0CE        C      S1.FEHR:    LD      BC,S1.SYSTB
  C516    C5             C      S1.FEHRR:   PUSH    BC
  C517    D5             C                  PUSH    DE
  C518    CD C530        C                  CALL    S1.FEH1
  C51B    CD D42A        C                  CALL    TA.LOE
  C51E    E1             C                  POP     HL
  C51F    22 B223        C                  LD      (TS.TAB4),HL
  C522    E1             C                  POP     HL
  C523    22 B21B        C                  LD      (TS.TAB3+4),HL
  C526    3E 80          C                  LD      A,10000000B
  C528    32 B23F        C                  LD      (TS.SPMER),A
  C52B    21 C1DE        C                  LD      HL,S1.TFE
  C52E    E5             C                  PUSH    HL
  C52F    C9             C                  RET
                         C      
  C530    E5             C      S1.FEH1:    PUSH    HL
  C531    AF             C                  XOR     A
  C532    32 B247        C                  LD      (TS.MIO),A
  C535    CD D68C        C                  CALL    K1.MVS
  C538    E1             C                  POP     HL
  C539    ED 5B B132     C                  LD      DE,(K2.FKADR)
  C53D    15             C                  DEC     D
  C53E    1D             C                  DEC     E
  C53F    ED 53 B18C     C                  LD      (MS.ZPOS),DE
  C543    3E 18          C                  LD      A,24
  C545    32 B198        C                  LD      (MS.CMD),A
  C548    06 26          C                  LD      B,38
  C54A    CD CB35        C                  CALL    MO.MONI
  C54D    CD D6A3        C                  CALL    K1.MVL
  C550    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*               Unterprogramm bestimmt Parameter nach          *
                         C      ;*               Befehlsname                                    *
                         C      ;*               D             = Parameter binaer               *
                         C      ;*               DM1 ... DM1+8 = Parameter hexadezimal          *
                         C      ;****************************************************************
  C551    26 07          C      S1.INPTR:   LD      H,7
  C553    2E 0A          C                  LD      L,S0.SYSZ-1
  C555    22 B18A        C                  LD      (MS.ZPOL),HL
  C558    06 09          C                  LD      B,9
  C55A    21 B29A        C                  LD      HL,S2.DM1
  C55D    3E 2C          C                  LD      A,44
  C55F    32 B198        C                  LD      (MS.CMD),A
  C562    CD CB35        C                  CALL    MO.MONI
  C565    21 B29A        C                  LD      HL,S2.DM1
  C568    CD C5EB        C                  CALL    S1.HBKON
  C56B    57             C                  LD      D,A
  C56C    C9             C                  RET
                         C      
                         C                  PAGE
'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-27


                         C      
                         C      ;****************************************************************
                         C      ;*               Konvertierung Binaerwert in  HL                *
                         C      ;*               ==> ISO - Dezimalwert ab  (DE)                 *
                         C      ;****************************************************************
  C56D    01 2710        C      S1.HDI:     LD      BC,10000
  C570    CD C58B        C                  CALL    S1.HDI1
  C573    01 03E8        C                  LD      BC,1000
  C576    CD C58B        C                  CALL    S1.HDI1
  C579    01 0064        C                  LD      BC,100
  C57C    CD C58B        C                  CALL    S1.HDI1
  C57F    01 000A        C                  LD      BC,10
  C582    CD C58B        C                  CALL    S1.HDI1
  C585    7D             C                  LD      A,L
  C586    F6 30          C                  OR      30H
  C588    12             C                  LD      (DE),A
  C589    13             C                  INC     DE
  C58A    C9             C                  RET
  C58B    CD C5A8        C      S1.HDI1:    CALL    S1.DIV
  C58E    F6 30          C                  OR      30H
  C590    FE 30          C                  CP      30H
  C592    20 0D          C                  JR      NZ,S1.HDI3
  C594    47             C                  LD      B,A
  C595    1B             C                  DEC     DE
  C596    1A             C                  LD      A,(DE)
  C597    13             C                  INC     DE
  C598    FE 3A          C                  CP      ':'
  C59A    30 08          C                  JR      NC,S1.HDI2
  C59C    FE 30          C                  CP      '0'
  C59E    38 04          C                  JR      C,S1.HDI2
  C5A0    78             C                  LD      A,B
  C5A1    12             C      S1.HDI3:    LD      (DE),A
  C5A2    13             C                  INC     DE
  C5A3    C9             C                  RET
  C5A4    3E 20          C      S1.HDI2:    LD      A,' '
  C5A6    18 F9          C                  JR      S1.HDI3
                         C      ;****************************************************************
                         C      ;*               Division HL/BC                                 *
                         C      ;****************************************************************
  C5A8    AF             C      S1.DIV:     XOR     A
  C5A9    ED 42          C      S1.DIV1:    SBC     HL,BC
  C5AB    3C             C                  INC     A
  C5AC    30 FB          C                  JR      NC,S1.DIV1
  C5AE    09             C                  ADD     HL,BC
  C5AF    3D             C                  DEC     A                   ;A:=HL/BC  HL:=Rest
  C5B0    C9             C                  RET
                         C      
                         C                  PAGE
'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                         C      
                         C      ;****************************************************************
                         C      ;*               Konvertierung ISO - Dezimalwert ab  (DE)       *
                         C      ;*               ==>  Binaerwert in  HL                         *
                         C      ;*               Zahl < 10000                                   *
                         C      ;****************************************************************
  C5B1    0E 06          C      S1.IDH:     LD      C,6
  C5B3    CD C5D3        C                  CALL    S1.IDH1
  C5B6    D8             C                  RET     C                   ;CY = 1 Fehler: keine Zahl ab (DE)
  C5B7    26 00          C                  LD      H,0
  C5B9    6F             C      S1.IDH2:    LD      L,A
  C5BA    13             C                  INC     DE
  C5BB    0D             C                  DEC     C
  C5BC    C8             C                  RET     Z                   ;Z  = 1 Fehler: Stellenzahl > 5
  C5BD    CD C5D3        C      S1.IDH3:    CALL    S1.IDH1
  C5C0    38 0D          C                  JR      C,S1.IDHE           ;CY = 1 wenn Zahl zu Ende
  C5C2    CD C5E2        C                  CALL    S1.MUL10
  C5C5    38 06          C                  JR      C,S1.IDHF           ;CY = 1 wenn Zahl > FFFFH
  C5C7    85             C                  ADD     A,L
  C5C8    30 EF          C                  JR      NC,S1.IDH2
  C5CA    24             C                  INC     H
  C5CB    18 EC          C                  JR      S1.IDH2
  C5CD    AF             C      S1.IDHF:    XOR     A
  C5CE    C9             C                  RET                         ;Z  = 1 Fehler: Zahl > FFFFH
  C5CF    3E 01          C      S1.IDHE:    LD      A,1
  C5D1    B7             C                  OR      A
  C5D2    C9             C                  RET                         ;Z  = CY = 0  kein Fehler
  C5D3    1A             C      S1.IDH1:    LD      A,(DE)
  C5D4    CD C5DB        C                  CALL    S1.SIEBD
  C5D7    D8             C                  RET     C
  C5D8    E6 0F          C                  AND     0FH
  C5DA    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*               Test: ISO - Zeichen = Ziffer ?                 *
                         C      ;****************************************************************
  C5DB    FE 30          C      S1.SIEBD:   CP      '0'
  C5DD    D8             C                  RET     C
  C5DE    FE 3A          C                  CP      ':'
  C5E0    3F             C                  CCF
  C5E1    C9             C                  RET                         ;CY = 1 wenn A keine Dez.Ziffer
                         C      ;****************************************************************
                         C      ;*               Multiplikation  HL * 10                        *
                         C      ;****************************************************************
  C5E2    D5             C      S1.MUL10:   PUSH    DE
  C5E3    E5             C                  PUSH    HL
  C5E4    D1             C                  POP     DE
  C5E5    29             C                  ADD     HL,HL
  C5E6    29             C                  ADD     HL,HL
  C5E7    19             C                  ADD     HL,DE
  C5E8    29             C                  ADD     HL,HL
  C5E9    D1             C                  POP     DE
  C5EA    C9             C                  RET                         ;HL := HL * 10
                         C      
                         C                  PAGE
'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                         C      
                         C      ;****************************************************************
                         C      ;*               Hexadezimal - Binaer - Konvertierung           *
                         C      ;*               HL = Anfangsadresse des Hexazeichens           *
                         C      ;*               A  = Binaerzeichen                             *
                         C      ;****************************************************************
  C5EB    C5             C      S1.HBKON:   PUSH    BC
  C5EC    06 00          C                  LD      B,0
  C5EE    7E             C                  LD      A,(HL)              ;1.Zeichen
  C5EF    23             C                  INC     HL
  C5F0    CD C607        C                  CALL    S1.KON1
  C5F3    38 10          C                  JR      C,S1.HBK1
  C5F5    CB 10          C                  RL      B
  C5F7    CB 10          C                  RL      B
  C5F9    CB 10          C                  RL      B
  C5FB    CB 10          C                  RL      B
  C5FD    7E             C                  LD      A,(HL)              ;2.Zeichen
  C5FE    23             C                  INC     HL
  C5FF    CD C607        C                  CALL    S1.KON1
  C602    38 01          C                  JR      C,S1.HBK1
  C604    78             C                  LD      A,B
  C605    C1             C      S1.HBK1:    POP     BC
  C606    C9             C                  RET
  C607    D6 30          C      S1.KON1:    SUB     30H                 ;Test , ob Hexazeichen
  C609    D8             C                  RET     C                   ;kein Hexzeichen
  C60A    FE 0A          C                  CP      10
  C60C    38 0B          C                  JR      C,S1.KON3           ;Hexzeichen  0 ... 9
  C60E    FE 17          C                  CP      17H
  C610    3F             C                  CCF
  C611    D8             C                  RET     C                   ;kein Hexzeichen
  C612    FE 11          C                  CP      11H
  C614    D8             C                  RET     C                   ;kein Hexzeichen
  C615    E6 0F          C                  AND     0FH                 ;Hexzeichen  A ... F
  C617    C6 09          C                  ADD     A,9
  C619    B0             C      S1.KON3:    OR      B
  C61A    47             C                  LD      B,A
  C61B    37             C                  SCF                         ;CY = 0  Zeichen ist ein Hexazeichen
  C61C    3F             C                  CCF
  C61D    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*               Konvertiere 8 Bit von Register A in ASCII      *
                         C      ;*               Hexadezimal auf  (HL)                          *
                         C      ;****************************************************************
  C61E    F5             C      S1.BHKON:   PUSH    AF                  ;rette A
  C61F    1F             C                  RRA
  C620    1F             C                  RRA
  C621    1F             C                  RRA
  C622    1F             C                  RRA
  C623    CD C62D        C                  CALL    S1.KON2             ;konvertiere high order 4 Bits
  C626    23             C                  INC     HL
  C627    F1             C                  POP     AF
  C628    CD C62D        C                  CALL    S1.KON2             ;konvertiere  low order 4 Bits
  C62B    23             C                  INC     HL
  C62C    C9             C                  RET
  C62D    E6 0F          C      S1.KON2:    AND     0FH                 ;Maske fuer   low order 4 Bits
  C62F    FE 0A          C                  CP      10
  C631    38 02          C                  JR      C,S1.HB10
  C633    C6 07          C                  ADD     A,7
  C635    C6 30          C      S1.HB10:    ADD     A,30H
  C637    77             C                  LD      (HL),A
  C638    C9             C                  RET
                         C      
                         C                  PAGE
'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                         C      
                         C      ;****************************************************************
                         C      ;*               Zeichen suchen                                 *
                         C      ;*               (DE),(D+1),... = Suchbereich                   *
                         C      ;*               B              = Laenge                        *
                         C      ;****************************************************************
  C639    EB             C      S1.SUZEI:   EX      DE,HL
  C63A    CD C4EA        C                  CALL    S1.SZEI2
  C63D    EB             C                  EX      DE,HL               ;A  = Zeichen , DE = Adresse
  C63E    C9             C                  RET                         ;Z  = 1 wenn kein Zeichen
                         C      ;****************************************************************
                         C      ;*               Zahl suchen                                    *
                         C      ;*               (DE),(DE+1),... = Suchbereich                  *
                         C      ;*               B               = Laenge                       *
                         C      ;****************************************************************
  C63F    CD C639        C      S1.SUZA:    CALL    S1.SUZEI
  C642    C8             C                  RET     Z                   ;Z  = 1 : kein Zeichen
  C643    CD C5B1        C      S1.SUZA1:   CALL    S1.IDH
  C646    D8             C                  RET     C                   ;Z  = 0 CY = 1 : falsche Zahl
  C647    C0             C                  RET     NZ                  ;Z  = 0 CY = 0 : HL = Zahl
  C648    3E 01          C      S1.SUZA3:   LD      A,1
  C64A    B7             C                  OR      A
  C64B    37             C                  SCF
  C64C    C9             C                  RET                         ;Z  = 0 CY = 1 : falsche Zahl
                         C      ;****************************************************************
                         C      ;*               Zahl lesen und pruefen: A' < Zahl =< (IX+0)    *
                         C      ;*               falls Bedingung erfuellt: L  = Zahl Z = CY = 0 *
                         C      ;*               falls keine Zeichen     : Z  = 1               *
                         C      ;*               falls falsche Zahl      : CY = 1               *
                         C      ;****************************************************************
  C64D    CD C63F        C      S1.LT1Z:    CALL    S1.SUZA
  C650    D8             C                  RET     C
  C651    C8             C                  RET     Z
  C652    7C             C                  LD      A,H
  C653    B7             C                  OR      A
  C654    20 F2          C                  JR      NZ,S1.SUZA3
  C656    DD 7E 00       C                  LD      A,(IX+0)
  C659    BD             C                  CP      L
  C65A    D8             C                  RET     C
  C65B    08             C                  EX      AF,AF'              ;'
  C65C    BD             C                  CP      L
  C65D    3F             C                  CCF
  C65E    C9             C                  RET
  C65F    DD E9          C      S1.MX:      JP      (IX)
  C661    E5             C      S1.RNR:     PUSH    HL                  ;Rechtsrotieren vor   (HL)
  C662    D1             C                  POP     DE                  ;BC = Anzahl
  C663    1A             C                  LD      A,(DE)
  C664    2B             C                  DEC     HL
  C665    ED B8          C                  LDDR
  C667    12             C                  LD      (DE),A
  C668    C9             C                  RET
  C669    E5             C      S1.RNL:     PUSH    HL                  ;Linksrotieren hinter (HL)
  C66A    D1             C                  POP     DE                  ;BC = Anzahl
  C66B    1A             C                  LD      A,(DE)
  C66C    23             C                  INC     HL
  C66D    ED B0          C                  LDIR
  C66F    12             C                  LD      (DE),A
  C670    C9             C                  RET
                         C      
                         C                  PAGE
'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                         C      
                         C      ;****************************************************************
                         C      ;*               C R C - Kontrollsumme   berechnen              *
                         C      ;*               -----------------------------------------------*
                         C      ;*               Eingabe:  HL  ... Anfang des Bereiches         *
                         C      ;*                         BC  ... Laenge des Bereiches         *
                         C      ;*               Ausgabe:  DE  ... CRC-Summe ueber den Bereich  *
                         C      ;****************************************************************
  C671    11 FFFF        C      S1.CHK:     LD      DE,0FFFFH
  C674    7E             C      S1.CHK1:    LD      A,(HL)
  C675    AA             C                  XOR     D
  C676    57             C                  LD      D,A
  C677    0F             C                  RRCA
  C678    0F             C                  RRCA
  C679    0F             C                  RRCA
  C67A    0F             C                  RRCA
  C67B    E6 0F          C                  AND     00FH
  C67D    AA             C                  XOR     D
  C67E    57             C                  LD      D,A
  C67F    0F             C                  RRCA
  C680    0F             C                  RRCA
  C681    0F             C                  RRCA
  C682    F5             C                  PUSH    AF
  C683    E6 1F          C                  AND     01FH
  C685    AB             C                  XOR     E
  C686    5F             C                  LD      E,A
  C687    F1             C                  POP     AF
  C688    F5             C                  PUSH    AF
  C689    0F             C                  RRCA
  C68A    E6 F0          C                  AND     0F0H
  C68C    AB             C                  XOR     E
  C68D    5F             C                  LD      E,A
  C68E    F1             C                  POP     AF
  C68F    E6 E0          C                  AND     0E0H
  C691    AA             C                  XOR     D
  C692    53             C                  LD      D,E
  C693    5F             C                  LD      E,A
  C694    23             C                  INC     HL
  C695    0B             C                  DEC     BC
  C696    78             C                  LD      A,B
  C697    B1             C                  OR      C
  C698    20 DA          C                  JR      NZ,S1.CHK1
  C69A    C9             C                  RET
                         C      
                         C                  PAGE
'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                         C      
                         C      ;****************************************************************
                         C      ;*               Systemzustaende anzeigen                       *
                         C      ;****************************************************************
  C69B    CD CF67        C      S1.STAT:    CALL    MO.BWSE
  C69E    23             C                  INC     HL
  C69F    CD CF7A        C                  CALL    MO.DESZ
  C6A2    B7             C                  OR      A
  C6A3    ED 52          C                  SBC     HL,DE
  C6A5    ED 52          C                  SBC     HL,DE
  C6A7    E5             C                  PUSH    HL
  C6A8    EB             C                  EX      DE,HL
  C6A9    21 C6FE        C                  LD      HL,S1.STT1
  C6AC    01 001B        C                  LD      BC,27
  C6AF    ED B0          C                  LDIR
  C6B1    E1             C                  POP     HL
  C6B2    CD CF7A        C                  CALL    MO.DESZ
  C6B5    19             C                  ADD     HL,DE
  C6B6    EB             C                  EX      DE,HL
  C6B7    3A B264        C                  LD      A,(S2.IOC)
  C6BA    B7             C                  OR      A
  C6BB    28 05          C                  JR      Z,S1.STTT1
  C6BD    21 C719        C                  LD      HL,S1.STT2
  C6C0    18 03          C                  JR      S1.STTT2
  C6C2    21 C720        C      S1.STTT1:   LD      HL,S1.STT3
  C6C5    01 0007        C      S1.STTT2:   LD      BC,7
  C6C8    ED B0          C                  LDIR
  C6CA    3A B241        C                  LD      A,(TS.KGMER)
  C6CD    B7             C                  OR      A
  C6CE    28 05          C                  JR      Z,S1.STTT3
  C6D0    21 C727        C                  LD      HL,S1.STT4
  C6D3    18 03          C                  JR      S1.STTT4
  C6D5    21 C72E        C      S1.STTT3:   LD      HL,S1.STT5
  C6D8    01 0007        C      S1.STTT4:   LD      BC,7
  C6DB    ED B0          C                  LDIR
  C6DD    3A B240        C                  LD      A,(TS.UMERK)
  C6E0    B7             C                  OR      A
  C6E1    28 05          C                  JR      Z,S1.STTT5
  C6E3    21 C719        C                  LD      HL,S1.STT2
  C6E6    18 03          C                  JR      S1.STTT6
  C6E8    21 C720        C      S1.STTT5:   LD      HL,S1.STT3
  C6EB    01 0007        C      S1.STTT6:   LD      BC,7
  C6EE    ED B0          C                  LDIR
  C6F0    21 0003        C                  LD      HL,3
  C6F3    19             C                  ADD     HL,DE
  C6F4    3A B23E        C                  LD      A,(TS.EMERK)
  C6F7    C6 30          C                  ADD     A,30H
  C6F9    77             C                  LD      (HL),A
  C6FA    CD CB64        C                  CALL    MO.BWSUS
  C6FD    C9             C                  RET
                         C      
  C6FE    49 4F 43 5F    C      S1.STT1:    DB      'IOC___TAS___INS MOD___EBENE'
  C702    5F 5F 54 41    C      
  C706    53 5F 5F 5F    C      
  C70A    49 4E 53 20    C      
  C70E    4D 4F 44 5F    C      
  C712    5F 5F 45 42    C      
  C716    45 4E 45       C      
  C719    45 49 4E 20    C      S1.STT2:    DB      'EIN    '
  C71D    20 20 20       C      
  C720    41 55 53 20    C      S1.STT3:    DB      'AUS    '
  C724    20 20 20       C      
  C727    53 20 20 20    C      S1.STT4:    DB      'S      '
  C72B    20 20 20       C      
  C72E    50 20 20 20    C      S1.STT5:    DB      'P      '
  C732    20 20 20       C      
                         C      
                         C                  TITLE   'System-Kommandos'
                         C                  PAGE
'System-Kommandos'	MACRO-80 3.44	09-Dec-81	PAGE	1-33


                         C      
                         C      ;****************************************************************
                         C      ;*               Kommandos  D A T E  ,  S T A S  ,  P T A S  ,  *
                         C      ;*                          D I N I  ,  I O C E  ,  I O C A     *
                         C      ;****************************************************************
  C735    C735           C                  DW      $
  C737    44 41 54 45    C                  DB      'DATE'
  C73B    26 07          C                  LD      H,7                 ;ZPOL=SYSZ , SPOL=7
  C73D    2E 0A          C                  LD      L,S0.SYSZ-1
  C73F    22 B18A        C                  LD      (MS.ZPOL),HL
  C742    21 0004        C                  LD      HL,S3.DATUM-S3.SEAT
  C745    11 A800        C                  LD      DE,S0.DEAT
  C748    19             C                  ADD     HL,DE
  C749    06 06          C                  LD      B,6
  C74B    3E 2C          C                  LD      A,44
  C74D    32 B198        C                  LD      (MS.CMD),A
  C750    CD CB35        C                  CALL    MO.MONI
  C753    2A B194        C                  LD      HL,(MS.BWSA)        ;Testen, ob Datum vorhanden
  C756    11 0327        C                  LD      DE,10*80 + 7
  C759    19             C                  ADD     HL,DE
  C75A    7E             C                  LD      A,(HL)        
  C75B    FE 20          C                  CP      ' '
  C75D    20 10          C                  JR      NZ,S1.DATE
                         C                                              ;Kein Datum, dann akt. Datum holen
  C75F    C5             C                  PUSH    BC
  C760    D5             C                  PUSH    DE
  C761    21 0004        C                  LD      HL,S3.DATUM-S3.SEAT
  C764    11 A800        C                  LD      DE,S0.DEAT
  C767    19             C                  ADD     HL,DE
  C768    01 06FD        C                  LD      BC,006FDH           ;actual Date ermitteln
  C76B    ED B2          C                  INIR
  C76D    D1             C                  POP     DE
  C76E    C1             C                  POP     BC
                         C      ;
  C76F    E1             C      S1.DATE:    POP     HL
  C770    E1             C                  POP     HL
  C771    C9             C                  RET
                         C      ;
                         C      ;
  C772    C772           C                  DW      $
  C774    53 54 41 53    C                  DB      'STAS'
  C778    3E 01          C                  LD      A,1
  C77A    32 B241        C      S1.STAS1:   LD      (TS.KGMER),A
