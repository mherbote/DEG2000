'K M B G  allgemeine Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G      Aktivierung Geraeteroutine                     *
                         C      ;****************************************************************
  D56D    DD E5          C      K1.ARMB:    PUSH    IX
  D56F    FD E5          C                  PUSH    IY
  D571    CD D68C        C                  CALL    K1.MVS              ;Anzeige Kassettengeraet arbeitet
  D574    2A B132        C                  LD      HL,(K2.FKADR)
  D577    11 D521        C                  LD      DE,K1.ADRK3
  D57A    CD D66B        C                  CALL    K1.MONI
  D57D    CD D6A3        C                  CALL    K1.MVL
                         C                                              ; LD      (IX+5),LOW(K1.ARMB1)
                         C                                              ; LD      (IX+6),HIGH(K1.ARMB1)
  D580    DD E5          C      K1.ARMBM:   PUSH    IX
  D582    CD F653        C                  CALL    S0.KRZU             ;BAMOS-Routine zuschalten
  D585    CD D598        C                  CALL    K1.IX2V1            ;???? ;IX-Bereich ===> V1
  D588    CD 4069        C                  CALL    KR.BRKMB            ;Ausfuehrung Kassettenkommando
  D58B    DD E1          C                  POP     IX
  D58D    CD D5B2        C                  CALL    K1.V12IX            ;V1 ===> IX-Bereich
                         C      ; K1.ARMB0:   HALT                        ;warten auf Routinen-Ende
                         C      ;             JR      K1.ARMB0
                         C      ; K1.ARMB1:   INC     SP                  ;stack-pointer korrigieren
                         C      ;             INC     SP
  D590    CD B2D4        C                  CALL    S2.STACK            ;BAMOS-Routine wegschalten
  D593    FD E1          C                  POP     IY
  D595    DD E1          C                  POP     IX
  D597    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G      IX-Bereich to SYS V1.2                         *
                         C      ;****************************************************************
  D598    E5             C      K1.IX2V1:   PUSH    HL
  D599    D5             C                  PUSH    DE
  D59A    C5             C                  PUSH    BC
  D59B    DD E5          C                  PUSH    IX
  D59D    E1             C                  POP     HL
  D59E    DD 21 2B03     C                  LD      IX,UB.KTAB
  D5A2    DD 36 FE 02    C                  LD      (IX-2),2            ;HS-Bereich V2.13 (K0.HSB)
  D5A6    11 2B03        C                  LD      DE,UB.KTAB
  D5A9    01 000B        C                  LD      BC,11
  D5AC    ED B0          C                  LDIR
  D5AE    C1             C                  POP     BC
  D5AF    D1             C                  POP     DE
  D5B0    E1             C                  POP     HL
  D5B1    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G      SYS V1.2 to IX-Bereich                         *
                         C      ;****************************************************************
  D5B2    E5             C      K1.V12IX:   PUSH    HL
  D5B3    D5             C                  PUSH    DE
  D5B4    C5             C                  PUSH    BC
  D5B5    DD E5          C                  PUSH    IX
  D5B7    DD E5          C                  PUSH    IX
  D5B9    D1             C                  POP     DE
  D5BA    21 2B03        C                  LD      HL,UB.KTAB          ;Statusbyte und Fehlerbyte holen
  D5BD    01 0002        C                  LD      BC,2
  D5C0    ED B0          C                  LDIR
  D5C2    DD E1          C                  POP     IX
  D5C4    21 2B02        C                  LD      HL,UB.KTAB-1        ;Laenge der Daten im Puffer (1 BM, 2 SL, 20H oder 80H)
  D5C7    46             C                  LD      B,(HL)
  D5C8    DD 36 09 00    C                  LD      (IX+9),0
  D5CC    DD 70 0A       C                  LD      (IX+10),B
  D5CF    C1             C                  POP     BC
  D5D0    D1             C                  POP     DE
  D5D1    E1             C                  POP     HL
  D5D2    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G      Fehlertest nach CALL ARMB                      *
                         C      ;****************************************************************
  D5D3    DD CB 00 7E    C      K1.ARBT:    BIT     7,(IX+0)
  D5D7    C2 D6C0        C                  JP      NZ,K1.ERRT
  D5DA    CD D67C        C                  CALL    K1.FL
  D5DD    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G      Unterprogramme fuer RCZx +- 1 und BLKx +-1     *
                         C      ;****************************************************************
  D5DE    FD 66 FF       C      K1.BLKP:    LD      H,(IY-1)            ;BLK x  +  1
  D5E1    FD 6E FE       C                  LD      L,(IY-2)
  D5E4    23             C                  INC     HL
  D5E5    FD 74 FF       C                  LD      (IY-1),H
  D5E8    FD 75 FE       C                  LD      (IY-2),L
  D5EB    C9             C                  RET
                         C      
'K M B G  allgemeine Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  D5EC    FD 66 FF       C      K1.BLKM:    LD      H,(IY-1)            ;BLK x  -  1
  D5EF    FD 6E FE       C                  LD      L,(IY-2)
  D5F2    2B             C                  DEC     HL
  D5F3    FD 74 FF       C                  LD      (IY-1),H
  D5F6    FD 75 FE       C                  LD      (IY-2),L
  D5F9    C9             C                  RET
                         C      
  D5FA    FD 66 FD       C      K1.RCZP:    LD      H,(IY-3)            ;RCZ x  +  1
  D5FD    FD 6E FC       C                  LD      L,(IY-4)
  D600    23             C                  INC     HL
  D601    FD 74 FD       C                  LD      (IY-3),H
  D604    FD 75 FC       C                  LD      (IY-4),L
  D607    C9             C                  RET
                         C      
  D608    FD 66 FD       C      K1.RCZM:    LD      H,(IY-3)            ;RCZ x  -  1
  D60B    FD 6E FC       C                  LD      L,(IY-4)
  D60E    2B             C                  DEC     HL
  D60F    FD 74 FD       C                  LD      (IY-3),H
  D612    FD 75 FC       C                  LD      (IY-4),L
  D615    C9             C                  RET
                         C      
                         C                  PAGE
'K M B G  allgemeine Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G      RCZx loeschen                                  *
                         C      ;****************************************************************
  D616    AF             C      K1.RCZN:    XOR     A                   ;RCZ x  :=  0
  D617    FD 77 FD       C      K1.RCZS:    LD      (IY-3),A            ;RCZ x  :=  (A)
  D61A    FD 77 FC       C                  LD      (IY-4),A
  D61D    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G      HL und BC laden aus E/A-Tabelle                *
                         C      ;****************************************************************
  D61E    DD 66 08       C      K1.LHLBC:   LD      H,(IX+8)
  D621    DD 6E 07       C                  LD      L,(IX+7)
  D624    DD 46 09       C                  LD      B,(IX+9)
  D627    DD 4E 0A       C                  LD      C,(IX+10)
  D62A    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G      Bandmarke gelesen ?                            *
                         C      ;****************************************************************
  D62B    DD 7E 0A       C      K1.BM:      LD      A,(IX+10)
  D62E    FE 01          C                  CP      1
                         C                                              ; LD      A,(IX+9)
                         C                                              ; OR      (IX+10)
  D630    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G      zweiter Leseversuch nach Fehler 17             *
                         C      ;****************************************************************
  D631    DD 7E 01       C      K1.F17:     LD      A,(IX+1)            ;Fehlerbyte
  D634    FE 17          C                  CP      17H
  D636    C0             C                  RET     NZ
  D637    DD 36 04 15    C                  LD      (IX+4),15H          ;CMD einen Block zurueck
  D63B    CD D56D        C                  CALL    K1.ARMB
  D63E    CD D5D3        C                  CALL    K1.ARBT
  D641    DD 36 04 02    C                  LD      (IX+4),02H          ;CMD Wiedergabe
  D645    CD D56D        C                  CALL    K1.ARMB
  D648    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G      IX und IY  mit Anfangswerten laden             *
                         C      ;****************************************************************
  D649    DD 21 0013     C      K1.RGL1:    LD      IX,S3.KS1-S3.SEAT
  D64D    11 A803        C                  LD      DE,S0.DEAT+3
  D650    DD 19          C                  ADD     IX,DE
  D652    FD 21 00B0     C                  LD      IY,S3.KSK1-S3.SEAT
  D656    13             C                  INC     DE
  D657    FD 19          C                  ADD     IY,DE
  D659    C9             C                  RET
                         C      
  D65A    DD 21 002E     C      K1.RGL2:    LD      IX,S3.KS2-S3.SEAT
  D65E    11 A803        C                  LD      DE,S0.DEAT+3
  D661    DD 19          C                  ADD     IX,DE
  D663    FD 21 00D4     C                  LD      IY,S3.KSK2-S3.SEAT
  D667    13             C                  INC     DE
  D668    FD 19          C                  ADD     IY,DE
  D66A    C9             C                  RET
                         C      
                         C                  PAGE
'K M B G  allgemeine Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G      Anzeigetext    ===>    K2.S/F-KADR             *
                         C      ;****************************************************************
  D66B    25             C      K1.MONI:    DEC     H                   ;(HL) ...  K2.S/F-KADR
  D66C    2D             C                  DEC     L                   ;(DE) ...  ADRKi
  D66D    22 B18C        C                  LD      (MS.ZPOS),HL
  D670    EB             C                  EX      DE,HL
  D671    06 26          C                  LD      B,38
  D673    3E 18          C                  LD      A,24
  D675    32 B198        C                  LD      (MS.CMD),A
  D678    CD CB35        C                  CALL    MO.MONI
  D67B    C9             C                  RET
                         C      
  D67C    CD D68C        C      K1.FL:      CALL    K1.MVS              ;Fehlerzeile loeschen
  D67F    2A B132        C                  LD      HL,(K2.FKADR)
  D682    11 D547        C                  LD      DE,K1.ADRK4
  D685    CD D66B        C                  CALL    K1.MONI
  D688    CD D6A3        C                  CALL    K1.MVL
  D68B    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G      Monitorvektor retten und wiederherstellen      *
                         C      ;***************************************************************
  D68C    21 B18A        C      K1.MVS:     LD      HL,MS.ZPOL
  D68F    11 B162        C                  LD      DE,K2.RBER
  D692    01 0015        C                  LD      BC,21
  D695    ED B0          C                  LDIR
  D697    21 DEE8        C                  LD      HL,K1.ZMIN
  D69A    11 B18E        C                  LD      DE,MS.ZMIN
  D69D    01 000A        C                  LD      BC,10
  D6A0    ED B0          C                  LDIR
  D6A2    C9             C                  RET
                         C      
  D6A3    21 B162        C      K1.MVL:     LD      HL,K2.RBER
  D6A6    11 B18A        C                  LD      DE,MS.ZPOL
  D6A9    01 0015        C                  LD      BC,21
  D6AC    ED B0          C                  LDIR
  D6AE    C9             C                  RET
                         C      
  D6AF    E5             C      K1.ZPR2:    PUSH    HL
  D6B0    C5             C                  PUSH    BC
  D6B1    ED 6F          C                  RLD
  D6B3    E6 0F          C                  AND     0FH
  D6B5    C6 30          C                  ADD     A,30H
  D6B7    FE 3A          C                  CP      3AH
  D6B9    38 02          C                  JR      C,K1.ZPR3
  D6BB    C6 07          C                  ADD     A,7
  D6BD    C1             C      K1.ZPR3:    POP     BC
  D6BE    E1             C                  POP     HL
  D6BF    C9             C                  RET
                         C      
                         C                  PAGE
'K M B G  allgemeine Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-88


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G      Anzeige Geraetefehler                          *
                         C      ;****************************************************************
  D6C0    CD D68C        C      K1.ERRT:    CALL    K1.MVS
  D6C3    21 D4D5        C                  LD      HL,K1.ADRK1
  D6C6    11 B13A        C                  LD      DE,K2.ADRK
  D6C9    01 0026        C                  LD      BC,38
  D6CC    ED B0          C                  LDIR
  D6CE    DD E5          C                  PUSH    IX
  D6D0    DD E5          C                  PUSH    IX
  D6D2    DD 21 B13A     C                  LD      IX,K2.ADRK
  D6D6    E1             C                  POP     HL                  ;Statusaufbereitung
  D6D7    CD D6AF        C                  CALL    K1.ZPR2
  D6DA    DD 77 14       C                  LD      (IX+20),A
  D6DD    CD D6AF        C                  CALL    K1.ZPR2
  D6E0    DD 77 15       C                  LD      (IX+21),A
  D6E3    36 00          C                  LD      (HL),0              ;reset status
  D6E5    23             C                  INC     HL                  ;Fehleraufbereitung
  D6E6    CD D6AF        C                  CALL    K1.ZPR2
  D6E9    DD 77 22       C                  LD      (IX+34),A
  D6EC    CD D6AF        C                  CALL    K1.ZPR2
  D6EF    DD 77 23       C                  LD      (IX+35),A
  D6F2    36 00          C                  LD      (HL),0              ;reset fehler
  D6F4    2A B132        C                  LD      HL,(K2.FKADR)
  D6F7    11 B13A        C                  LD      DE,K2.ADRK
  D6FA    CD D66B        C                  CALL    K1.MONI
  D6FD    DD E1          C                  POP     IX
  D6FF    CD D6A3        C                  CALL    K1.MVL
  D702    CD D70D        C                  CALL    K1.GNSTS
  D705    AF             C                  XOR     A                   ;Tastaturroutine ruecksetzen auf Tasteneingabe
  D706    32 B247        C                  LD      (TS.MIO),A
  D709    2A B136        C                  LD      HL,(K2.FRADR)
  D70C    E9             C                  JP      (HL)
                         C      ;****************************************************************
                         C      ;*  K M B G    Anzeige STATUS                                   *
                         C      ;****************************************************************
  D70D    CD D68C        C      K1.GNSTS:   CALL    K1.MVS
  D710    FD 6E FC       C                  LD      L,(IY-4)            ;RCZ:=RCZx
  D713    FD 66 FD       C                  LD      H,(IY-3)
  D716    22 B11C        C                  LD      (K2.RCZ),HL
  D719    FD 6E FE       C                  LD      L,(IY-2)            ;BLK:=BLKx
  D71C    FD 66 FF       C                  LD      H,(IY-1)
  D71F    22 B11E        C                  LD      (K2.BLK),HL
  D722    21 D4FB        C                  LD      HL,K1.ADRK2
  D725    11 B13A        C                  LD      DE,K2.ADRK
  D728    01 0026        C                  LD      BC,38
  D72B    ED B0          C                  LDIR
  D72D    11 B140        C                  LD      DE,K2.ADRK+6
  D730    DD 7E 03       C                  LD      A,(IX+3)            ;Geraeteadressenaufbereitung
  D733    C6 30          C                  ADD     A,30H
  D735    12             C                  LD      (DE),A
  D736    2A B11E        C                  LD      HL,(K2.BLK)         ;Blockzaehleraufbereitung
  D739    11 B14B        C                  LD      DE,K2.ADRK+17
  D73C    CD C56D        C                  CALL    S1.HDI
  D73F    2A B11C        C                  LD      HL,(K2.RCZ)         ;Satzzaehleraufbereitung
  D742    11 B159        C                  LD      DE,K2.ADRK+31
  D745    CD C56D        C                  CALL    S1.HDI
  D748    2A B134        C                  LD      HL,(K2.SKADR)
  D74B    11 B13A        C                  LD      DE,K2.ADRK
  D74E    CD D66B        C                  CALL    K1.MONI
  D751    CD D6A3        C                  CALL    K1.MVL
  D754    C9             C                  RET
                         C                  TITLE   'K M B G  reservieren ein/aus und rewind'
                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G    Reservieren Geraet x ein                         *
                         C      ;****************************************************************
  D755    DD 36 04 31    C      K1.GNRE1:   LD      (IX+4),31H          ;CMD reservieren ein
  D759    CD D56D        C                  CALL    K1.ARMB
  D75C    DD CB 00 66    C                  BIT     4,(IX)
  D760    C4 D6C0        C                  CALL    NZ,K1.ERRT
  D763    C9             C                  RET
  D764    CD D755        C      K1.GNRE:    CALL    K1.GNRE1
  D767    CD D755        C                  CALL    K1.GNRE1
  D76A    CD D67C        C                  CALL    K1.FL
  D76D    DD CB FF 4E    C                  BIT     1,(IX-1)
  D771    C0             C                  RET     NZ
  D772    CD D616        C                  CALL    K1.RCZN             ;RCZx:=0
  D775    FD 77 FF       C                  LD      (IY-1),A            ;BLKx:=1
  D778    3C             C                  INC     A
  D779    FD 77 FE       C                  LD      (IY-2),A
'K M B G  reservieren ein/aus und rewind'	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  D77C    DD CB FF CE    C                  SET     1,(IX-1)
  D780    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G    Reservieren Geraet x aus                         *
                         C      ;****************************************************************
  D781    DD 36 04 41    C      K1.GNRA:    LD      (IX+4),41H          ;CMD reservieren aus
  D785    CD D56D        C                  CALL    K1.ARMB
  D788    CD D5D3        C                  CALL    K1.ARBT
  D78B    DD CB FF 8E    C                  RES     1,(IX-1)            ;OPEN-bit           zuruecksetzen
  D78F    DD CB FF 96    C                  RES     2,(IX-1)            ;Richtungsbit       zuruecksetzen
  D793    DD CB FF 9E    C                  RES     3,(IX-1)            ;Verarbeitungsbit   zuruecksetzen
  D797    DD CB FF A6    C                  RES     4,(IX-1)            ;Konvertierungsbit  zuruecksetzen
  D79B    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G    REWIND - Routine                                 *
                         C      ;****************************************************************
  D79C    CD D7AD        C      K1.GNRW:    CALL    K1.RW3
  D79F    CD D616        C                  CALL    K1.RCZN             ;RCZx:=0
  D7A2    FD 77 FF       C                  LD      (IY-1),A            ;BLKx:=1
  D7A5    3C             C                  INC     A
  D7A6    FD 77 FE       C                  LD      (IY-2),A
  D7A9    CD D67C        C                  CALL    K1.FL
  D7AC    C9             C                  RET
  D7AD    DD 36 04 21    C      K1.RW3:     LD      (IX+4),21H          ;CMD  rewind
  D7B1    CD D56D        C                  CALL    K1.ARMB
  D7B4    CD D7BA        C      K1.RW1:     CALL    K1.BERT
  D7B7    D0             C                  RET     NC
  D7B8    18 FA          C                  JR      K1.RW1
                         C      
  D7BA    CD F653        C      K1.BERT:    CALL    S0.KRZU
                         C      ;            CALL    0                  ;??? KR.BERT
  D7BD    CD B2D4        C                  CALL    S2.STACK
  D7C0    C9             C                  RET
                         C      
                         C                  TITLE   'K M B G  set RCD +- 1'
                         C                  PAGE
'K M B G  set RCD +- 1'	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G    set record + 1                                   *
                         C      ;****************************************************************
  D7C1    DD 36 04 02    C      K1.GNRP:    LD      (IX+4),02H          ;CMD wiedergabe
  D7C5    CD D56D        C                  CALL    K1.ARMB
  D7C8    CD D5D3        C                  CALL    K1.ARBT
  D7CB    CD D5FA        C                  CALL    K1.RCZP
  D7CE    CD D62B        C                  CALL    K1.BM               ;RCD = BM ?
  D7D1    06 00          C                  LD      B,0
  D7D3    C0             C                  RET     NZ
  D7D4    04             C                  INC     B
  D7D5    CD D5DE        C                  CALL    K1.BLKP
  D7D8    CD D616        C                  CALL    K1.RCZN             ;RCZx:=0
  D7DB    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G    set record - 1                                   *
                         C      ;****************************************************************
  D7DC    DD 36 04 15    C      K1.GNRM:    LD      (IX+4),15H          ;CMD einen block zurueck
  D7E0    CD D56D        C                  CALL    K1.ARMB
  D7E3    CD D5D3        C                  CALL    K1.ARBT
  D7E6    DD 36 04 02    C                  LD      (IX+4),02H          ;CMD wiedergabe
  D7EA    CD D56D        C                  CALL    K1.ARMB
  D7ED    CD D5D3        C                  CALL    K1.ARBT
  D7F0    DD 36 04 15    C                  LD      (IX+4),15H          ;CMD einen block zurueck
  D7F4    CD D56D        C                  CALL    K1.ARMB
  D7F7    CD D5D3        C                  CALL    K1.ARBT
  D7FA    CD D608        C                  CALL    K1.RCZM
  D7FD    CD D62B        C                  CALL    K1.BM                  ;RCD = BM ?
  D800    06 00          C                  LD      B,0
  D802    C0             C                  RET     NZ
  D803    04             C                  INC     B
  D804    CD D5EC        C                  CALL    K1.BLKM
  D807    3E FF          C                  LD      A,0FFH              ;RCZx:=FFFFH
  D809    CD D617        C                  CALL    K1.RCZS
  D80C    C9             C                  RET
                         C      
                         C                  TITLE   'K M B G  suche BM'
                         C                  PAGE
'K M B G  suche BM'	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G    suchen Bandmarke                                 *
                         C      ;****************************************************************
  D80D    16 01          C      K1.GNLP:    LD      D,1                 ;vorwaerts     ====>
  D80F    D5             C      K1.GNLPN:   PUSH    DE
  D810    FD 7E FD       C                  LD      A,(IY-3)            ;RCZx = 0 ?
  D813    FD B6 FC       C                  OR      (IY-4)
  D816    28 19          C                  JR      Z,K1.LP2
  D818    FD 7E FF       C                  LD      A,(IY-1)            ;RCZx > 0 , BLKx = 1 ?
  D81B    B7             C                  OR      A
  D81C    20 0C          C                  JR      NZ,K1.LP1
  D81E    FD 7E FE       C                  LD      A,(IY-2)
  D821    FE 01          C                  CP      1
  D823    20 05          C                  JR      NZ,K1.LP1
  D825    CD D7AD        C                  CALL    K1.RW3              ;BLKx = 1
  D828    18 07          C                  JR      K1.LP2
  D82A    3E 01          C      K1.LP1:     LD      A,1                 ;BLKx > 1
  D82C    06 75          C                  LD      B,75H
  D82E    CD D877        C                  CALL    K1.RW4
  D831    F1             C      K1.LP2:     POP     AF
  D832    B7             C                  OR      A
  D833    28 0C          C                  JR      Z,K1.LP3
  D835    F5             C                  PUSH    AF
  D836    06 71          C                  LD      B,71H
  D838    CD D877        C                  CALL    K1.RW4
  D83B    C1             C                  POP     BC                  ;BLKx := BLKx + N
  D83C    CD D5DE        C                  CALL    K1.BLKP
  D83F    10 FB          C                  DJNZ    $-3
  D841    CD D616        C      K1.LP3:     CALL    K1.RCZN             ;RCZx := 0
  D844    C9             C                  RET
  D845    16 01          C      K1.GNLM:    LD      D,1                 ;rueckwaerts   <====
  D847    FD 7E FF       C      K1.GNLMN:   LD      A,(IY-1)
  D84A    B7             C                  OR      A
  D84B    20 0E          C                  JR      NZ,K1.LM1
  D84D    FD 7E FE       C                  LD      A,(IY-2)
  D850    3D             C                  DEC     A                   ;A := i-1
  D851    92             C                  SUB     D                   ;A := i-1-N
  D852    CA D79C        C                  JP      Z,K1.GNRW
  D855    F2 D85B        C                  JP      P,K1.LM1
  D858    C3 D79C        C                  JP      K1.GNRW
  D85B    FD 7E FD       C      K1.LM1:     LD      A,(IY-3)            ;RCZx = 0 ?
  D85E    FD B6 FC       C                  OR      (IY-4)
  D861    D5             C                  PUSH    DE
  D862    28 01          C                  JR      Z,K1.LM2
  D864    14             C                  INC     D
  D865    7A             C      K1.LM2:     LD      A,D
  D866    06 75          C                  LD      B,75H
  D868    CD D877        C                  CALL    K1.RW4
  D86B    C1             C                  POP     BC                  ;BLKx := BLKx - N
  D86C    78             C                  LD      A,B
  D86D    B7             C                  OR      A
  D86E    28 05          C                  JR      Z,K1.LM3
  D870    CD D5EC        C                  CALL    K1.BLKM
  D873    10 FB          C                  DJNZ    $-3
  D875    18 CA          C      K1.LM3:     JR      K1.LP3
  D877    B7             C      K1.RW4:     OR      A                   ;Anzahl Bandmarken = 0 ?
  D878    C8             C                  RET     Z
  D879    DD 70 04       C                  LD      (IX+4),B            ;Kommando
  D87C    DD 36 09 00    C                  LD      (IX+9),0
  D880    DD 77 0A       C                  LD      (IX+10),A           ;Anzahl Bandmarken
  D883    CD D56D        C                  CALL    K1.ARMB
  D886    CD D5D3        C                  CALL    K1.ARBT
  D889    C9             C                  RET
                         C                  TITLE   'K M B G   CLOSE'
                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G    CLOSE - Routine                                  *
                         C      ;****************************************************************
  D88A    DD 36 04 51    C      K1.GNCLS:   LD      (IX+4),51H          ;CMD write BM
  D88E    CD D56D        C                  CALL    K1.ARMB
  D891    CD D5D3        C                  CALL    K1.ARBT
  D894    DD 36 04 61    C                  LD      (IX+4),61H          ;CMD write end of volume
  D898    CD D56D        C                  CALL    K1.ARMB
  D89B    CD D5D3        C                  CALL    K1.ARBT
  D89E    DD 36 04 15    C                  LD      (IX+4),15H          ;CMD ein block zurueck
  D8A2    CD D56D        C                  CALL    K1.ARMB
  D8A5    CD D5D3        C                  CALL    K1.ARBT
  D8A8    DD 36 04 11    C                  LD      (IX+4),11H          ;CMD ein block vor
  D8AC    CD D56D        C                  CALL    K1.ARMB
  D8AF    CD D5D3        C                  CALL    K1.ARBT
  D8B2    CD D5DE        C      K1.RD1:     CALL    K1.BLKP
'K M B G   CLOSE'	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  D8B5    18 BE          C                  JR      K1.LM3
                         C      
