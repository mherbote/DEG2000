                         C                  LD      (BC.WRTV+1),HL
                         C                  JP      0B403H
                         C      ;****************************************************************
                         C      ;*               Leser- und Stanzerkanal zuruecksetzen          *
                         C      ;****************************************************************
                         C      S4.SVC65:   LD      HL,S9.RIV
                         C                  LD      (BC.RIV+1),HL
