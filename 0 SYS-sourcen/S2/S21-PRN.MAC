  C3B6    E5             C                  PUSH    HL
  C3B7    C1             C      S1.SUCH2:   POP     BC
  C3B8    E1             C                  POP     HL
  C3B9    D5             C                  PUSH    DE
  C3BA    7D             C      S1.SUCH1:   LD      A,L
  C3BB    5C             C                  LD      E,H
