'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-22


                         C      
                         C      ;****************************************************************
                         C      ;*               Unterprogramm zur Bedienerkommunikation        *
                         C      ;*               -----------------------------------------------*
                         C      ;*  CALL ANZEI   Aufruf des Unterprogrammes                     *
                         C      ;*  DB   zpos    zpos    ...   Zeilenpos. -1 fuer Kommunikation *
                         C      ;*  DB   spos    spos    ...   Spaltenpos.-1 fuer Kommunikation *
                         C      ;*  DB   alae    alae    ...   Laenge des Anzeigetextes         *
                         C      ;*                             bit 7=0   es folgt atext         *
                         C      ;*                                 7=1   es folgt adr(atext)    *
                         C      ;*                             bit 6=0   bit 5...0 Textlaenge   *
                         C      ;*                                 alae=0 keine Textanzeige, es *
                         C      ;*                                 entfaellt der Parameter atext*
                         C      ;*                                 6=1   Text mit Endekenng. -1 *
                         C      ;*                                                              *
                         C      ;*  DB   atext   atext   ...   Anzeigetext  bzw.                *
                         C      ;*  DA   adr(atext)      ...   Adresse des Anzeigetextes        *
                         C      ;*                                                              *
                         C      ;*  DB   elae    elae    ...   Eingabebereichslaenge            *
                         C      ;*                             bei elae=0 keine Eingabe,        *
                         C      ;*                             es entfallen die nachf. Param.   *
                         C      ;*  DB   spmer   spmer   ...   Wert fuer  TS.SPMER              *
                         C      ;*  DA   nquit   nquit   ...   Routinenadr. fuer  NEG QUIT      *
                         C      ;*  DA   pquit   pquit   ...   Routinenadr. fuer  POS QUIT      *
                         C      ;*  DA   aein    aein    ...   Routinenadr. fuer  Alphnum-Tasten*
                         C      ;*               -----------------------------------------------*
                         C      ;*               wenn elae=0 , dann Programmfortsetzung beim    *
                         C      ;*                             naechsten Befehl nach  elae      *
                         C      ;*               wenn elae>0 , dann Programmfortsetzung bei der *
                         C      ;*                             Tastaturabfrageschleife          *
                         C      ;*               -----------------------------------------------*
                         C      ;*               in  HL  wird die Adresse des Eingabebereiches  *
                         C      ;*               und in  BC  die Bereichslaenge uebergeben      *
                         C      ;****************************************************************
  C3DE    FD E3          C      S1.ANZEI:   EX      (SP),IY             ;IY ==> Keller , Paradr ==> IY
  C3E0    DD E5          C                  PUSH    IX                  ;Register retten
  C3E2    F5             C                  PUSH    AF
  C3E3    D5             C                  PUSH    DE
  C3E4    3E 01          C                  LD      A,1                 ;def. gesamtes Bild als Fenster
  C3E6    32 B198        C                  LD      (MS.CMD),A
  C3E9    CD CB35        C                  CALL    MO.MONI
  C3EC    FD 23          C                  INC     IY                  ;IY auf  atext  positionieren
  C3EE    FD 23          C                  INC     IY
  C3F0    FD 23          C                  INC     IY
  C3F2    FD E5          C                  PUSH    IY
  C3F4    FD 6E FD       C                  LD      L,(IY-3)            ;ZPOS
  C3F7    FD 66 FE       C                  LD      H,(IY-2)            ;SPOS
  C3FA    22 B18C        C                  LD      (MS.ZPOS),HL
  C3FD    FD CB FF 76    C                  BIT     6,(IY-1)            ;Test, ob Laengenangabe
  C401    20 0D          C                  JR      NZ,S1.ANZ6
  C403    FD 7E FF       C                  LD      A,(IY-1)            ;Laengenbyte
  C406    E6 3F          C                  AND     3FH
  C408    28 42          C                  JR      Z,S1.ANZ1           ;Anzeige ueberspringen
  C40A    47             C                  LD      B,A
  C40B    3E 18          C                  LD      A,24
  C40D    32 B198        C                  LD      (MS.CMD),A
  C410    E1             C      S1.ANZ6:    POP     HL                  ;Textadresse
  C411    FD CB FF 7E    C                  BIT     7,(IY-1)
  C415    28 06          C                  JR      Z,S1.ANZ3
  C417    FD 6E 00       C                  LD      L,(IY)
  C41A    FD 66 01       C                  LD      H,(IY+1)
  C41D    FD 23          C      S1.ANZ3:    INC     IY
  C41F    FD 23          C                  INC     IY
  C421    FD E5          C                  PUSH    IY
  C423    FD CB FD 76    C                  BIT     6,(IY-3)
  C427    20 0E          C                  JR      NZ,S1.ANZ4
  C429    CD CB35        C                  CALL    MO.MONI
  C42C    FD CB FD 7E    C                  BIT     7,(IY-3)
  C430    20 1A          C                  JR      NZ,S1.ANZ1
  C432    FD E1          C                  POP     IY
  C434    E5             C                  PUSH    HL
  C435    18 15          C                  JR      S1.ANZ1
                         C      
  C437    3E 14          C      S1.ANZ4:    LD      A,20
  C439    32 B198        C                  LD      (MS.CMD),A
  C43C    7E             C      S1.ANZ5:    LD      A,(HL)
  C43D    23             C                  INC     HL
  C43E    FE FF          C                  CP      -1
  C440    28 0A          C                  JR      Z,S1.ANZ1
  C442    32 B199        C                  LD      (MS.TK),A
  C445    E5             C                  PUSH    HL
  C446    CD CB35        C                  CALL    MO.MONI
'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  C449    E1             C                  POP     HL
  C44A    18 F0          C                  JR      S1.ANZ5
                         C      
  C44C    FD E1          C      S1.ANZ1:    POP     IY
  C44E    3E 0B          C                  LD      A,11
  C450    32 B198        C                  LD      (MS.CMD),A
  C453    CD CB35        C                  CALL    MO.MONI
  C456    E5             C                  PUSH    HL
  C457    FD 7E 00       C                  LD      A,(IY)              ;Eingabelaenge
  C45A    06 00          C                  LD      B,0
  C45C    4F             C                  LD      C,A
  C45D    C5             C                  PUSH    BC
  C45E    B7             C                  OR      A
  C45F    28 50          C                  JR      Z,S1.ANZ2           ;keine Eingabe gefordert
                         C      
                         C                  PAGE
'Unterprogramme'	MACRO-80 3.44	09-Dec-81	PAGE	1-24


                         C      
  C461    2A B18C        C                  LD      HL,(MS.ZPOS)        ;ZMIN und SMIN ermitteln
  C464    24             C                  INC     H
  C465    2C             C                  INC     L
  C466    22 B18E        C                  LD      (MS.ZMIN),HL
  C469    7C             C                  LD      A,H                 ;ZMAX und SMAX ermitteln
  C46A    0D             C                  DEC     C
  C46B    81             C                  ADD     A,C
  C46C    67             C                  LD      H,A
  C46D    22 B190        C                  LD      (MS.ZMAX),HL
  C470    CD D442        C                  CALL    TA.LOES
  C473    2A B24D        C                  LD      HL,(TS.STACK)
  C476    E5             C                  PUSH    HL
  C477    FD 6E 02       C                  LD      L,(IY+2)            ;Routine  NEG QUIT
  C47A    FD 66 03       C                  LD      H,(IY+3)
  C47D    E5             C                  PUSH    HL
  C47E    FD 6E 04       C                  LD      L,(IY+4)            ;Routine  POS QUIT
  C481    FD 66 05       C                  LD      H,(IY+5)
  C484    E5             C                  PUSH    HL
  C485    ED 73 B24D     C                  LD      (TS.STACK),SP
  C489    21 C4BC        C                  LD      HL,S1.ANZ7
  C48C    22 B223        C                  LD      (TS.TAB4),HL
  C48F    21 C4CB        C                  LD      HL,S1.ANZ8
  C492    22 B21B        C                  LD      (TS.TAB3+4),HL
  C495    FD 6E 06       C                  LD      L,(IY+6)            ;Routine  alphanum. Tasten
  C498    FD 66 07       C                  LD      H,(IY+7)
  C49B    22 B22D        C                  LD      (TS.EINA),HL
  C49E    FD 7E 01       C                  LD      A,(IY+1)
  C4A1    32 B23F        C                  LD      (TS.SPMER),A
  C4A4    3E 06          C                  LD      A,6                 ;Cursor setzen
  C4A6    32 B198        C                  LD      (MS.CMD),A
  C4A9    CD CB35        C                  CALL    MO.MONI
  C4AC    21 C1DE        C                  LD      HL,S1.TFE
  C4AF    E5             C                  PUSH    HL
  C4B0    C9             C                  RET                         ;zur Tastaturabfrageschleife
                         C      
                         C      
  C4B1    C1             C      S1.ANZ2:    POP     BC                  ;Register herstellen
  C4B2    E1             C                  POP     HL
  C4B3    D1             C                  POP     DE
  C4B4    F1             C                  POP     AF
  C4B5    DD E1          C                  POP     IX
  C4B7    FD 23          C                  INC     IY
  C4B9    FD E3          C                  EX      (SP),IY
  C4BB    C9             C                  RET                         ;Ruecksprung zum naechsten Befehl
                         C      
  C4BC    FD E1          C      S1.ANZ7:    POP     IY                  ;RET TA.MM   Rueckkehr POS_QUIT
  C4BE    FD E1          C                  POP     IY                  ;RET ABFR
  C4C0    FD E1          C                  POP     IY                  ;POS QUIT
  C4C2    E1             C                  POP     HL                  ;NEG QUIT
  C4C3    FD 2B          C      S1.ANZ9:    DEC     IY
  C4C5    E1             C                  POP     HL                  ;TS.STACK
  C4C6    22 B24D        C                  LD      (TS.STACK),HL
  C4C9    18 E6          C                  JR      S1.ANZ2
                         C      
  C4CB    FD E1          C      S1.ANZ8:    POP     IY                  ;RET TA.MM   Rueckkehr NEG_QUIT
  C4CD    FD E1          C                  POP     IY                  ;RET ABFR
  C4CF    FD E1          C                  POP     IY                  ;POS QUIT
  C4D1    FD E1          C                  POP     IY                  ;NEG QUIT
  C4D3    18 EE          C                  JR      S1.ANZ9
