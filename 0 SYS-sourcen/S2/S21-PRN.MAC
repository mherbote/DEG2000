'Schreiben/Lesen eines Zeichens'	MACRO-80 3.44	09-Dec-81	PAGE	1-67


                         C      
  D085    3A B197        C      MO.MZSW:    LD      A,(MS.DIRES)
  D088    F5             C                  PUSH    AF
  D089    CB 6F          C                  BIT     5,A
  D08B    28 11          C                  JR      Z,MO.MZSW1
  D08D    21 B18E        C                  LD      HL,MS.ZMIN
  D090    3A B18C        C                  LD      A,(MS.ZPOS)
  D093    3C             C                  INC     A
  D094    BE             C                  CP      (HL)
  D095    28 1A          C                  JR      Z,MO.MZSW3
  D097    F1             C                  POP     AF
  D098    F5             C                  PUSH    AF
  D099    CB AF          C                  RES     5,A
  D09B    32 B197        C                  LD      (MS.DIRES),A
  D09E    CD CD9C        C      MO.MZSW1:   CALL    MO.DSPOS
  D0A1    F5             C      MO.MZSW2:   PUSH    AF
  D0A2    D1             C                  POP     DE
  D0A3    F1             C                  POP     AF
  D0A4    D5             C                  PUSH    DE
  D0A5    32 B197        C                  LD      (MS.DIRES),A
  D0A8    CB 77          C                  BIT     6,A
  D0AA    28 33          C                  JR      Z,MO.MZSL
  D0AC    F1             C                  POP     AF
  D0AD    DC CD8A        C                  CALL    C,MO.DZPOS
