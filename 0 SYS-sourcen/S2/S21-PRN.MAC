  CABF    01             C+                 DB      HIGH(100H)         ;Pufferlaenge
  CAC0    00             C+                 DB      LOW(100H)
  CAC1    00             C+                 DB      0                ;Informationsbyte 1
  CAC2    00             C+                 DB      0                ;Informationsbyte 2
  CAC3    00             C+                 DB      0                ;Informationsbyte 3
  CAC4    0000           C                  DW      0                   ;OPEN
  CAC6    0000           C                  DW      0                   ;CLOSE
  CAC8    0000           C                  DW      0                   ;READ
  CACA    0000           C                  DW      0                   ;WRITE
  CACC    0000           C                  DW      0                   ;KONV
