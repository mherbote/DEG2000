                         C                  CP      4
                         C                  JP      Z,S4.SC704
                         C                  CP      3
                         C                  JR      Z,S4.SC705
                         C                  CP      2
                         C                  JR      Z,S4.SC706
                         C                  CP      1
                         C                  JR      Z,S4.SC707
