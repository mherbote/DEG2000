                         C      ;****************************************************************
  DCDF    DD 36 07 F0    C      K1.MRCLS:   LD      (IX+7),LOW(S0.PFFA)   ;Pufferadresse
  DCE3    DD 36 08 BB    C                  LD      (IX+8),HIGH(S0.PFFA)
