'Warteschleife'	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                         C      
                         C      ;****************************************************************
                         C      ;*               Warteschleife fuer Schnellschreiben            *
                         C      ;****************************************************************
  D485    DD E5          C      TA.WART:    PUSH    IX
  D487    DD 21 B243     C                  LD      IX,TS.ZEIT1
  D48B    DD 7E 01       C      TA.WART0:   LD      A,(IX+1)
  D48E    DD 96 00       C                  SUB     (IX+0)
  D491    DD 77 02       C                  LD      (IX+2),A
  D494    06 82          C                  LD      B,130
  D496    3A B242        C      TA.WART1:   LD      A,(TS.ZSMER)
  D499    B7             C                  OR      A
  D49A    28 27          C                  JR      Z,TA.WART2
  D49C    C5             C                  PUSH    BC
  D49D    CD D15F        C                  CALL    TA.TA1
  D4A0    C1             C                  POP     BC
  D4A1    20 20          C                  JR      NZ,TA.WART2
  D4A3    C5             C                  PUSH    BC
  D4A4    CD D177        C                  CALL    TA.TA2
  D4A7    C1             C                  POP     BC
  D4A8    21 B23C        C                  LD      HL,TS.TK
  D4AB    BE             C                  CP      (HL)
  D4AC    20 15          C                  JR      NZ,TA.WART2
  D4AE    10 E6          C                  DJNZ    TA.WART1
  D4B0    3A B246        C                  LD      A,(TS.ZSTC)
  D4B3    DD BE 02       C                  CP      (IX+2)
  D4B6    38 05          C                  JR      C,TA.WART3
  D4B8    DD BE 01       C                  CP      (IX+1)
  D4BB    28 0B          C                  JR      Z,TA.WART4
  D4BD    3C             C      TA.WART3:   INC     A
  D4BE    32 B246        C                  LD      (TS.ZSTC),A
  D4C1    18 C8          C                  JR      TA.WART0
                         C      
  D4C3    DD E1          C      TA.WART2:   POP     IX
  D4C5    C3 D343        C                  JP      TA.TFE
                         C      
  D4C8    DD 7E 02       C      TA.WART4:   LD      A,(IX+2)
  D4CB    32 B246        C                  LD      (TS.ZSTC),A
  D4CE    AF             C                  XOR     A
  D4CF    32 B23C        C                  LD      (TS.TK),A
  D4D2    DD E1          C                  POP     IX
  D4D4    C9             C                  RET
