  CAB4    80             C                  DB      10000000B           ;Typ - Kennsatz ja
  CAB5    C1             C                  DB      11000001B           ;Geraetebyte
                         C                  S3.RMOS 0,0,S0.AKB,2,0,0,S0.PFFI,100H,0,0,0
