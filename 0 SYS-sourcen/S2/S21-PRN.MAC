  D0F6    3A B196        C                  LD      A,(MS.DIREL)
  D0F9    CB 77          C                  BIT     6,A
  D0FB    28 E2          C                  JR      Z,MO.MZSL
  D0FD    F1             C                  POP     AF
  D0FE    DC CD75        C                  CALL    C,MO.DZPOL
  D101    C9             C                  RET
                         C      
  D102    CD CD75        C      MO.MZLN:    CALL    MO.DZPOL
  D105    F5             C                  PUSH    AF
  D106    3A B196        C                  LD      A,(MS.DIREL)
  D109    CB 77          C                  BIT     6,A
  D10B    28 D2          C                  JR      Z,MO.MZSL
  D10D    F1             C                  POP     AF
  D10E    DC CD7D        C                  CALL    C,MO.DSPOL
  D111    C9             C                  RET
                         C      
  D112    CD CE4D        C      MO.MZLS:    CALL    MO.IZPOL
