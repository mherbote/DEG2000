                         C      
                         C      S4.SC61:    LD      A,1
                         C                  RET
'BASIC- SVC - Routinen fuer Speichererweiterung'	MACRO-80 3.44	09-Dec-81	PAGE	1-176


                         C      
                         C      S4.SC62:    LD      A,2
