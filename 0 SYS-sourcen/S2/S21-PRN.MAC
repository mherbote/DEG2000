                         C                  LD      H,(IX-1)
                         C                  LD      L,(IX-2)
                         C                  PUSH    HL
                         C                  LD      HL,S4.UM14-2
                         C                  JR      S4.SC699
                         C      
                         C      
                         C      ;****************************************************************
                         C      ;*               allgemeine Organisation des Zusatzspeichers    *
                         C      ;****************************************************************
                         C      S4.SC600:   OR      A
