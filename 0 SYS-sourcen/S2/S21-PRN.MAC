'Kanal - Tabellen'	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                         C      
                         C      ;****************************************************************
                         C      ;*               K S K         Kennsatz-Section Kassette        *
                         C      ;****************************************************************
  CB35                   C      S3.KSK1     EQU     $                   ;Kassettengeraet 1
                         C      
  CB35                   C      S3.RCZ1     EQU     S3.KSK1             ;record counter
  CB37                   C      S3.BLK1     EQU     S3.RCZ1+2           ;block  counter
  CB39                   C      S3.MRP1     EQU     S3.BLK1+2           ;MRES - Parameterbereich
                         C      
                         C      
                         C      
  CB59                   C      S3.KSK2     EQU     S3.MRP1+32          ;Kassettengeraet 2
                         C      
  CB59                   C      S3.RCZ2     EQU     S3.KSK2             ;record counter
  CB5B                   C      S3.BLK2     EQU     S3.RCZ2+2           ;block  counter
  CB5D                   C      S3.MRP2     EQU     S3.BLK2+2           ;MRES - Parameterbereich
                         C      
                         C      
