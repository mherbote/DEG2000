  D064    CD CE72        C      MO.MZSO1:   CALL    MO.ISPOS
  D067    F5             C      MO.MZSO2:   PUSH    AF
  D068    D1             C                  POP     DE
  D069    F1             C                  POP     AF
  D06A    D5             C                  PUSH    DE
  D06B    32 B197        C                  LD      (MS.DIRES),A
  D06E    CB 77          C                  BIT     6,A
  D070    28 6D          C                  JR      Z,MO.MZSL
  D072    F1             C                  POP     AF
  D073    DC CE5F        C                  CALL    C,MO.IZPOS
  D076    C9             C                  RET
                         C      
  D077    CD CE72        C      MO.MZSO3:   CALL    MO.ISPOS
  D07A    20 EB          C                  JR      NZ,MO.MZSO2
  D07C    3A B18F        C                  LD      A,(MS.SMIN)
  D07F    3D             C                  DEC     A
  D080    32 B18D        C                  LD      (MS.SPOS),A
  D083    18 E2          C                  JR      MO.MZSO2
                         C      
