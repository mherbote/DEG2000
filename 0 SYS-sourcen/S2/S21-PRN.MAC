                         C                  LD      C,(IX+8)
                         C                  LD      A,(IX+6)
                         C                  LD      H,(IX+5)
                         C                  LD      L,(IX+4)
                         C                  PUSH    HL
                         C                  LD      H,(IX+11)
                         C                  LD      L,(IX+10)
                         C      
                         C      S4.SC709:   LD      (IY+0),D
                         C                  LD      (IY+1),E
                         C                  LD      (IY+4),B
                         C                  LD      (IY+11),C
                         C                  LD      (IY+12),A
                         C                  LD      (IY+5),L
                         C                  LD      (IY+6),H
                         C                  POP     HL
                         C                  LD      (IY+19),L
                         C                  LD      (IY+20),H
                         C                  JR      SC701
                         C                                              ;op = 4  ...  Standard-Anwender-Kode
                         C      S4.SC704:   LD      HL,LR.KONV
                         C                  PUSH    HL
                         C                  LD      A,(IX+2)
