                         C                  PAGE
'K M B G  READ-Routinen'	MACRO-80 3.44	09-Dec-81	PAGE	1-93


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G    READ - Routine : einen Block ===> KS.PUFFS       *
                         C      ;****************************************************************
  D8B7    DD 36 04 02    C      K1.GNRD:    LD      (IX+4),02H          ;CMD  wiedergabe
  D8BB    CD D56D        C                  CALL    K1.ARMB
  D8BE    CD D631        C                  CALL    K1.F17
  D8C1    CD D5D3        C                  CALL    K1.ARBT
  D8C4    CD D62B        C                  CALL    K1.BM
  D8C7    28 E9          C                  JR      Z,K1.RD1
  D8C9    CD D5FA        C                  CALL    K1.RCZP
  D8CC    CD F653        C      K1.PUFT:    CALL    S0.KRZU             ;Kass.puffer V1.1 aktivieren
  D8CF    CD D61E        C                  CALL    K1.LHLBC            ;Kass.puffer V1.1 ===> V2.1
  D8D2    11 B014        C                  LD      DE,KS.PUFFS+1
  D8D5    DD 72 08       C                  LD      (IX+8),D
  D8D8    DD 73 07       C                  LD      (IX+7),E
  D8DB    ED B0          C                  LDIR
  D8DD    CD B2D4        C                  CALL    S2.STACK            ;Kass.puffer V1.1 entaktivieren
  D8E0    C9             C                  RET
                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G    READ - Routine :  Speicherbereich fuellen        *
                         C      ;****************************************************************
  D8E1    2A B126        C      K1.GNRDR:   LD      HL,(K2.TXANF)
  D8E4    22 B124        C                  LD      (K2.TXOP),HL
                         C      
  D8E7    2A B128        C      K1.GNRZ:    LD      HL,(K2.TXEND)
  D8EA    ED 4B B124     C                  LD      BC,(K2.TXOP)
  D8EE    B7             C                  OR      A
  D8EF    ED 42          C                  SBC     HL,BC
  D8F1    28 2D          C                  JR      Z,K1.GNRZE
  D8F3    FA D920        C                  JP      M,K1.GNRZE
  D8F6    DD CB FF 5E    C                  BIT     3,(IX-1)            ;Verarbeitungsbit  NL/SL  ?
  D8FA    20 05          C                  JR      NZ,$+7
  D8FC    01 0100        C                  LD      BC,256              ;no       label
  D8FF    18 03          C                  JR      $+5
  D901    01 0080        C                  LD      BC,128              ;standard label
  D904    ED 42          C                  SBC     HL,BC
  D906    FA D920        C                  JP      M,K1.GNRZE
                         C      
  D909    CD D8B7        C                  CALL    K1.GNRD
                         C      
  D90C    CD D62B        C                  CALL    K1.BM
  D90F    28 0F          C                  JR      Z,K1.GNRZE
  D911    CD D61E        C                  CALL    K1.LHLBC
  D914    ED 5B B124     C                  LD      DE,(K2.TXOP)
  D918    ED B0          C                  LDIR
  D91A    ED 53 B124     C                  LD      (K2.TXOP),DE
  D91E    18 C7          C                  JR      K1.GNRZ
                         C      
  D920    2A B124        C      K1.GNRZE:   LD      HL,(K2.TXOP)
  D923    22 B128        C                  LD      (K2.TXEND),HL
  D926    C9             C                  RET
                         C      
                         C                  TITLE   'K M B G  WRITE-Routinen'
                         C                  PAGE
'K M B G  WRITE-Routinen'	MACRO-80 3.44	09-Dec-81	PAGE	1-94


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G    WRITE - Routine :  einen Block schreiben         *
                         C      ;****************************************************************
  D927    CD D61E        C      K1.GNWR:    CALL    K1.LHLBC            ;Ausgabeblock ==> KS.PUFFS von V2
  D92A    11 B014        C                  LD      DE,KS.PUFFS+1
  D92D    DD 72 08       C                  LD      (IX+8),D
  D930    DD 73 07       C                  LD      (IX+7),E
  D933    ED B0          C                  LDIR
  D935    E5             C                  PUSH    HL
  D936    DD 36 04 00    C                  LD      (IX+4),00H          ;CMD write record mit RAW
  D93A    CD D56D        C                  CALL    K1.ARMB
  D93D    CD D5D3        C                  CALL    K1.ARBT
  D940    CD D5FA        C                  CALL    K1.RCZP
  D943    E1             C                  POP     HL
  D944    DD 74 08       C                  LD      (IX+8),H
  D947    DD 75 07       C                  LD      (IX+7),L
  D94A    C9             C                  RET
                         C      ;****************************************************************
                         C      ;*  K M B G    WRITE - Routine :   einen Block zurueckschreiben *
                         C      ;****************************************************************
  D94B    E5             C      K1.GNRWR:   PUSH    HL                  ;Pufferadresse
  D94C    C5             C                  PUSH    BC                  ;Pufferlaenge
  D94D    DD 36 04 02    C                  LD      (IX+4),2            ;CMD  wiedergabe
  D951    CD D56D        C                  CALL    K1.ARMB
  D954    CD D631        C                  CALL    K1.F17
  D957    CD D5D3        C                  CALL    K1.ARBT
  D95A    CD D5FA        C                  CALL    K1.RCZP
  D95D    E1             C                  POP     HL                  ;neue Blocklaenge
  D95E    E5             C                  PUSH    HL
  D95F    DD 46 09       C                  LD      B,(IX+9)            ;alte Blocklaenge
  D962    DD 4E 0A       C                  LD      C,(IX+10)
  D965    B7             C                  OR      A
  D966    ED 42          C                  SBC     HL,BC               ;alte = neue Blocklaenge ?
  D968    20 29          C                  JR      NZ,K1.GNRW3         ;Z-FF=0 ... Block nicht zur.geschr.
  D96A    DD 36 04 15    C                  LD      (IX+4),15H          ;CMD ein block zurueck
  D96E    CD D56D        C                  CALL    K1.ARMB
  D971    CD D5D3        C                  CALL    K1.ARBT
  D974    C1             C                  POP     BC
  D975    E1             C                  POP     HL
  D976    11 B014        C      K1.GNRW2:   LD      DE,KS.PUFFS+1
  D979    DD 72 08       C                  LD      (IX+8),D
  D97C    DD 73 07       C                  LD      (IX+7),E
  D97F    DD 70 09       C                  LD      (IX+9),B
  D982    DD 71 0A       C                  LD      (IX+10),C
  D985    ED B0          C                  LDIR
  D987    DD 36 04 08    C      K1.GNRW1:   LD      (IX+4),8            ;CMD write record ohne RAW
  D98B    CD D56D        C                  CALL    K1.ARMB
  D98E    CD D5D3        C                  CALL    K1.ARBT
  D991    AF             C                  XOR     A                   ;Z-FF=1 ... Block zurueckgeschr.
  D992    C9             C                  RET
  D993    C1             C      K1.GNRW3:   POP     BC
  D994    E1             C                  POP     HL
  D995    C9             C                  RET
                         C      
                         C                  PAGE
'K M B G  WRITE-Routinen'	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                         C      
                         C      ;****************************************************************
                         C      ;*  K M B G    WRITE - Routine :  aus Speicherbereich ausgeben  *
                         C      ;****************************************************************
  D996    2A B126        C      K1.GNWRT:   LD      HL,(K2.TXANF)
  D999    DD 75 07       C                  LD      (IX+7),L            ;Pufferadresse ===> E/A-Tabelle
  D99C    DD 74 08       C                  LD      (IX+8),H
  D99F    DD CB FF 5E    C                  BIT     3,(IX-1)            ;Verarbeitungsbit  NL/SL  ?
  D9A3    20 05          C                  JR      NZ,$+7
  D9A5    21 0100        C                  LD      HL,256              ;no       label
  D9A8    18 03          C                  JR      $+5
  D9AA    21 0080        C                  LD      HL,128              ;standard label
  D9AD    DD 74 09       C                  LD      (IX+9),H            ;Pufferlaenge  ===> E/A-Tabelle
  D9B0    DD 75 0A       C                  LD      (IX+10),L
                         C      
  D9B3    2A B128        C      K1.GNZKL:   LD      HL,(K2.TXEND)       ;Endeadresse Text
  D9B6    DD 56 08       C                  LD      D,(IX+8)            ;operative Anfangsadresse
  D9B9    DD 5E 07       C                  LD      E,(IX+7)
  D9BC    B7             C                  OR      A
  D9BD    ED 52          C                  SBC     HL,DE               ;noch auszugeb. Textlaenge
  D9BF    28 38          C                  JR      Z,K1.WRTEN          ;Ende bei Textlaenge gleich Null
  D9C1    FA D9F9        C                  JP      M,K1.WRTEN
  D9C4    22 B120        C                  LD      (K2.BLZ),HL         ;merken Textlaenge
  D9C7    DD CB FF 5E    C                  BIT     3,(IX-1)            ;Verarbeitungsbit  NL/SL  ?
  D9CB    20 05          C                  JR      NZ,$+7
  D9CD    11 0100        C                  LD      DE,256              ;no       label
  D9D0    18 03          C                  JR      $+5
  D9D2    11 0080        C                  LD      DE,128              ;standard label
  D9D5    B7             C                  OR      A
  D9D6    ED 52          C                  SBC     HL,DE               ;Textlaenge groesser LRECL
  D9D8    F2 D9F4        C                  JP      P,K1.GNTS1
  D9DB    19             C                  ADD     HL,DE               ;reset
  D9DC    11 0020        C                  LD      DE,32
  D9DF    B7             C                  OR      A
  D9E0    ED 52          C                  SBC     HL,DE
  D9E2    F2 D9EA        C                  JP      P,K1.GNTS2          ;Satz groesser 32 Byte
                         C      ; Korrektur fuer Saetze kleiner 32 Byte
  D9E5    3E 20          C                  LD      A,32                ;L-Teil der Textlaenge
  D9E7    32 B120        C                  LD      (K2.BLZ),A
                         C      ; Modifikation Record-Laenge
  D9EA    3A B120        C      K1.GNTS2:   LD      A,(K2.BLZ)
  D9ED    DD 36 09 00    C                  LD      (IX+9),0            ;Ausgabelaenge setzen
  D9F1    DD 77 0A       C                  LD      (IX+10),A
                         C      ; Ausgabe eines Blockes
  D9F4    CD D927        C      K1.GNTS1:   CALL    K1.GNWR
  D9F7    18 BA          C                  JR      K1.GNZKL
                         C      ; Aufrufende
  D9F9    C9             C      K1.WRTEN:   RET
                         C      
