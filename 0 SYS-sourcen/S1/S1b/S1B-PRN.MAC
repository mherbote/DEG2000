'Kommandos: KRDx und KWRx'	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                         C      
                         C      ;           PN      KH
                         C      ;**********************************************************************
                         C      ;
                         C      ;   Kommando:
                         C      ;        KRDx...Block einlesen und anzeigen
                         C      ;               zusaetlich werden die entsprechenden Puffer-
                         C      ;               adressen angezeigt.
                         C      ;        KWRx...Block schreiben, standardmaessig nach 'KRDx'
                         C      ;               Ansonsten muessen Blockadresse und Blocklaenge in der
                         C      ;               Verstaendigungstabelle eingetragen werden.
                         C      ;
                         C      ;**********************************************************************
  6666*   6666*          C                  DW      $
  6668*   4B 52 57 31    C                  DB      'KRW1'
  666C*   18 06          C                  JR      KH.RDSTA
                         C      ;
  666E*   666E*          C                  DW      $
  6670*   4B 52 57 32    C                  DB      'KRW2'
  6674*                  C      KH.RDSTA:
  6674*   CD 54E2*       C                  CALL    U1.KTINI            ;Initialisierung E/A-Tab.
  6677*   3A 3325        C                  LD      A,(UE.BWSA + 10*80 + 5) ;325H i von KRDi
  667A*   E6 0F          C                  AND     0FH
  667C*   DD 77 03       C                  LD      (IX+3),A            ;Subadresse eintragen
  667F*                  C      KH.RES:
  667F*                  C      KH.KSRE:
  667F*   CD 60A1*       C                  CALL    UR.KRE              ;Reservieren
  6682*                  C      KH.RD1:
  6682*                  C      KH.KSRW:
  6682*   DD 36 04 21    C                  LD      (IX+4),021H         ;umspulen (rewind)
  6686*   CD 5D2F*       C                  CALL    UF.EXEC
  6689*   C3 670E*       C                  JP       KH.RDBA
                         C      ;
                         C      ;           Z Y K L U S  ueber Tastatureingaben
  668C*                  C      KH.RD3:                                 ;Zyklus
  668C*   DD 36 0A 00    C                  LD      (IX+10),0           ;Anzahl Bandmarken
  6690*   CD 5A88*       C                  CALL    UR.TAREP            ;Tastaturabfrage
  6693*   FE 80          C                  CP      080H
  6695*   28 E8          C                  JR      Z,KH.KSRE           ;---> P 01 Reservieren EIN
  6697*   FE 82          C                  CP      082H
  6699*   28 2A          C                  JR      Z,KH.KSRA           ;---> P 03 Reservieren AUS
  669B*   FE 81          C                  CP      081H
  669D*   28 E3          C                  JR      Z,KH.KSRW           ;---> P 02 Rewind
                         C      
  669F*   FE 83          C                  CP      083H
  66A1*   28 31          C                  JR      Z,KH.KSRP           ;---> P 04         read; display
  66A3*   FE 85          C                  CP      085H
  66A5*   28 2A          C                  JR      Z,KH.KSRM           ;---> P 06 R-; R-; read; display
                         C      
  66A7*   DD 36 0A 01    C                  LD      (IX+10),1           ;Anzahl Bandmarken
  66AB*   FE 86          C                  CP      086H
  66AD*   28 3C          C                  JR      Z,KH.BMP            ;---> P07 BM+
  66AF*   FE 88          C                  CP      088H
  66B1*   28 40          C                  JR      Z,KH.BMM            ;---> P09 BM-
                         C      
  66B3*   FE 89          C                  CP      089H
  66B5*   28 41          C                  JR      Z,KH.WREC           ;---> P10 write Record
  66B7*   FE 8A          C                  CP      08AH
  66B9*   28 49          C                  JR      Z,KH.WBM            ;---> P11 write BM
  66BB*   FE 8B          C                  CP      08BH
  66BD*   28 47          C                  JR      Z,KH.WSL            ;---> P11 write SL
                         C      
  66BF*   FE CD          C                  CP      0CDH
  66C1*   28 45          C                  JR      Z,KH.SYSRT          ;---> SYS
                         C      
  66C3*   18 C7          C                  JR      KH.RD3
                         C      
                         C      ;           P 03    Reservieren AUS
  66C5*                  C      KH.KSRA:
  66C5*   DD 36 04 21    C                  LD      (IX+4),021H         ;umspulen (rewind)
  66C9*   CD 5D2F*       C                  CALL    UF.EXEC
  66CC*   CD 60B3*       C                  CALL    UR.KRA
  66CF*   18 3D          C                  JR       KH.RDBA
                         C      
                         C      ;           P 06    R-                  ; R-              ; read        ; display
  66D1*                  C      KH.KSRM:
  66D1*   CD 6770*       C                  CALL    KH.RD2
                         C      ;           P 04    read                ; display
  66D4*                  C      KH.KSRP:
  66D4*   DD 36 04 02    C                          LD (IX+4),002H      ;naechst Record lesen
  66D8*   CD 5D2F*       C                  CALL    UF.EXEC
  66DB*   DD 7E 0A       C                  LD      A,(IX+10)           ;Lade die Laenge des Blockes
'Kommandos: KRDx und KWRx'	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  66DE*   FE 01          C                  CP      1                   ;Laenge = 1, dann BandMarke
  66E0*   28 3D          C                  JR      Z,KH.RDBM
  66E2*   FE 02          C                  CP      2                   ;Laenge = 2, dann Schlussluecke
  66E4*   28 4A          C                  JR      Z,KH.RDSL
  66E6*   CD 6741*       C                  CALL    KH.ANZBL            ;Block anzeigen
  66E9*   18 A1          C                  JR      KH.RD3
                         C      
                         C      ;           P 07    BM+
  66EB*                  C      KH.BMP:
  66EB*   CD 60B9*       C                  CALL    UR.KLV              ;Bandmarke vorsetzen
  66EE*   CD 60D7*       C                  CALL    UR.KBR              ;Record    zuruecksetzen
  66F1*   18 E1          C                  JR      KH.KSRP
                         C      ;           P 09    BM-
  66F3*                  C      KH.BMM:
  66F3*   CD 60BF*       C                  CALL    UR.KLR              ;Bandmarke zurC<cksetzen
  66F6*   18 DC          C                  JR      KH.KSRP
                         C      
                         C      ;           P 10    write Record
  66F8*                  C      KH.WREC:
  66F8*   DD 36 04 08    C                  LD      (IX+4),08H
  66FC*   CD 5D2F*       C                  CALL    UF.EXEC
  66FF*   CD 60D7*       C                  CALL    UR.KBR
  6702*   18 88          C                  JR      KH.RD3
                         C      
                         C      ;           P 11    write BM
  6704*                  C      KH.WBM:
  6704*   18 86          C                  JR      KH.RD3
                         C      
                         C      ;           P 12    write SL
  6706*                  C      KH.WSL:
  6706*   18 84          C                  JR      KH.RD3
                         C      
                         C      ;           SYS      Systemruecksprung
  6708*                  C      KH.SYSRT:
  6708*   CD 67EA*       C                  CALL    KH.BILO
  670B*   C3 000B        C                  JP      SY.SYSTB
                         C      
  670E*                  C      KH.RDBA:
  670E*   CD 67EA*       C                  CALL    KH.BILO
  6711*   21 601D*       C                  LD      HL,UA.ZKBA          ;"Bandanfang"
  6714*   11 3000        C                  LD      DE,UE.BWSA
  6717*   01 000A        C                  LD      BC,UA.ZKBM-UA.ZKBA
  671A*   ED B0          C                  LDIR
  671C*   C3 668C*       C                  JP      KH.RD3
                         C      
  671F*                  C      KH.RDBM:
  671F*   CD 67EA*       C                  CALL    KH.BILO
  6722*   21 6027*       C                  LD      HL,UA.ZKBM          ;"Bandmarke"
  6725*   11 3000        C                  LD      DE,UE.BWSA
  6728*   01 0009        C                  LD      BC,UA.ZKSL-UA.ZKBM
  672B*   ED B0          C                  LDIR
  672D*   C3 668C*       C                  JP      KH.RD3
                         C      
  6730*                  C      KH.RDSL:
  6730*   CD 67EA*       C                  CALL    KH.BILO
  6733*   21 6030*       C                  LD      HL,UA.ZKSL          ;"Schlussluecke"
  6736*   11 3000        C                  LD      DE,UE.BWSA
  6739*   01 000D        C                  LD      BC,UA.ZKEE-UA.ZKSL
  673C*   ED B0          C                  LDIR
  673E*   C3 668C*       C                  JP      KH.RD3
                         C      
  6741*                  C      KH.ANZBL:
  6741*   CD 67EA*       C                  CALL    KH.BILO
  6744*                  C      KH.ANZB1:
  6744*   21 0E65        C                  LD      HL,UE.PUF
  6747*   FE 20          C                  CP      020H
  6749*   20 04          C                  JR      NZ,KH.ANZB2
  674B*   06 02          C                  LD      B,2                 ; 2 Zeilen anzeigen
  674D*   18 0A          C                  JR      KH.ANZB4
  674F*                  C      KH.ANZB2:
  674F*   FE 80          C                  CP      080H
  6751*   20 04          C                  JR      NZ,KH.ANZB3
  6753*   06 08          C                  LD      B,8                 ; 8 Zeilen anzeigen
  6755*   18 02          C                  JR      KH.ANZB4
  6757*                  C      KH.ANZB3:
  6757*   06 18          C                  LD      B,24                ; 24 Zeilen anzeigen
  6759*                  C      KH.ANZB4:
  6759*   CD 675D*       C                  CALL    KH.AZBLD            ;Bild anzeigen (24 Zeilen)
  675C*   C9             C                  RET                         ; IN...HL:=akt. Pufferadresse
                         C      
  675D*                  C      KH.AZBLD:
  675D*   11 3000        C                  LD      DE,UE.BWSA
  6760*                  C      KH.AZBL1:
'Kommandos: KRDx und KWRx'	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  6760*   C5             C                  PUSH    BC
  6761*   CD 6779*       C                  CALL    KH.AZ1Z             ; 1 Zeile anzeigen
  6764*   C1             C                  POP     BC
  6765*   E5             C                  PUSH    HL                  ;akt. Pufferadresse retten
  6766*   EB             C                  EX      DE,HL
  6767*   11 0050        C                  LD      DE,80
  676A*   19             C                  ADD     HL,DE               ;neuen Zeilenanfang berechnen
  676B*   EB             C                  EX      DE,HL
  676C*   E1             C                  POP     HL
  676D*   10 F1          C                  DJNZ    KH.AZBL1
  676F*   C9             C                  RET
                         C      
  6770*                  C      KH.RD2:
  6770*   F5             C                  PUSH    AF                  ;Flags retten
  6771*   CD 60D7*       C                  CALL    UR.KBR              ;Block ruecksetzen
  6774*   CD 60D7*       C                  CALL    UR.KBR
  6777*   F1             C                  POP     AF
  6778*   C9             C                  RET
                         C      ;                                IN...HL:= Pufferadresse
                         C      ;                                     DE:= Zeilenanfang
  6779*                  C      KH.AZ1Z:
  6779*   D5             C                  PUSH    DE                  ;eine Zeile anzeigen
  677A*   E5             C                  PUSH    HL
  677B*   D5             C                  PUSH    DE
  677C*   E1             C                  POP     HL
  677D*   01 0040        C                  LD      BC,64
  6780*   09             C                  ADD     HL,BC
  6781*   E5             C                  PUSH    HL
  6782*   C1             C                  POP     BC                  ;BC:= Anfang ASCII-Darstellung
  6783*   E1             C                  POP     HL
  6784*   CD 679D*       C                  CALL    KH.AZADR            ;Adresse anzeigen
  6787*   13             C                  INC     DE
  6788*   13             C                  INC     DE
  6789*   CD 67A6*       C                  CALL    KH.AZ4BY            ;1. Vierergruppe
  678C*   13             C                  INC     DE
  678D*   13             C                  INC     DE
  678E*   CD 67A6*       C                  CALL    KH.AZ4BY            ;2.      ''
  6791*   13             C                  INC     DE
  6792*   13             C                  INC     DE
  6793*   CD 67A6*       C                  CALL    KH.AZ4BY            ;3.      ''
  6796*   13             C                  INC     DE
  6797*   13             C                  INC     DE
  6798*   CD 67A6*       C                  CALL    KH.AZ4BY            ;4.      ''
  679B*   D1             C                  POP     DE
  679C*   C9             C                  RET
  679D*                  C      KH.AZADR:
  679D*   7C             C                  LD      A,H                 ;Anzeige der Adresse
  679E*   CD 56A5*       C                  CALL    UC.CVBX+2
  67A1*   7D             C                  LD      A,L
  67A2*   CD 56A5*       C                  CALL    UC.CVBX+2
  67A5*   C9             C                  RET
  67A6*                  C      KH.AZ4BY:
  67A6*   AF             C                  XOR     A                   ;Anzeige einer Vierergruppe
  67A7*   32 2B26*       C                  LD      (UB.PAR1),A
  67AA*                  C      KH.AZ4B0:
  67AA*   7E             C                  LD      A,(HL)
  67AB*   F5             C                  PUSH    AF
  67AC*   CD 56A5*       C                  CALL    UC.CVBX+2           ;Code als Hexadezimalzahl
  67AF*   F1             C                  POP     AF
  67B0*   13             C                  INC     DE
  67B1*   23             C                  INC     HL
  67B2*   FE 20          C                  CP      20H
  67B4*   38 15          C                  JR      C,KH.AZ4B1          ;nicht darstellbar
  67B6*   FE 7F          C                  CP      7FH
  67B8*   30 11          C                  JR      NC,KH.AZ4B1         ;nicht darstellbar
  67BA*                  C      KH.AZ4B3:
  67BA*   02             C                  LD      (BC),A              ;Code als ASCII-Zeichen
  67BB*   03             C                  INC     BC
  67BC*   CD 67CF*       C                  CALL    KH.BLEVG            ;Test auf Blockende
  67BF*   3A 2B26*       C                  LD      A,(UB.PAR1)
  67C2*   3C             C                  INC     A
  67C3*   FE 04          C                  CP      4
  67C5*   C8             C                  RET     Z
  67C6*   32 2B26*       C                  LD      (UB.PAR1),A
  67C9*   18 DF          C                  JR      KH.AZ4B0
  67CB*                  C      KH.AZ4B1:
  67CB*   3E 7F          C                  LD      A,07FH
  67CD*   18 EB          C                  JR      KH.AZ4B3
  67CF*                  C      KH.BLEVG:
  67CF*   D5             C                  PUSH    DE                  ;Blockendetest
  67D0*   E5             C                  PUSH    HL
  67D1*   11 0E65        C                  LD      DE,UE.PUF           ;DE:= Pufferanfang
  67D4*   B7             C                  OR      A
'Kommandos: KRDx und KWRx'	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  67D5*   ED 52          C                  SBC     HL,DE               ;HL:= Anzahl der angezeigten
  67D7*   EB             C                  EX      DE,HL
  67D8*   CD 5611*       C                  CALL    XY.LIDX
  67DB*   09             C                  DB      9
  67DC*   B7             C                  OR      A
  67DD*   ED 52          C                  SBC     HL,DE
  67DF*   E1             C                  POP     HL
  67E0*   D1             C                  POP     DE
  67E1*   28 01          C                  JR      Z,KH.BLEV1
  67E3*   C9             C                  RET
  67E4*                  C      KH.BLEV1:
  67E4*   06 0C          C                  LD      B,12
  67E6*                  C      KH.BLEV2:
  67E6*   33             C                  INC     SP
  67E7*   10 FD          C                  DJNZ    KH.BLEV2
  67E9*   C9             C                  RET                         ;---> Anzeige beendet
                         C      
                         C      ;----------------------------------------------------
  67EA*                  C      KH.BILO:
  67EA*   21 3000        C                  LD      HL,UE.BWSA
  67ED*   01 077F        C                  LD      BC,24*80 -1         ;800H
  67F0*   36 20          C                  LD      (HL),20H
  67F2*   E5             C                  PUSH    HL
  67F3*   D1             C                  POP     DE
  67F4*   13             C                  INC     DE
  67F5*   ED B0          C                  LDIR
  67F7*   C9             C                  RET
                         C      ;------------------------------------------------------
                         C      ;           END
                         C                  TITLE   'Ein-/Ausgabe im freien Format'
                         C                  PAGE
'Ein-/Ausgabe im freien Format'	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                         C      
                         C      ;           PN      FD
                         C      ;**********************************************************************
                         C      ;
                         C      ;      Ein-/Ausgabe von Dateien im freien Format in bzw. aus dem
                         C      ;      Editorraum von bzw. auf MRES-Kassetten
                         C      ;
                         C      ;**********************************************************************
                         C      ;      Positionieren auf Datei, IN: <C>:= Labelnummer
                         C      ;
  67F8*                  C      FD.POSK:
  67F8*   C5             C                  PUSH    BC
  67F9*   41             C                  LD      B,C
  67FA*   04             C                  INC     B
  67FB*   CD 60E6*       C                  CALL    UR.POSIK
  67FE*   CD 6810*       C                  CALL    FD.KO01
  6801*   3A 0E65        C                  LD      A,(UE.PUF)
  6804*   B9             C                  CP      C
  6805*   C1             C                  POP     BC
  6806*   20 01          C                  JR      NZ,$+3
  6808*   C9             C                  RET
  6809*   D1             C                  POP     DE
  680A*   3E 94          C                  LD      A,94H
  680C*   CD 5D61*       C                  CALL    UF.ERANZ
  680F*   C9             C                  RET
                         C      ;
  6810*                  C      FD.KO01:
  6810*   DD 36 04 02    C                  LD      (IX+4),002H         ;FUER FD19
  6814*   C3 5D2F*       C                  JP      UF.EXEC
                         C      ;----------------------------------------------------------------------
                         C      ;      Datei im Verzeichnis suchen
                         C      ;      HL:= Dateiname, <B>:= Anzahl Verzeichniseintragungen + 1
                         C      ;      <D>:= Dateityp
                         C      ;      O:  CY:= 0 Datei nicht vorhanden, <C> unveraendert
                         C      ;          CY:= 1 <C>:= Labelnummer
                         C      ;      K:  B
  6817*                  C      FD.DASU:
  6817*   D5             C                  PUSH    DE
  6818*   05             C                  DEC     B
  6819*   28 0A          C                  JR      Z,$+12
  681B*   CD 6810*       C                  CALL    FD.KO01
  681E*   CD 54C7*       C                  CALL    U1.NMVGL
  6821*   38 05          C                  JR      C,$+7
  6823*   10 F6          C                  DJNZ    $-8
  6825*   B7             C                  OR      A
  6826*   D1             C                  POP     DE
  6827*   C9             C                  RET
  6828*   5F             C                  LD      E,A
  6829*   3A 0E6B        C                  LD      A,(UE.PUF+6)
  682C*   BA             C                  CP      D
  682D*   20 F4          C                  JR      NZ,$-10
  682F*   4B             C                  LD      C,E
  6830*   37             C                  SCF
  6831*   18 F3          C                  JR      $-11
                         C      ;----------------------------------------------------------------------
                         C      ;      Reservebloecke schreiben
                         C      ;
  6833*                  C      FD.WRRES:
  6833*   C5             C                  PUSH    BC
  6834*   D5             C                  PUSH    DE
  6835*   E5             C                  PUSH    HL
  6836*   21 5FCF*       C                  LD      HL,UA.ZKRES
  6839*   CD 595C*       C                  CALL    UR.MIMO
  683C*   EB             C                  EX      DE,HL
  683D*   CD 5761*       C                  CALL    UC.CVDB
  6840*   7C             C                  LD      A,H
  6841*   B5             C                  OR      L
  6842*   20 04          C                  JR      NZ,$+6
  6844*   E1             C                  POP     HL
  6845*   D1             C                  POP     DE
  6846*   C1             C                  POP     BC
  6847*   C9             C                  RET
  6848*   E5             C                  PUSH    HL
  6849*   21 0E65        C                  LD      HL,UE.PUF
  684C*   01 0090        C                  LD      BC,90H
  684F*   CD 5411*       C                  CALL    U1.CLRB
  6852*   21 0080        C                  LD      HL,80H
  6855*   CD 5631*       C                  CALL    XY.STIDX
  6858*   09             C                  DB      9
  6859*   E1             C                  POP     HL
  685A*   CD 6236*       C                  CALL    UK.KBA
  685D*   2B             C                  DEC     HL
'Ein-/Ausgabe im freien Format'	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  685E*   7C             C                  LD      A,H
  685F*   B5             C                  OR      L
  6860*   20 E6          C                  JR      NZ,$-24
  6862*   18 E0          C                  JR      $-30
                         C      ;----------------------------------------------------------------------
                         C      ;      F/S - Datei in den Editorraum einlesen
                         C      ;
