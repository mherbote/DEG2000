  65FF*   ED B0          C                  LDIR                        ;Ruecktransport BWSA--->VTABE
  6601*   23             C                  INC     HL
  6602*   23             C                  INC     HL
  6603*   23             C                  INC     HL
  6604*   01 0002        C                  LD      BC,2
  6607*   ED B0          C                  LDIR
  6609*   23             C                  INC     HL
  660A*   23             C                  INC     HL
  660B*   23             C                  INC     HL
  660C*   C1             C                  POP     BC
  660D*   C5             C                  PUSH    BC
  660E*   ED B0          C                  LDIR
  6610*   23             C                  INC     HL
  6611*   23             C                  INC     HL
  6612*   23             C                  INC     HL
  6613*   C1             C                  POP     BC
  6614*   ED B0          C                  LDIR
  6616*   23             C                  INC     HL
  6617*   23             C                  INC     HL
  6618*   23             C                  INC     HL
  6619*   01 0003        C                  LD      BC,3
  661C*   ED B0          C                  LDIR
  661E*   23             C                  INC     HL
  661F*   23             C                  INC     HL
  6620*   23             C                  INC     HL
  6621*   D5             C                  PUSH    DE
  6622*   EB             C                  EX      DE,HL
  6623*   CD 662A*       C                  CALL    KV.DBCVM
  6626*   7D             C                  LD      A,L
  6627*   E1             C                  POP     HL
  6628*   77             C                  LD      (HL),A
