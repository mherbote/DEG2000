  60A9*   DD 36 04 21    C                  LD      (IX+4),21H
  60AD*   18 F6          C                  JR      UR.KRE1             ;Umspulen
  60AF*                  C      UR.KRWW:
  60AF*   CD 60A9*       C                  CALL    UR.KRW
  60B2*   C9             C                  RET
  60B3*                  C      UR.KRA:
  60B3*   DD 36 04 41    C                  LD      (IX+4),41H
  60B7*   18 EC          C                  JR      UR.KRE1             ;Reservieren aus
  60B9*                  C      UR.KLV:
  60B9*   DD 36 04 71    C                  LD      (IX+4),71H
  60BD*   18 E6          C                  JR      UR.KRE1             ;Label vorsetzen
  60BF*                  C      UR.KLR:
  60BF*   DD 36 04 75    C                  LD      (IX+4),75H
  60C3*   18 E0          C                  JR      UR.KRE1             ;LABEL RUECKSETZEN
  60C5*                  C      UR.KBM:
  60C5*   DD 36 04 51    C                  LD      (IX+4),51H
  60C9*   18 DA          C                  JR      UR.KRE1             ;BANDMARKE SCHREIBEN
  60CB*                  C      UR.KSL:
  60CB*   DD 36 04 61    C                  LD      (IX+4),61H
  60CF*   18 D4          C                  JR      UR.KRE1             ;SCHLUSSLUECKE SCHREIBEN
  60D1*                  C      UR.KBV:
  60D1*   DD 36 04 11    C                  LD      (IX+4),11H
  60D5*   18 CE          C                  JR      UR.KRE1             ;Block vorsetzen
  60D7*                  C      UR.KBR:
  60D7*   DD 36 04 15    C                  LD      (IX+4),15H
  60DB*   18 C8          C                  JR      UR.KRE1
                         C      ;--------------------------------------------------------------------
  60DD*                  C      UR.RPOS:
  60DD*   E5             C                  PUSH    HL
  60DE*   D5             C                  PUSH    DE
  60DF*   F5             C                  PUSH    AF
  60E0*   C5             C                  PUSH    BC
  60E1*   AF             C                  XOR     A
  60E2*   3D             C                  DEC     A
  60E3*   4F             C                  LD      C,A
  60E4*   18 06          C                  JR      POSIK1
  60E6*                  C      UR.POSIK:
  60E6*   E5             C                  PUSH    HL
  60E7*   D5             C                  PUSH    DE
  60E8*   F5             C                  PUSH    AF
  60E9*   C5             C                  PUSH    BC                  ;Positionieren
  60EA*   AF             C                  XOR     A
  60EB*   4F             C                  LD      C,A
  60EC*                  C      POSIK1:
  60EC*   06 00          C                  LD      B,0
  60EE*   11 0000        C                  LD      DE,0
  60F1*                  C      UR.LES:
  60F1*   DD 36 04 02    C                  LD      (IX+4),02H
  60F5*   CD 5D2F*       C                  CALL    UF.EXEC             ;BLOCK LESEN
  60F8*   DD 7E 0A       C                  LD      A,(IX+10)
  60FB*   FE 01          C                  CP      1                   ;BANDMARKE?
  60FD*   28 19          C                  JR      Z,UR.BM
  60FF*   04             C                  INC     B                   ;ANZAHL BLOECKE
  6100*   78             C                  LD      A,B
  6101*   FE 04          C                  CP      4
  6103*   28 21          C                  JR      Z,UR.OK
  6105*   21 0000        C                  LD      HL,0
  6108*   CD 5611*       C                  CALL    XY.LIDX
  610B*   09             C                  DB      9                   ;HL<--BLOCKLAENGE
  610C*   19             C                  ADD     HL,DE
  610D*   EB             C                  EX      DE,HL
  610E*   21 012C        C                  LD      HL,300
  6111*   B7             C                  OR      A
  6112*   ED 52          C                  SBC     HL,DE
  6114*   38 10          C                  JR      C,UR.OK
  6116*   18 D9          C                  JR      UR.LES
  6118*                  C      UR.BM:
  6118*   AF             C                  XOR     A
  6119*   B1             C                  OR      C
  611A*   28 04          C                  JR      Z,$+6
  611C*   C1             C                  POP     BC
  611D*   04             C                  INC     B
'Routinen fuer Kassette'	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  611E*   18 C9          C                  JR      UR.POSIK+3
  6120*   C1             C                  POP     BC
  6121*   05             C                  DEC     B
  6122*   28 21          C                  JR      Z,UR.RSP
  6124*   18 C3          C                  JR      UR.POSIK+3
  6126*                  C      UR.OK:
  6126*   AF             C                  XOR     A
  6127*   B1             C                  OR      C
  6128*   28 08          C                  JR      Z,$+10
  612A*   DD 70 0A       C                  LD      (IX+10),B
  612D*   CD 60BF*       C                  CALL    UR.KLR
  6130*   18 13          C                  JR      UR.RSP
  6132*   DD 36 04 15    C                  LD      (IX+4),15H
  6136*   CD 5D2F*       C                  CALL    UF.EXEC
  6139*   10 F7          C                  DJNZ    $-7
  613B*   C1             C                  POP     BC
  613C*   05             C                  DEC     B
  613D*   28 06          C                  JR      Z,UR.RSP
  613F*   DD 70 0A       C                  LD      (IX+10),B
  6142*   CD 60B9*       C                  CALL    UR.KLV
  6145*                  C      UR.RSP:
  6145*   F1             C                  POP     AF
  6146*   D1             C                  POP     DE
  6147*   E1             C                  POP     HL
  6148*   C9             C                  RET
                         C                  TITLE   'Einzelzeicheneingabe fuer KMBG'
                         C                  PAGE
'Einzelzeicheneingabe fuer KMBG'	MACRO-80 3.44	09-Dec-81	PAGE	1-44


                         C      
                         C      ;           PN      UK
                         C      ;----------------------------------------------------------------------
                         C      ;
                         C      ;        Einzelzeicheneingabe fuer KMBG
                         C      ;
                         C      ;----------------------------------------------------------------------
  6149*                  C      UK.GETK:
  6149*   CD 5400*       C                  CALL    U1.RSAVE
  614C*   CD 5611*       C                  CALL    XY.LIDX             ;HL:= Blocklaenge
  614F*   09             C                  DB      9
  6150*   E5             C                  PUSH    HL
  6151*   CD 5601*       C                  CALL    XY.LDDX
  6154*   17             C                  DB      23
  6155*   EB             C                  EX      DE,HL               ;DE:= Pufferzaehler
  6156*   AF             C                  XOR     A
  6157*   E1             C                  POP     HL                  ;HL:= Blocklaenge
  6158*   ED 52          C                  SBC     HL,DE
  615A*   E5             C                  PUSH    HL                  ;Restbyteanzahl retten
  615B*   7C             C                  LD      A,H
  615C*   B5             C                  OR      L
  615D*   CC 61A9*       C                  CALL    Z,UK.KBW            ;Block lesen
  6160*   E1             C                  POP     HL
  6161*   AF             C                  XOR     A
  6162*   BC             C                  CP      H
  6163*   20 05          C                  JR      NZ,UK.GETK2
  6165*   7D             C                  LD      A,L
  6166*   FE 01          C                  CP      1
  6168*   28 08          C                  JR      Z,UK.GETK3          ;---> letztes Datenbyte des
  616A*                  C      UK.GETK2:
  616A*   CD 6178*       C                  CALL    UK.GETK4
  616D*   B7             C                  OR      A
  616E*                  C      UK.GETK5:
  616E*   CD 5408*       C                  CALL    U1.RRST
  6171*   C9             C                  RET
                         C      ;
                         C      ;
  6172*                  C      UK.GETK3:
  6172*   CD 6178*       C                  CALL    UK.GETK4
  6175*   37             C                  SCF
  6176*   18 F6          C                  JR      UK.GETK5
                         C      ;
  6178*                  C      UK.GETK4:
  6178*   CD 5601*       C                  CALL    XY.LDDX             ;HL:= aktuelle Pufferadresse
  617B*   15             C                  DB      21
  617C*   7E             C                  LD      A,(HL)              ;Datenbyte laden
  617D*   CD 5641*       C                  CALL    XY.INCDX            ;Pufferzeiger erhoehen
  6180*   15             C                  DB      21
  6181*   CD 5641*       C                  CALL    XY.INCDX            ;Pufferzaehler erhoehen
  6184*   17             C                  DB      23
  6185*   C9             C                  RET
                         C      
                         C      ;******************************************************************
                         C      ;
                         C      ;        KMBG  Eingabepuffer bereitstellen
                         C      ;
                         C      ;*******************************************************************
  6186*                  C      UK.KLPFB:
  6186*   CD 5400*       C                  CALL    U1.RSAVE
  6189*   CD 54FB*       C                  CALL    U1.KTIN1
  618C*   21 0080        C                  LD      HL,MaxBL            ;max. Blocklaenge Kassette (100H)
  618F*   CD 5631*       C                  CALL    XY.STIDX            ;max. Blocklaenge initialisieren
  6192*   09             C                  DB      9
  6193*   E5             C                  PUSH    HL
  6194*   C1             C                  POP     BC                  ;BC:= Blocklaenge
  6195*   CD 5621*       C                  CALL    XY.STDX             ;Pufferzaehler "Leer"
  6198*   17             C                  DB      23
  6199*   21 0E65        C                  LD      HL,UE.PUF           ;Systempuffer Kassette
  619C*   CD 5411*       C                  CALL    U1.CLRB             ;Systempuffer loeschen
  619F*   21 8010        C                  LD      HL,UE.KPUFF
  61A2*   CD 5411*       C                  CALL    U1.CLRB
  61A5*   CD 5408*       C                  CALL    U1.RRST
  61A8*   C9             C                  RET
                         C      
                         C      ;******************************************************************
                         C      ;
                         C      ;        Einlesen eines Blockes von Kassette
                         C      ;
                         C      ;         - Besonderheit gegenueber MBW: Blockinhalt wird vom
                         C      ;           Systempuffer in den E/A-Puffer uebertragen
                         C      ;
                         C      ;*******************************************************************
'Einzelzeicheneingabe fuer KMBG'	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  61A9*                  C      UK.KBW:
  61A9*   CD 5400*       C                  CALL    U1.RSAVE
  61AC*   CD 6186*       C                  CALL    UK.KLPFB
  61AF*   DD 36 04 02    C                  LD      (IX+4),02H
  61B3*   CD 5D2F*       C                  CALL    UF.EXEC
                         C                                              ;LD     A,(IX+9)
                         C                                              ;OR     (IX+10)
  61B6*   DD 7E 0A       C                  LD      A,(IX+10)           ;Laenge = 1, dann BM
  61B9*   FE 01          C                  CP      1
  61BB*   28 2A          C                  JR      Z,UK.KBW1           ;EOF
  61BD*   CD 5601*       C                  CALL    XY.LDDX             ;HL:= Blockadresse
  61C0*   07             C                  DB      7
  61C1*   DD 46 09       C                  LD      B,(IX+9)            ;BC:= Blocklaenge
  61C4*   DD 4E 0A       C                  LD      C,(IX+10)
  61C7*   E5             C                  PUSH    HL                  ;E/A-Puffer
  61C8*   CD 5601*       C                  CALL    XY.LDDX
  61CB*   19             C                  DB      25
  61CC*   EB             C                  EX      DE,HL
  61CD*   E1             C                  POP     HL
  61CE*   ED B0          C                  LDIR                        ;Transport in E/A-Puffer
  61D0*   CD 5601*       C                  CALL    XY.LDDX
  61D3*   19             C                  DB      25
  61D4*   CD 5621*       C                  CALL    XY.STDX             ;Pufferzeiger auf Anfang
  61D7*   15             C                  DB      21
  61D8*   21 0000        C                  LD      HL,0
  61DB*   CD 5621*       C                  CALL    XY.STDX             ;Pufferzaehler rueckstellen
  61DE*   17             C                  DB      23
  61DF*   CD 5641*       C                  CALL    XY.INCDX            ;Blockzaehler incrementieren
  61E2*   11             C                  DB      17
  61E3*                  C      UK.KBW2:
  61E3*   CD 5408*       C                  CALL    U1.RRST
  61E6*   C9             C                  RET
                         C      ;
  61E7*                  C      UK.KBW1:
  61E7*   CD 5641*       C                  CALL    XY.INCDX            ;Labelzaehler incrementieren
  61EA*   11             C                  DB      17
  61EB*   18 F6          C                  JR      UK.KBW2
                         C      
                         C      ;********************************************************************
                         C      ;
                         C      ;        Einzelzeichenausgabe fuer KMBG
                         C      ;
                         C      ;*********************************************************************
  61ED*                  C      UK.PUTK:
  61ED*   CD 5400*       C                  CALL    U1.RSAVE
  61F0*   F5             C                  PUSH    AF                  ;Zeichen retten
  61F1*   CD 5601*       C                  CALL    XY.LDDX             ;HL:= Pufferzaehler
  61F4*   17             C                  DB      23
  61F5*   01 0132        C                  LD      BC,UE.KMPUL         ;BC:= max. Pufferlaenge
  61F8*   B7             C                  OR      A
  61F9*   ED 42          C                  SBC     HL,BC
  61FB*   3F             C                  CCF
  61FC*   CC 6236*       C                  CALL    Z,UK.KBA            ;---> Puffer voll
  61FF*   F1             C                  POP     AF                  ;Zeichen auskellern
  6200*   CD 5601*       C                  CALL    XY.LDDX
  6203*   15             C                  DB      21
  6204*   77             C                  LD      (HL),A              ;Zeichen in Puffer eintragen
  6205*   CD 5641*       C                  CALL    XY.INCDX            ;Pufferzeiger erhoehen
  6208*   15             C                  DB      21
  6209*   CD 5641*       C                  CALL    XY.INCDX            ;Pufferzaehler erhoehen
  620C*   17             C                  DB      23
  620D*   CD 5408*       C                  CALL    U1.RRST
  6210*   C9             C                  RET
                         C      
                         C      ;******************************************************************
                         C      ;
                         C      ;        Ausgabepufferbereitstellung fuer KMBG
                         C      ;
                         C      ;*******************************************************************
  6211*                  C      UK.KSPFB:
  6211*   CD 5400*       C                  CALL    U1.RSAVE
  6214*   CD 54FB*       C                  CALL    U1.KTIN1
  6217*   CD 5611*       C                  CALL    XY.LIDX
  621A*   09             C                  DB      9
  621B*   E5             C                  PUSH    HL
  621C*   C1             C                  POP     BC                  ;BC:= Blocklaenge
  621D*   21 0000        C                  LD      HL,0
  6220*   CD 5621*       C                  CALL    XY.STDX             ;Pufferzaehler = 0
  6223*   17             C                  DB      23
  6224*   CD 5601*       C                  CALL    XY.LDDX
  6227*   19             C                  DB      25
  6228*   CD 5621*       C                  CALL    XY.STDX             ;Pufferzeiger setzen
  622B*   15             C                  DB      21
'Einzelzeicheneingabe fuer KMBG'	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  622C*   21 0E65        C                  LD      HL,UE.PUF
  622F*   CD 5411*       C                  CALL    U1.CLRB
  6232*   CD 5408*       C                  CALL    U1.RRST
  6235*   C9             C                  RET
                         C      
                         C      ;*******************************************************************
                         C      ;
                         C      ;        Ausgabe eines Blockes auf KMBG
                         C      ;
                         C      ;*******************************************************************
  6236*                  C      UK.KBA:
  6236*   CD 5400*       C                  CALL    U1.RSAVE
  6239*   CD 6211*       C                  CALL    UK.KSPFB
  623C*   CD 5601*       C                  CALL    XY.LDDX
  623F*   07             C                  DB      7
  6240*   EB             C                  EX      DE,HL               ;DE:= Blockadresse
  6241*   D5             C                  PUSH    DE                  ;Blockadresse retten
  6242*   CD 5611*       C                  CALL    XY.LIDX
  6245*   09             C                  DB      9
  6246*   E5             C                  PUSH    HL
  6247*   C1             C                  POP     BC                  ;BC:= Blocklaenge
  6248*   D1             C                  POP     DE                  ;DE:= Blockadresse
  6249*   C5             C                  PUSH    BC                  ;Blocklaenge retten
  624A*   CD 5601*       C                  CALL    XY.LDDX             ;HL:= E/A-Pufferanfang
  624D*   19             C                  DB      25
  624E*   ED B0          C                  LDIR                        ;Block in Systempuffer
  6250*   C1             C                  POP     BC                  ;BC:= Blocklaenge
  6251*   E5             C                  PUSH    HL                  ;aktuelle Pufferadresse retten
  6252*   21 0132        C                  LD      HL,UE.KMPUL         ;HL:= max. Laenge
  6255*   B7             C                  OR      A
  6256*   ED 42          C                  SBC     HL,BC               ;HL:= Restbyteanzahl
  6258*   CD 5621*       C                  CALL    XY.STDX             ;Pufferzaehler setzen
  625B*   17             C                  DB      23
  625C*   E5             C                  PUSH    HL
  625D*   C1             C                  POP     BC                  ;BC:= Restbyteanzahl
  625E*   CD 5601*       C                  CALL    XY.LDDX             ;HL:= aktuelle Pufferadresse
  6261*   19             C                  DB      25
  6262*   EB             C                  EX      DE,HL               ;DE:= Pufferanfang
  6263*   E1             C                  POP     HL
  6264*   ED B0          C                  LDIR
  6266*   EB             C                  EX      DE,HL               ;HL:= aktuelle Pufferadresse
  6267*   CD 5621*       C                  CALL    XY.STDX             ;Pufferzeiger setzen
  626A*   15             C                  DB      21
  626B*   DD 36 04 08    C                  LD      (IX+4),08H
  626F*   CD 5D2F*       C                  CALL    UF.EXEC             ;physische Blockausgabe
  6272*   F5             C                  PUSH    AF
  6273*   CD 5641*       C                  CALL    XY.INCDX            ;Blockzaehler erhoehen
  6276*   11             C                  DB      17
  6277*   F1             C                  POP     AF
  6278*   CD 5408*       C                  CALL    U1.RRST
  627B*   C9             C                  RET
                         C      ;----------------------------------------------------------------------
                         C      ;           END
