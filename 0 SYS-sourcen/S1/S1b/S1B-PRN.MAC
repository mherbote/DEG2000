'Initialisieren von MRES Kassetten'	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                         C      
                         C      ;           PN      KI
                         C      ;----------------------------------------------------------------------
                         C      ;
                         C      ;      INITIALISIEREN VON MRES KASSETTEN
                         C      ;
                         C      ;----------------------------------------------------------------------
  627C*   627C*          C                  DW      $
  627E*   49 4E 49 54    C                  DB      'INIT'
  6282*   21 4070        C                  LD      HL,PUF.KASS         ;Puffer fuer Umbenennung Kassette loeschen
  6285*   11 4071        C                  LD      DE,PUF.KASS+1
  6288*   01 000F        C                  LD      BC,15
  628B*   36 20          C                  LD      (HL),020H
  628D*   ED B0          C                  LDIR
  628F*   3A 3327        C                  LD      A,(UE.BWSA + 10*80 +7) ;327H
  6292*   CD 55C5*       C                  CALL    U1.TST
  6295*   D8             C                  RET     C
  6296*   F5             C                  PUSH    AF
  6297*   CD 54E2*       C                  CALL    U1.KTINI
  629A*   F1             C                  POP     AF
  629B*   DD 77 03       C                  LD      (IX+3),A            ;GERAETEADR. -->TAB
  629E*   CD 60A1*       C                  CALL    UR.KRE              ;RES. EIN
  62A1*   DD CB 00 56    C                  BIT     2,(IX+0)
  62A5*   28 05          C                  JR      Z,$+7
  62A7*   3E 19          C                  LD      A,19H
  62A9*   CD 5D61*       C                  CALL    UF.ERANZ
  62AC*   CD 60AF*       C                  CALL    UR.KRWW             ;RUECKSPULEN MIT WARTEN
  62AF*   CD 60C5*       C                  CALL    UR.KBM              ;BM SCHREIBEN
  62B2*   21 0E65        C                  LD      HL,UE.PUF           ;AUFBAU 1.BLOCK
  62B5*   3E 40          C                  LD      A,40H
  62B7*   06 50          C                  LD      B,80
  62B9*   CD 55A6*       C                  CALL    U1.TR
  62BC*   3E 00          C                  LD      A,00H
  62BE*   06 30          C                  LD      B,48
  62C0*   CD 55A6*       C                  CALL    U1.TR
  62C3*   DD 36 0A 80    C                  LD      (IX+10),80H         ;Blocklaenge
  62C7*   DD 36 04 08    C                  LD      (IX+4),08H          ;CMD SCHREIBEN
  62CB*   CD 5D2F*       C                  CALL    UF.EXEC
  62CE*   CD 637B*       C                  CALL    KI.KO03
  62D1*                  C      KI.KN:
  62D1*   CD 55B1*       C                  CALL    U1.BILO
  62D4*   3E 0D          C                  LD      A,13
  62D6*   32 2B00*       C                  LD      (UB.ZN),A           ;ZEILENNR. 15
  62D9*   21 5E2B*       C                  LD      HL,UA.KNAME         ;ABFRAGE KASS.NAME
  62DC*   CD 595C*       C                  CALL    UR.MIMO
  62DF*   D8             C                  RET     C
                         C      ;---\
  62E0*   E5             C                  PUSH    HL                  ;KassettenName fuer Umbenenung im Emulator merken
  62E1*   C5             C                  PUSH    BC
  62E2*   11 4070        C                  LD      DE,PUF.KASS
  62E5*   01 0006        C                  LD      BC,6
  62E8*   ED B0          C                  LDIR
  62EA*   C1             C                  POP     BC
  62EB*   E1             C                  POP     HL
                         C      ;---/
  62EC*   06 06          C                  LD      B,6
  62EE*   11 0E69        C                  LD      DE,UE.PUF+4         ;NAME IN PUFFER
  62F1*   CD 57BA*       C                  CALL    UC.KONV             ;MIT KONVERTIERUNG IN DKOI-CODE
  62F4*                  C      KI.NMR:
  62F4*   21 5E3E*       C                  LD      HL,UA.NR            ;ABFR. KASS.NUMMER
  62F7*   CD 595C*       C                  CALL    UR.MIMO
  62FA*   38 D5          C                  JR      C,KI.KN             ;BEI SYS-TASTE ZU VORHERIGER
                         C      ;---\
  62FC*   E5             C                  PUSH    HL                  ;Kassetten-Nr fuer Umbenenung im Emulator merken
  62FD*   C5             C                  PUSH    BC
  62FE*   11 4076        C                  LD      DE,PUF.KASS+6
  6301*   01 0003        C                  LD      BC,3
  6304*   ED B0          C                  LDIR
  6306*   C1             C                  POP     BC
  6307*   E1             C                  POP     HL
                         C      ;---/
  6308*   06 03          C                  LD      B,3
  630A*   11 0E8A        C                  LD      DE,UE.PUF+37
  630D*   CD 57BA*       C                  CALL    UC.KONV
  6310*                  C      KI.KM:
  6310*   21 5E51*       C                  LD      HL,UA.KOMMT         ;ABFR. KOMMENTAR
  6313*   CD 595C*       C                  CALL    UR.MIMO
  6316*   38 B9          C                  JR      C,KI.KN
  6318*   06 0B          C                  LD      B,11
  631A*   11 0E8D        C                  LD      DE,UE.PUF+40
  631D*   CD 57BA*       C                  CALL    UC.KONV
  6320*   CD 5D2F*       C                  CALL    UF.EXEC             ;3.BLOCK SCHREIBEN
'Initialisieren von MRES Kassetten'	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  6323*   CD 6386*       C                  CALL    KI.RENA             ;Kassette umbenennen
  6326*   CD 60C5*       C                  CALL    UR.KBM              ;BM , 1.LABEL BEENDET
  6329*   21 6081*       C                  LD      HL,UA.ALTR
  632C*   11 0E65        C                  LD      DE,UE.PUF
  632F*   01 0020        C                  LD      BC,20H
  6332*   ED B0          C                  LDIR                        ;AUSGLEICH LFWSTLNZ->PUFFER
  6334*   DD 36 0A 20    C                  LD      (IX+10),20H         ;NEUE BLOCKLAENGE
  6338*   DD 36 04 08    C                  LD      (IX+4),08H
